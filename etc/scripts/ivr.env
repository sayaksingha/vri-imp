#  @(#) $Id: ivr.env,v 1.1.1.1.2.5.2.3 2018/02/12 02:51:16 mram Exp $

export SYS_HOME=/opt/ivr/

export PRODUCT_HOME=/opt/ivr
export PRODUCT_CFG_PATH=/etc/config/
export PRODUCT_SCR_PATH=/etc/scripts/
export PRODUCT_BIN_DIR=bin
export TRACE_LOG_PATH=/var/trace
export CGW_HOME=/opt/cgw
export CGW_BIN_DIR=bin
export CGW_CFG_PATH=etc/config

export PROCESS_INIT_DELAY=1

# - Xerces root dir
export XERCESCROOT=/home/vxml/openVXI/Xerces-SML_PARSER/xerces-c_2_8_0-x86-linux-gcc_3_4
export XERCESDIR=$XERCESCROOT

# - Spider Monkey dir
export SPIDERMONKEYROOT=/home/vxml/openVXI/Seamonkey/js
export SPIDERMONKEYDIR=$SPIDERMONKEYROOT

# - PCRE dir
export PCREROOT=/home/vxml/pcre-8.10

# - Curl dir
#export CURLROOT=/home/vxml/curl-7.21.1

# - Oktopous root dir
export OKTOROOT=/home/vxml/Oktopous-1.1

# - OpenVXI root dir
export SWISBSDK=/opt/ivr/vxi

# - Seting up library path

export LD_LIBRARY_PATH=/usr/local/lib:$SWISBSDK/lib:$XERCESDIR/lib:$SPIDERMONKEYDIR/src/Linux_All_DBG.OBJ:/usr/lib/mysql

export TRACE_CFG_PATH=$PRODUCT_HOME/$PRODUCT_CFG_PATH
export TRACE_LOG_PATH=$PRODUCT_HOME/$TRACE_LOG_PATH

# -------------- Setting up VXML Application Path ---------------------------
export IVR_BASE_PATH=/opt/ivr/xml

export APPLICATION_PATH=$IVR_BASE_PATH/deployment

export XML_FILE_PATH=$APPLICATION_PATH

export IVR_XML_PATH=$APPLICATION_PATH

export RESOURCE_PATH=$IVR_BASE_PATH/development/

# --- GLOBAL RESOURCE PATH
export GLOBAL_RESOURCE_PATH=$IVR_BASE_PATH/global/

# --- For Vxml App Builder database src  file
export SUBDIALOG_SRC_FILE=$GLOBAL_RESOURCE_PATH/lib/IvrDbQuery.vxml
export SPEECH_SRC_FILE=$GLOBAL_RESOURCE_PATH/lib/IvrSpeakVariable.vxml

# --- exe file path  for  VXML validation
export VXML_VALIDATE_EXE_PATH=$PRODUCT_HOME/$PRODUCT_BIN_DIR/ValidateDocD

# ---exe file path  for  channel details
export CHANNEL_EXE_PATH=$PRODUCT_HOME/$PRODUCT_BIN_DIR/IVR_ChannelDetails


######################################## Path for MMP  ###########################################
# For Content Module
export MMP_CONTENT_PATH=$IVR_BASE_PATH/content/
export CONTENT_AUDIO_FILE_PATH=$MMP_CONTENT_PATH/audio/
export CONTENT_PREVIEW_FILE_PATH=$MMP_CONTENT_PATH/preview/
export CONTENT_NAME_FILE_PATH=$MMP_CONTENT_PATH/name/

export CONTENT_AUDIO_PLAY_PATH=contentaudiolink
export CONTENT_PREVIEW_PLAY_PATH=contentpreviewlink
export CONTENT_NAME_PLAY_PATH=contentnamelink
export PLAY_PATH=audiolink

export ORACLE_HOME=/home/oracle/app/oracle/product/11.2.0/client_2

export MMP_ENABLE=0
export OBD_ENABLE=0
export SAS_ENABLE=0
export IVR_EXTAPP=0
######################################## Media Process  ###########################################
#  Env values for related media cards. Based on the values defined below IVR_MEDIA env has to be 
#  set accordingly 
#
#  SYNWAY     =  1
#  ACULAB     =  2
#  DIALOGIC   =  3
#
###################################################################################################
export IVR_MEDIA=2

######################################## Dialogic Variants ########################################
#  Dialogic variants Supported
#  
#  DIALOGIC   =  1   (HMP)
#  DIALOGIC   =  2   (JCT/DMV)
#
###################################################################################################
export DIALOGIC=2


export IVR_DB_NAME=ivr
export IVR_DB_USER=ivr
export IVR_DB_PASS=ivr

export SAS_DB_NAME=XE
export SAS_DB_USER=ivr
export SAS_DB_PASS=ivr

export OBD_DB_NAME=ivr
export OBD_DB_USER=ivr
export OBD_DB_PASS=ivr

export GGI_DB_NAME=ivrggi
export GGI_DB_USER=ivrggi
export GGI_DB_PASS=ivrggi

export LD_LIBRARY_PATH="$ORACLE_HOME/lib:/usr/lib:$ORACLE_HOME/perl/lib/:/lib/:/usr/lib:/usr/local/lib:$ORACLE_HOME/rdbms/lib:/usr/lib/perl5/5.8.8/i386-linux-thread-multi/CORE/:/opt/aculab/lib64/"

#0-oracle 1-Mysql
export SS7_DBCLIENT=0

export PATH=.:$PATH:$ORACLE_HOME/bin
