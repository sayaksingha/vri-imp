#************************* SNW_MediaProcess *************************************
echo " "
echo "------------------------------------------------------------------------"
echo -n "Sending SIGTRACE to SNW_MediaProcess      : "
killproc SNW_MediaProcess -12
RETVAL=$?
echo
if [ $RETVAL -ne 0 ]
 then
     echo "Unable to send SIGTRACE to SNW_MediaProcess"
fi
sleep $PROCESS_INIT_DELAY
#********************************************************************************
