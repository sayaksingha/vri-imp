#************************* SNW MediaProcess  ********************************
echo " "
echo "------------------------------------------------------------------------"
echo -n "Shutting down SNW MediaProcess                   : "
killproc SNW_MediaProcess
RETVAL=$?
echo
if [ $RETVAL -ne 0 ]
 then
     echo "Unable to kill SNW MediaProcess"
fi
echo " "
sleep $PROCESS_INIT_DELAY
#*****************************************************************************
