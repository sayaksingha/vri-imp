#!/bin/sh

#*****************************************************************************
#Set the environment
#*****************************************************************************

if [ ! -f /opt/ivr/etc/scripts/ivr.env ]
then
echo "Please edit this script to set the ivr.env path"
echo ""
echo "---------------------------------------"
echo -e "\033[35mAborting Ivr SIGCFG Sequence\033[0m"
exit
fi
source /opt/ivr/etc/scripts/ivr.env

#*****************************************************************************
if [ -z "${PRODUCT_HOME}" ]
then
echo "PRODUCT_HOME not set"
echo ""
echo "---------------------------------------"
echo -e "\033[35mAborting Ivr SIGCFG Sequence\033[0m"
exit
fi

#*****************************************************************************
# Source function library.
#*****************************************************************************
if [ ! -f $PRODUCT_HOME/etc/scripts/functions ]
then
echo "functions is not present in the expected path - " $PRODUCT_HOME/etc/scripts/
echo ""
echo "---------------------------------------"
echo -e "\033[35mAborting Ivr SIGCFG Sequence\033[0m"
exit
fi
source $PRODUCT_HOME/etc/scripts/functions

#************************* IVR_SessionManager ********************************
echo " "
echo "------------------------------------------------------------------------"
echo -n "Sending SIGCFG to IVR_SessionManager    : "
killproc IVR_SessionManager -10
RETVAL=$?
echo
if [ $RETVAL -ne 0 ]
 then
     echo "Unable to send SIGCFG to IVR_SessionManager"
fi
#sleep $PROCESS_INIT_DELAY

#************************* IVR_VxmlProcessor**********************************
