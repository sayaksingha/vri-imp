export OAM_HOME=/opt/oam
export OAM_BIN_DIR=bin
export OAM_CONFIG_PATH=/etc/config
export OAM_DB_DIR=etc/dbscripts

export OAM_WEB_DB_DIR=etc/dbscripts/webdb

export OAM_DB_NAME=BPLORA
export OAM_DB_USER=logdb
export OAM_DB_PASS=logdb

export ORACLE_HOME=/opt/oracle/product/11.1.0/db_1/
export ORACLE_SID=BPLORA
export ORACLE_BASE=$ORACLE_HOME
export ORACLE_TERM=vt100
export LD_LIBRARY_PATH=.:$ORACLE_HOME/lib:/lib:/usr/lib:/usr/local/lib:$ORACLE_HOME/rdbms/lib

#Exports for SNMP
export SNMP_CONFIG_PATH=$OAM_HOME/$OAM_CFG_PATH
export ALM_SHM_FILE_PATH=$OAM_HOME/tmp

export OAM_HOME=/opt/oam
export OAM_BIN_DIR=bin
export OAM_CONFIG_PATH=/etc/config

export OAM_DB_DIR=etc/scripts
#export TRACE_CFG_PATH=$OAM_HOME/$OAM_CFG_DIR
#export PROCESS_INIT_DELAY=1

export OAM_DB_NAME_1=BPLORA
export OAM_DB_NAME_2=BPLORA
export OAM_DB_NAME=BPLORA
export OAM_DB_USER=logdb
export OAM_DB_PASS=logdb

export Product=ivr
