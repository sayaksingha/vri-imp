#************************* SNW_MediaProcess *************************************
echo " "
echo "------------------------------------------------------------------------"
echo -n "Sending SIGCFG to SNW_MediaProcess      : "
killproc SNW_MediaProcess -10
RETVAL=$?
echo
if [ $RETVAL -ne 0 ]
 then
     echo "Unable to send SIGCFG to SNW_MediaProcess"
fi
#*****************************************************************************
