then
echo "functions is not present in the expected path - " $PRODUCT_HOME/etc/scripts/
echo ""
echo "---------------------------------------"
echo -e "\033[35mAborting Ivr SIGTRACE Sequence\033[0m"
exit
fi
source $PRODUCT_HOME/etc/scripts/functions

