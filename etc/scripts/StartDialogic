#  @(#) $Id: StartDialogic,v 1.1.4.3 2016/04/12 21:59:14 shijuc Exp $
#!/bin/sh

#*****************************************************************************
#Set the environment
. /opt/ivr/etc/scripts/ivr.env
. $PRODUCT_HOME/etc/scripts/oam.env

#*****************************************************************************
# Source function library.
. $PRODUCT_HOME/etc/scripts/functions

#*****************************************************************************
echo " "
echo "------------------------------------------------------------------------"
$SETCOLOR_SUCCESS
echo "------------------------- IVR MEDIA STARTUP ----------------------------"
$SETCOLOR_NORMAL
echo "------------------------------------------------------------------------"
echo " "

#*****************************************************************************
echo " "
echo "------------------------------------------------------------------------"
echo "Setting core file limit to 5000"
echo " "
ulimit -c 5000

#**************** Launch IVR Dialogic Voice Process ***************************
#echo " "
#echo "------------------------------------------------------------------------"
#echo "Starting IVR Dialogic Voice Process"
#echo " "
#$PRODUCT_HOME/$PRODUCT_BIN_DIR/DLG_HostMediaProcess <MinCkt> <MaxCkt> &
#sleep $PROCESS_INIT_DELAY
if [ $DIALOGIC -eq 1 ]
then
   echo " "
   echo "------------------------------------------------------------------------"
   echo "Starting IVR Dialogic Voice Process"
   echo " "
   $PRODUCT_HOME/$PRODUCT_BIN_DIR/DLG_HostMediaProcess 1 120 &
   sleep $PROCESS_INIT_DELAY
fi

if [ $DIALOGIC -eq 2 ]
then
   echo " "
   echo "------------------------------------------------------------------------"
   echo "Starting IVR Dialogic Voice Process"
   echo " "
   $PRODUCT_HOME/$PRODUCT_BIN_DIR/DLG_IsdnMediaProcess 1 60 &
   sleep $PROCESS_INIT_DELAY
fi

#**************** Sending SIGTRACE to IVR Processes *************************
#sleep $PROCESS_INIT_DELAY
. $PRODUCT_HOME/etc/scripts/TraceDialogic

#*****************************************************************************
echo " "
echo "------------------------------------------------------------------------"
$SETCOLOR_SUCCESS
echo "------------------- IVR MEDIA STARTUP SEQUENCE COMPLETE ----------------"
$SETCOLOR_NORMAL
echo "------------------------------------------------------------------------"
echo " "

#************************ End Of StartDialogic *********************************
