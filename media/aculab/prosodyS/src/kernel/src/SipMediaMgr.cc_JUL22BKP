//----------------------------------------------------------------------
// METHOD NAME : FormApplnBye
// DESCRIPTION : Formats Release towards Application
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::FormApplnBye()
{
   //get cause
   CAUSE_XPARMS   lClearCallDet;
   CAUSE_XPARMS   lCauseDet;
   ACU_ERR        lErr;

   TEXT     lLogText[MAX_LOG_TEXT_LEN+1] = "";
   TEXT     lThisFunction[] = "FormApplnBye";

   ChnlLock(mSipCallHandlers.index, lThisFunction);
   //Cance DTMF timer if active
   if (gSipCallDtls.sipCallHdls[mSipCallHandlers.index].timerTag != 0)  
   {
      ChnlUnlock(mSipCallHandlers.index, lThisFunction);
      gSipMediaMgr.CancelDtmfTimer(mSipCallHandlers.index);
   }
   else
   {
      ChnlUnlock(mSipCallHandlers.index, lThisFunction);
   }

   INIT_ACU_CL_STRUCT(&lCauseDet);
   lCauseDet.handle     =  mSipCallHandlers.handle;

   mTxIsupMsg.isupMsgType  = GEN_ISUP_REL;
   mTxIsupMsg.circuitId    =  mSipCallHandlers.index;

   if(OUTGOING == mSipCallHandlers.callType)
   {
      strcpy(mTxIsupMsg.isupIam.callingNumber, DecodeAddress(mTxIsupMsg.circuitId, mSipCallHandlers.origAddr));
      strcpy(mTxIsupMsg.isupIam.calledNumber, DecodeAddress(mTxIsupMsg.circuitId, mSipCallHandlers.destAddr));
   }
   else
   {
      strcpy(mTxIsupMsg.isupIam.callingNumber, DecodeAddress(mTxIsupMsg.circuitId, mDetailXparms.originating_addr));
      strcpy(mTxIsupMsg.isupIam.calledNumber, DecodeAddress(mTxIsupMsg.circuitId, mDetailXparms.destination_addr));
   }

   lErr = call_getcause(&lCauseDet);

   if(lErr)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "%s FormApplnBye call_getcause() Returned Error: %d (%s)"
            ,mLogText, lErr,error_2_string(lErr));
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP84, lLogText);
      mTxIsupMsg.isupRel.cause  = 0X11 ;
      mTxIsupMsg.isupRel.location = 0;
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "%s Cas:%d FormApplnBye Success to Get Release Cause", mLogText, lCauseDet.raw);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP85, 2, lLogText);
      mTxIsupMsg.isupRel.cause    = lCauseDet.raw ;
      mTxIsupMsg.isupRel.location = lCauseDet.location;
   }

   //Disconnect the call
   INIT_ACU_CL_STRUCT(&lClearCallDet);

   lClearCallDet.handle = mSipCallHandlers.handle;
   lErr = call_disconnect(&lClearCallDet);

   if (lErr)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "%s FormApplnBye call_disconnect() Returned Error: %d (%s)"
            ,mLogText, lErr,error_2_string(lErr));
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP86, lLogText);
      return false;
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "%s FormApplnBye Success to Disconnect the Call", mLogText);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP87, 2, lLogText);
   }

   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "%s CA:%s DA:%s Tx Bye Message Formed Towards Application CID:%d", 
         mLogText, mTxIsupMsg.isupIam.callingNumber,
         mTxIsupMsg.isupIam.calledNumber, mTxIsupMsg.circuitId);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP98, lLogText);

   return true;
}
//-------------------------------------------------------------
// METHOD        : SendEventToAppln
// DESCRIPTION   :
// PARAMETER     : NONE
// RETURN        : NONE
//-------------------------------------------------------------
BOOLEAN SipMediaMgr::SendEventToAppln(EnumSipMessage lEvent)
{
   ACU_ERR        lErr;

   TEXT     lLogText[MAX_LOG_TEXT_LEN+1] = "";

   INIT_ACU_STRUCT(&mDetailXparms);
   mDetailXparms.handle = mSipCallHandlers.handle;
   lErr = call_details(&mDetailXparms);
   if(lErr)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "%s call_details() Returned Error: %d(%s)"
            ,mLogText, lErr,error_2_string(lErr));
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP69, lLogText);
      return false;
   }

   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "%s Call Details CA:%s OA:%s DA:%s", 
         mLogText, mDetailXparms.connected_addr, mDetailXparms.originating_addr, 
         mDetailXparms.destination_addr);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP67, 1, lLogText);

   switch(lEvent)
   {
      case SIP_INVITE:
         {
            FormApplnInvite();
            break;
         }

      case SIP_TRYING_100:
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "%s CA:%s OA:%s DA:%s SIP_TRYING_100 Received", 
                  mLogText, mDetailXparms.connected_addr, mDetailXparms.originating_addr, 
                  mDetailXparms.destination_addr);
            T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP187, 1, lLogText);

            return true;
         }

      case SIP_RINGING_180:
         {
            //Send ACM to Appln
            //FormApplnRinging();  // TBR check condition
            //break;

            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "%s CA:%s OA:%s DA:%s SIP_RINGING_180 Received", 
                  mLogText, mDetailXparms.connected_addr, mDetailXparms.originating_addr, 
                  mDetailXparms.destination_addr);
            T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP188, 1, lLogText);

            if(OUTGOING == mDetailXparms.calltype)
            {
               FormApplnRinging();  
               break;
            }
            else
               return true;
         }

      case SIP_OK_200:
         {
            //Send ANM to Appln
            FormApplnConnected();
            break;
         }
      
      case SIP_ACK:
         {
            //Send ANM to Appln
            FormApplnSipAck();
            break;
         }

      case SIP_BYE:
         {
            FormApplnBye();
            break;
         }

      default:
         {
            //return  ?
         }
   }

   return mSipQueApi.WriteToSipRspQue (mTxIsupMsg, mLogText);
}
//-------------------------------------------------------------
// METHOD        : ProcessEvents
// DESCRIPTION   :
// PARAMETER     : NONE
// RETURN        : NONE
//-------------------------------------------------------------
BOOLEAN SipMediaMgr::ProcessEvents()
{
   ACU_ERR lErr;
   STATE_XPARMS lStateXparms;
   CAUSE_XPARMS lCauseXparms;

   TEXT  lLogText[MAX_LOG_TEXT_LEN+1] = "";
   TEXT     lThisFunction[] = "ProcessEvents";

   EnumSipMessage lEvent = SIP_NONE;

   while(true)
   {
      lEvent = SIP_NONE;

      INIT_ACU_STRUCT(&lStateXparms);
      lStateXparms.handle = 0;
      lStateXparms.timeout = -1;
      lErr = call_event(&lStateXparms);
      if (lErr)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "call_event() Returned Error:(%d): %s", lErr,error_2_string(lErr));
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP56, lLogText);
         continue;
      }
      //else
      //{
      //TBD
      //snprintf(lLogText, MAX_LOG_TEXT_LEN,
      //      "Success to Get the Call Event" );
      //T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      //gLog.GenerateLog(ACU_SIP63, 2, lLogText);
      //}

      if (!lStateXparms.handle)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "Error: No Handle Returned by call_event()");
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP64, 2, lLogText);

         /* 
            if (lLastState != EV_WAIT_FOR_INCOMING
            && lLastState != lWaitState)
            {
            lWaitState = lLastState;
            puts("The call control thread appears to be waiting forever\n"
            "\n"
            "Possible causes:\n"
            " - Misconfiguration of the phone you are using to dial in\n"
            "\n"
            "Diagnostic measures:\n"
            " - Check your SIP phone's configuration\n"
            " - Obtain a packet trace using a tool such as Wireshark\n");

            }*/
         continue;
      }

      //lLastState = lStateXparms.state;

      TEXT  lKey[50 + 1] = "";
      sprintf(lKey, "%ld", lStateXparms.handle); 

      memset(&mSipCallHandlers, '\0', sizeof(mSipCallHandlers));

      if(true != gSipHandleApi.GetReqMapDetails(lKey, mSipCallHandlers))
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "Error: Failed to Get Handler Details From Hash Key:%s", lKey);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP62, lLogText);
         continue;
         //  TBD check wat to do  ?????
      }
      else
      {
         ChnlLock(mSipCallHandlers.index, lThisFunction);
         snprintf(mLogText, MAX_LOG_TEXT_LEN, "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X VmpRx:%012X Channel:%lu",
               gSipCallDtls.sipCallHdls[mSipCallHandlers.index].seqNum,
               mSipCallHandlers.index, mSipCallHandlers.handle,
               mSipCallHandlers.vmp_tx, mSipCallHandlers.vmp_rx,mSipCallHandlers.channel);
         ChnlUnlock(mSipCallHandlers.index, lThisFunction);
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "%s Success to Get Handler Details From Hash", mLogText );
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP65, 1, lLogText);
      }

      pthread_mutex_lock(&gCallInitLock);
      switch(lStateXparms.state)
      {
         case EV_WAIT_FOR_INCOMING:
            {
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "%s Ready For Incoming Call (%d) EV_WAIT_FOR_INCOMING", mLogText, mSipCallHandlers.index);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP57, 1, lLogText);
               break;
            }

         case EV_INCOMING_CALL_DET:
            {
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "%s Event EV_INCOMING_CALL_DET Received", mLogText);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP78, 2, lLogText);

               lEvent = SIP_INVITE;
               
               ChnlLock(mSipCallHandlers.index, lThisFunction);
               gSipCallDtls.sipCallHdls[mSipCallHandlers.index].chnlStatus = CKT_ALERTING;
               ChnlUnlock(mSipCallHandlers.index, lThisFunction);

               break;
            }


         case EV_WAIT_FOR_ACCEPT:
            {
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "%s Event EV_WAIT_FOR_ACCEPT Received", mLogText);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP81, 2, lLogText);
               break;
            }

         case EV_MEDIA:
            {
               cout << "::::::::::::::::::::::::: EV_MEDIA is Received :::::::::::::" << endl;

               static INT32 ev_media_count = 0;
               INT16 rc = 0;
               INT16 lErr = 0;

               CALL_DETAIL_PARMS mDetailXparms;
               XCALL_MEDIA_ACCEPT_PARMS media_accept_parms;

               INIT_ACU_STRUCT(&mDetailXparms);
               INIT_ACU_STRUCT(&media_accept_parms);

               mDetailXparms.handle = mSipCallHandlers.handle;

               lErr = call_details(&mDetailXparms);
               if (lErr != 0) {
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "%s call_details() Returned Error: %d (%s)",
                        mLogText, lErr, error_2_string(lErr));
                  TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP69, lLogText);
                  return false;
               }

               if (ev_media_count == 0) {
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "%s Event EV_MEDIA Called", mLogText);
                  TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP69, lLogText);

                  media_accept_parms.handle = mSipCallHandlers.handle;

                  if (mDetailXparms.media_session != NULL) {
            media_accept_parms.media_offer_answer =
                mDetailXparms.media_session->received_media;

            rc = xcall_media_accept(&media_accept_parms);
            if (rc != 0) {
                snprintf(lLogText, MAX_LOG_TEXT_LEN,
                    "%s Error in xcall_media_accept() %d, %s\n",
                    mLogText, rc, error_2_string(rc));
                TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                gLog.GenerateLog(ACU_SIP69, lLogText);
                return false;
            }
        } else {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                "%s media_session is NULL", mLogText);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP69, lLogText);
            return false;
        }
    }

    ev_media_count++;
    break;
}

         case EV_CALL_CONNECTED:
            {
               //INCOMING    =  1,                /* incoming call */
               //OUTGOING    =  2,                /* outgoing call */

               INIT_ACU_STRUCT(&mDetailXparms);
               mDetailXparms.handle = mSipCallHandlers.handle;
               lErr = call_details(&mDetailXparms);
               if(lErr)
               {
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "%s call_details() Returned Error: %d (%s)"
                        ,mLogText, lErr,error_2_string(lErr));
                  TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP69, lLogText);
                  return false;
               }
                  
               //mSipCallHandlers.chnlStatus = CKT_IDLE; //TBC MAHESH
               ChnlLock(mSipCallHandlers.index, lThisFunction);
               gSipCallDtls.sipCallHdls[mSipCallHandlers.index].chnlStatus = CKT_IDLE;
               ChnlUnlock(mSipCallHandlers.index, lThisFunction);

               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "%s Call Details CA:%s OA:%s DA:%s",
                     mLogText, mDetailXparms.connected_addr, mDetailXparms.originating_addr,
                     mDetailXparms.destination_addr);

               //Send 200 OK to Apln in case of outgoing call
               if(OUTGOING == mDetailXparms.calltype)
                  lEvent = SIP_OK_200; 
               else 
                  lEvent = SIP_ACK;

               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "%s CallType:%d Call Connected  EV_CALL_CONNECTED", mLogText, mDetailXparms.calltype);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP71, 1, lLogText);
               break;
            } 
         case EV_IDLE:
            {
               ChnlLock(mSipCallHandlers.index, lThisFunction);
               /* Cancel dtmf in case if its listening */
               if(gSipCallDtls.sipCallHdls[mSipCallHandlers.index].listenDtmfFlag == true)
               {
                  ChnlUnlock(mSipCallHandlers.index, lThisFunction);
                  CancelDtmf(mSipCallHandlers.index);
                  ChnlLock(mSipCallHandlers.index, lThisFunction);
                  gSipCallDtls.sipCallHdls[mSipCallHandlers.index].listenDtmfFlag = false; //check for outbound
                  ChnlUnlock(mSipCallHandlers.index, lThisFunction);
               }
               else
               {
                  ChnlUnlock(mSipCallHandlers.index, lThisFunction);
               }

               ChnlLock(mSipCallHandlers.index, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "%s Received  EV_IDLE CallState:%d",
                     mLogText, gSipCallDtls.sipCallHdls[mSipCallHandlers.index].callState);
               ChnlUnlock(mSipCallHandlers.index, lThisFunction);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP88, 1, lLogText);

               INIT_ACU_STRUCT(&mDetailXparms);
               mDetailXparms.handle = mSipCallHandlers.handle;
               lErr = call_details(&mDetailXparms);
               if(lErr)
               {
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "%s call_details() Returned Error: %d (%s)"
                        ,mLogText, lErr,error_2_string(lErr));
                  TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP69, lLogText);
                  return false;
               }

               ChnlLock(mSipCallHandlers.index, lThisFunction);

               if(gSipCallDtls.sipCallHdls[mSipCallHandlers.index].callState != CALL_DISCONNECTED)
               {
                  lEvent = SIP_BYE;

                  //TBC
                  //if(gSipCallDtls.sipCallHdls[mSipCallHandlers.index].chnlStatus == CKT_PLAYING)
                  //   StopPlay(mSipCallHandlers.index);

                  /* Set to avoide collision of play stop */
                  gSipCallDtls.sipCallHdls[mSipCallHandlers.index].playControlStatus = CONTROL_USER_ABORT; 
                  ChnlUnlock(mSipCallHandlers.index, lThisFunction);

                  if(true != SendEventToAppln(lEvent))
                  {
                  }
                  lEvent = SIP_NONE;

                  if(gSipCallDtls.sipCallHdls[mSipCallHandlers.index].chnlStatus == CKT_PLAYING)
                  {
                     //Send Play Response with DTMF collected
                     MpResponseDetails    lAcuRsp;

                     memset(&lAcuRsp, 0, sizeof(lAcuRsp));
                     lAcuRsp.mpRspData.dummy.seqNum =  gSipCallDtls.sipCallHdls[mSipCallHandlers.index].seqNum;
                     lAcuRsp.mpRspData.dummy.circuitId =  mSipCallHandlers.index;
                     lAcuRsp.cmdType             = MC_GETDIG;
                     lAcuRsp.rspMsg             = MP_RSP_SUCCESS;
                     strcpy(lAcuRsp.mpRspData.getDigit.rspDigits,
                           gSipCallDtls.sipCallHdls[mSipCallHandlers.index].acuCurDtmf.detectedDigits);
                     mSipQueApi.WriteToMediaRspQue(lAcuRsp, mSipCallHandlers.index, lLogText);
                  }
 
               }
               else
               {
                  ChnlUnlock(mSipCallHandlers.index, lThisFunction);
               }
#if 0
               ChnlLock(mSipCallHandlers.index, lThisFunction);
               gSipCallDtls.sipCallHdls[mSipCallHandlers.index].chnlStatus = CKT_UNAVAILABLE;
               ChnlUnlock(mSipCallHandlers.index, lThisFunction);

               INIT_ACU_STRUCT(&lCauseXparms);
               lCauseXparms.handle = lStateXparms.handle;
               lErr = call_release(&lCauseXparms);
               if (lErr)
               {
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "%s call_release() Returned Error: %s", mLogText, error_2_string(lErr));
                  TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP72, lLogText);
                  pthread_mutex_unlock(&gCallInitLock);
                  continue; // TBD  check wat to do
               }
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "%s CallType:%d Success to Release Call", mLogText, mDetailXparms.calltype);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP73, 1, lLogText);

               if(true == DeInitializeInCall(mSipCallHandlers.index))
               {
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "%s Success to DeInitialize Call", mLogText);
                  T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP74, 1, lLogText);

                  ChnlLock(mSipCallHandlers.index, lThisFunction);
                  /* If OUTGOING call then dont initialize call again */
                  if(OUTGOING == gSipCallDtls.sipCallHdls[mSipCallHandlers.index].callType)
                  {
                     ChnlUnlock(mSipCallHandlers.index, lThisFunction); // check
                     break;  
                  }
                  else
                  {
                     ChnlUnlock(mSipCallHandlers.index, lThisFunction);
                  }

                  if(true != InitializeInCall(mSipCallHandlers.index))
                  {
                     snprintf(lLogText, MAX_LOG_TEXT_LEN,
                           "%s Error: Failed to Initialize Call", mLogText);
                     TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                     gLog.GenerateLog(ACU_SIP76, lLogText);
                  }
                  else
                  {
                     ChnlLock(mSipCallHandlers.index, lThisFunction);
                     snprintf(mLogText, MAX_LOG_TEXT_LEN, "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X VmpRx:%012X Channel:%lu",
                           gSipCallDtls.sipCallHdls[mSipCallHandlers.index].seqNum,
                           mSipCallHandlers.index, mSipCallHandlers.handle,
                           mSipCallHandlers.vmp_tx, mSipCallHandlers.vmp_rx,mSipCallHandlers.channel);
                     ChnlUnlock(mSipCallHandlers.index, lThisFunction);
                     snprintf(lLogText, MAX_LOG_TEXT_LEN,
                           "%s Success to Initialize Call", mLogText);
                     T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                     gLog.GenerateLog(ACU_SIP77, 1, lLogText);
                  }
               }
               else
               {
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "%s Failed to DeInitialize Call", mLogText);
                  TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP75, lLogText);
               }
#endif

               break;
            }
         case EV_WAIT_FOR_OUTGOING:
            {
               lEvent = SIP_TRYING_100;

               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "%s Event EV_WAIT_FOR_OUTGOING Received", mLogText);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP99, 2, lLogText);
               break;
            }

         case EV_OUTGOING_RINGING:
            {
               lEvent = SIP_RINGING_180;

               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "%s Event EV_OUTGOING_RINGING Received", mLogText);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP100, 2, lLogText);
               break;
            }

         case EV_REMOTE_DISCONNECT:
            {
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "%s Event EV_REMOTE_DISCONNECT Received", mLogText);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP101, 2, lLogText);
               break;
            }

         case EV_OUTGOING_PROCEEDING:
            {
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "%s Event EV_OUTGOING_PROCEEDING Received", mLogText);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP102, 2, lLogText);
               break;
            }

         case EV_DETAILS:
            {
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "%s Event EV_DETAILS Received", mLogText);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP103, 2, lLogText);
               break;
            }

         default:
            {
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "%s Error: Event %d  Received", mLogText, lStateXparms.state);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP104, 2, lLogText);
            }
      }
      pthread_mutex_unlock(&gCallInitLock);

      if(lEvent != SIP_NONE)
      {
         if(true != SendEventToAppln(lEvent))
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "%s Error: Failed to Send SIP Event to Application", mLogText);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP79, lLogText);
            return false;
         }
      }

   }
}

//----------------------------------------------------------------------
// METHOD      : HandleDtmfDetection
// DESCRIPTION : Handles Dtmf Detection on the specified channel
// PARAMETER   : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::HandleDtmfDetection(UINT16 index, SM_RECOGNISED_PARMS & rp, MpResponseDetails & rAcuRsp)
{
   INT16 lResult = 0;
   const TEXT *type;

   TEXT lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT     lThisFunction[] = "HandleDtmfDetection";
   ChnlLock(index, lThisFunction);
   SipCallHandlers *pChannel = &gSipCallDtls.sipCallHdls[index];
   ChnlUnlock(index, lThisFunction);

   switch(rp.type)
   {
      case kSMRecognisedNothing:
         type = 0;
         break;
      case kSMRecognisedTrainingDigit:
         type = "TrainingDigit";
         break;
      case kSMRecognisedDigit:
         {
            ChnlLock(index, lThisFunction);
            /* Cancel Dtmf Timer if is on */
            if (gSipCallDtls.sipCallHdls[index].timerTag != 0)
            {
               ChnlUnlock(index, lThisFunction);
               gSipMediaMgr.CancelDtmfTimer(index);
            }
            else
            {
               ChnlUnlock(index, lThisFunction);
            }

            //SM_CHANNEL_INFO_PARMS         ci;
            //memset(&ci, 0, sizeof(ci));      remove

            type = 0;
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d DTMF-EVT: MC_GETDIG"
                  " DetectedDigit: [%d-%c-%x] Param1:%dms DetectedDigLen:%d NumOfDig:%d",
                  gSipCallDtls.sipCallHdls[index].seqNum, 
                  index,
                  gSipCallDtls.sipCallHdls[index].handle, 
                  pChannel->chnlStatus, rp.param0, rp.param0, rp.param0,rp.param1,
                  gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigitsLen,
                  gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.numOfDig);
            ChnlUnlock(index, lThisFunction);
            T(gTrace, printf("%s: %s\n",gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP105, lLogText);

            ChnlLock(index, lThisFunction); 
            /* Cancel Dtmf Timer if is on */
            if(gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigitsLen < 
                  gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.numOfDig ||
                  gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.numOfDig == 0) // check locking
            {
               TEXT lTmpData[MAX_DTMF_RSP_DIGITS] = "";

               strncpy(lTmpData, gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits, MAX_DTMF_RSP_DIGITS);
               gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigitsLen += 1;

               snprintf(gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits, MAX_DTMF_RSP_DIGITS,
                     "%s%c", lTmpData, rp.param0);
               ChnlUnlock(index, lThisFunction);

               ChnlLock(index, lThisFunction);
               // PlayStopOnDtmf
               if (gSipCallDtls.sipCallHdls[index].acuCurPlay.play.dtmfEnable)
               {
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d DTMF-EVT: MC_GETDIG"
                        " FileCnt:%d Interrupting Play",
                        gSipCallDtls.sipCallHdls[index].seqNum, index,
                        gSipCallDtls.sipCallHdls[index].handle, pChannel->chnlStatus,
                        gSipCallDtls.sipCallHdls[index].acuCurPlay.fileCnt);
                  ChnlUnlock(index, lThisFunction);
                  T(gTrace, printf("%s: %s\n",gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP189, lLogText);

                  ChnlLock(index, lThisFunction);

                  if(gSipCallDtls.sipCallHdls[index].acuCurPlay.fileCnt > 1) //TBC
                  {
                     ChnlUnlock(index, lThisFunction);
                     ChnlLock(index, lThisFunction);
                     gSipCallDtls.sipCallHdls[index].playStatus = ACU_PLAY_MULTIPLE_FILES_INTERUPTED; //for interrupting
                     ChnlUnlock(index, lThisFunction);
                  }
                  else
                  {
                     ChnlUnlock(index, lThisFunction);
                  }
                  //all play on dtmf check
                  //CancelDtmf(index); //not effective

                  return StopPlay(index);
               }
               else if(CKT_RECORDING == pChannel->chnlStatus)
               {
                  ChnlUnlock(index, lThisFunction);
                  ChnlLock(index, lThisFunction);
                  gSipCallDtls.sipCallHdls[index].acuCurRecord.dtmf = true;
                  ChnlUnlock(index, lThisFunction);
                  return StopRecord(index);
               }
               else if(CKT_GETDIG == pChannel->chnlStatus)
               {
                  ChnlUnlock(index, lThisFunction);
                  //if(gCancelDtmfTimerTags[index] == 0)
                  ChnlLock(index, lThisFunction);
                  if(gSipCallDtls.sipCallHdls[index].timerTag == 0)
                  {
                     ChnlUnlock(index, lThisFunction);
                     this->StartDtmfTimer(index, gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.interDigitTimeOut/1000);
                  }
                  else
                  {
                     ChnlUnlock(index, lThisFunction);
                     this->CancelDtmfTimer(index);
                     this->StartDtmfTimer(index, gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.interDigitTimeOut/1000);
                  }
                  ChnlLock(index, lThisFunction);
               }


               if(gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigitsLen ==
                     gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.numOfDig)
               {
                  ChnlUnlock(index, lThisFunction);
                  //if (!gSipCallDtls.sipCallHdls[index].acuCurPlay.play.dtmfEnable) check
                  {
                     ChnlLock(index, lThisFunction);
                     if (gSipCallDtls.sipCallHdls[index].timerTag != 0)
                     {
                        ChnlUnlock(index, lThisFunction);
                        gSipMediaMgr.CancelDtmfTimer(index);
                     }
                     else
                     {
                        ChnlUnlock(index, lThisFunction);
                     }
                  }
                  ChnlLock(index, lThisFunction);
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,                                                //TBR
                        "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d DTMF-EVT: MC_GETDIG"
                        " Collected NoD:%d Dtmf:%s TermChar:%s",
                        gSipCallDtls.sipCallHdls[index].seqNum, 
                        gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.circuitId,
                        gSipCallDtls.sipCallHdls[index].handle, 
                        pChannel->chnlStatus, gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.numOfDig,
                        gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits,
                        gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.teminateChars);
                  ChnlUnlock(index, lThisFunction);

                  T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  //gLog.GenerateLog(ACU_SIP105, lLogText);

                  rAcuRsp.cmdType             = MC_GETDIGSTP;
                  rAcuRsp.rspMsg              = MP_RSP_SUCCESS;

                  ChnlLock(index, lThisFunction);

                  rAcuRsp.mpRspData.getDigit  = gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf;
                  rAcuRsp.mpRspData.getDigit.numOfDig = gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.numOfDig;
                  strcpy(rAcuRsp.mpRspData.getDigit.rspDigits,
                        gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits);
                  gSipCallDtls.sipCallHdls[index].playStatus = ACU_PLAY_NEXT_NOT_REQD;

                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d DTMF-EVT: MC_GETDIG"
                        " Collected NoD:%d Dtmf:%s",
                        gSipCallDtls.sipCallHdls[index].seqNum,
                        //rAcuRsp.mpRspData.getDigit.seqNum, 
                        rAcuRsp.mpRspData.getDigit.circuitId,
                        gSipCallDtls.sipCallHdls[index].handle, 
                        pChannel->chnlStatus,
                        rAcuRsp.mpRspData.getDigit.numOfDig,
                        rAcuRsp.mpRspData.getDigit.rspDigits);
                  T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP105, lLogText);

                  if(CKT_GETDIG == pChannel->chnlStatus)
                  {
                     gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigitsLen = 0;  //check
                     memset(&(gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits), 0, sizeof(MAX_DTMF_RSP_DIGITS));
                  }
                  ChnlUnlock(index, lThisFunction);
                  return true;
               }
               else if(strstr(gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits, 
                        gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.teminateChars))
               {
                  ChnlUnlock(index, lThisFunction);
                  //if (!gSipCallDtls.sipCallHdls[index].acuCurPlay.play.dtmfEnable) check
                  {
                     ChnlLock(index, lThisFunction);
                     if (gSipCallDtls.sipCallHdls[index].timerTag != 0)
                     {
                        ChnlUnlock(index, lThisFunction);
                        gSipMediaMgr.CancelDtmfTimer(index);
                     }
                     else
                     {
                        ChnlUnlock(index, lThisFunction);
                     }

                  }
                  ChnlLock(index, lThisFunction);
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,                                                //TBR
                        "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d DTMF-EVT: MC_GETDIG"
                        " Collected NoD:%d Dtmf:%s TermChar:%s",
                        gSipCallDtls.sipCallHdls[index].seqNum, 
                        gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.circuitId,
                        gSipCallDtls.sipCallHdls[index].handle, 
                        pChannel->chnlStatus, gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.numOfDig,
                        gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits,
                        gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.teminateChars);
                  ChnlUnlock(index, lThisFunction);

                  T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  //gLog.GenerateLog(ACU_SIP105, lLogText);

                  rAcuRsp.cmdType             = MC_GETDIGSTP;
                  rAcuRsp.rspMsg              = MP_RSP_SUCCESS;
                  ChnlLock(index, lThisFunction);
                  rAcuRsp.mpRspData.getDigit  = gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf;
                  rAcuRsp.mpRspData.getDigit.numOfDig = gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.numOfDig;
                  strncpy(rAcuRsp.mpRspData.getDigit.rspDigits,
                        gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits,
                        strlen(gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits) - 1); //eliminating term char

                  gSipCallDtls.sipCallHdls[index].playStatus = ACU_PLAY_NEXT_NOT_REQD;

                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d DTMF-EVT: MC_GETDIG"
                        " Collected NoD:%d Dtmf:%s",
                        gSipCallDtls.sipCallHdls[index].seqNum,
                        //rAcuRsp.mpRspData.getDigit.seqNum, 
                        rAcuRsp.mpRspData.getDigit.circuitId,
                        gSipCallDtls.sipCallHdls[index].handle, 
                        pChannel->chnlStatus,
                        rAcuRsp.mpRspData.getDigit.numOfDig,
                        rAcuRsp.mpRspData.getDigit.rspDigits);
                  T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP105, lLogText);

                  if(CKT_GETDIG == pChannel->chnlStatus)
                  {
                     gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigitsLen = 0;  //check
                     memset(&(gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits), 0, sizeof(MAX_DTMF_RSP_DIGITS));
                  }
                  ChnlUnlock(index, lThisFunction);
                  return true;
               }
               else
               {
                  ChnlUnlock(index, lThisFunction);
               }
            }
            //else if(gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.numOfDig == 1)  //verify
            else  //verify
            {
               ChnlUnlock(index, lThisFunction);
               TEXT lTmpData[MAX_DTMF_RSP_DIGITS] = "";

               ChnlLock(index, lThisFunction);

               strncpy(lTmpData, gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits, MAX_DTMF_RSP_DIGITS);
               gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigitsLen += 1;

               snprintf(gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits, MAX_DTMF_RSP_DIGITS,
                     "%s%c", lTmpData, rp.param0);

               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d DTMF-EVT: MC_GETDIG"
                     " Buffer:%s Detected Digit: [%c] Param1:%dms",
                     gSipCallDtls.sipCallHdls[index].seqNum, 
                     gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.circuitId,
                     gSipCallDtls.sipCallHdls[index].handle, 
                     pChannel->chnlStatus, gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits,
                     rp.param0, rp.param1);
               ChnlUnlock(index, lThisFunction);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP105, lLogText);
            }
         }
         break;
      case kSMRecognisedTone:
         type = "Tone";
         break;
      case kSMRecognisedCPTone:
         type = "CPTone";
         break;
      case kSMRecognisedGruntStart:
         type = "GruntStart";
         break;
      case kSMRecognisedGruntEnd:
         type = "GruntEnd";
         break;
      case kSMRecognisedASRResult:
         type = "ASRResult";
         break;
      case kSMRecognisedASRUncertain:
         type = "ASRUncertain";
         break;
      case kSMRecognisedASRRejected:
         type = "ASRRejected";
         break;
      case kSMRecognisedASRTimeout:
         type = "ASRTimeout";
         break;
      case kSMRecognisedCatSig:
         type = "CatSig";
         break;
      case kSMRecognisedOverrun:
         type = "Overrun";
         break;
      default:
         ChnlLock(index, lThisFunction);
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d Type:%d DTMF-EVT: MC_GETDIG"
               " Error: in sm_get_recognised",
               gSipCallDtls.sipCallHdls[index].seqNum,
               index,
               gSipCallDtls.sipCallHdls[index].handle, pChannel->chnlStatus, rp.type);
         ChnlUnlock(index, lThisFunction);
         TERR(gTrace, printf("%s: %s",gProcessName, lLogText ););
         gLog.GenerateLog(ACU_SIP106, lLogText);
         break;
   }

   if(rp.type != kSMRecognisedDigit)
   {
      printf("%s: %d %d\n", type, rp.param0, rp.param1);
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d Type:%d-%s DTMF-EVT: MC_GETDIG"
            " Not a Digit",
            gSipCallDtls.sipCallHdls[index].seqNum,
            index,
            gSipCallDtls.sipCallHdls[index].handle, pChannel->chnlStatus, rp.type, type);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s",gProcessName, lLogText ););
      gLog.GenerateLog(ACU_SIP107, lLogText);
   }

   return false;
}
//----------------------------------------------------------------------
// METHOD      : HandleRecordFinish
// DESCRIPTION : Handles Record Completion on the specified channel
// PARAMETER   : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::HandleRecordFinish(UINT16 index, MpResponseDetails & rAcuRsp)
{
   TEXT lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT lThisFunction[] = "HandleRecordFinish";

   ChnlLock(index, lThisFunction);
   SipCallHandlers *pChannel = &gSipCallDtls.sipCallHdls[index];
   ChnlUnlock(index, lThisFunction);


   switch(pChannel->chnlStatus)
   {
      case CKT_RECORDING:
         {
            rAcuRsp.rspMsg   = MP_RSP_SUCCESS;
            rAcuRsp.cmdType  = MC_RECSTP;

            ChnlLock(index, lThisFunction);
            rAcuRsp.mpRspData.recordMsg   = pChannel->acuCurRecord.record;
            pChannel->chnlStatus          = CKT_IDLE;
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d RecTime:%d [%d] REC-EVT: MC_REC "
                  "Record Completed Successfully",
                  pChannel->acuCurRecord.record.seqNum,
                  pChannel->acuCurRecord.record.circuitId,
                  gSipCallDtls.sipCallHdls[index].handle, 
                  pChannel->chnlStatus, pChannel->acuCurRecord.record.recTime,
                  rAcuRsp.mpRspData.recordMsg.recTime);
            ChnlUnlock(index, lThisFunction);

            T(gTrace, printf("%s: %s\n",gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP108, lLogText);
            break;
         }

      default:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d REC-EVT: MC_REC "
                  "Error: Invalid Channel Status",
                  pChannel->acuCurRecord.record.seqNum,
                  pChannel->acuCurRecord.record.circuitId,
                  gSipCallDtls.sipCallHdls[index].handle, 
                  pChannel->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP109, lLogText);
            return false;
         }
   }
   return true;
}


//----------------------------------------------------------------------
// METHOD      : HandlePlayFinish
// DESCRIPTION : Handles play finish on the specified channel
// PARAMETER   : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::HandlePlayFinish(UINT16 index, MpResponseDetails & rAcuRsp)
{
   INT16 lResult = 0;
   TEXT lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT lThisFunction[] = "HandlePlayFinish";

   ChnlLock(index, lThisFunction);
   SipCallHandlers *pChannel = &gSipCallDtls.sipCallHdls[index];
   ChnlUnlock(index, lThisFunction);

   switch(pChannel->chnlStatus)
   {
      case CKT_PLAYING:
         {
            ChnlLock(index, lThisFunction);
            if(ACU_PLAY_MULTIPLE_FILES == pChannel->playStatus &&
                  pChannel->acuCurPlay.fileCnt != 0)
               //&& pChannel->playControlStatus == CONTROL_PLAY_MULTIFILE_INTERRUPT) //verify - added for multifile play interruption
            {
               int lFileIndx = pChannel->acuCurPlay.play.vFileCount - pChannel->acuCurPlay.fileCnt;

               pChannel->acuCurDtmf.detectedDigitsLen = 0;   //check

               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d PLAY-EVT: MC_CNTTN Status: "
                     " Starting Next File  [%d:%s] to Play [Cnt:%d] PlayStatus:%d "
                     , pChannel->acuCurPlay.play.seqNum, 
                     pChannel->acuCurPlay.play.circuitId, gSipCallDtls.sipCallHdls[index].handle, 
                     pChannel->chnlStatus,
                     pChannel->acuCurPlay.fileCnt, pChannel->acuCurPlay.play.voiceFile[lFileIndx],
                     pChannel->acuCurPlay.play.vFileCount, pChannel->playStatus);
               ChnlUnlock(index, lThisFunction);
               T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP110, lLogText);

               ChnlLock(index, lThisFunction);
               if(NULL != pChannel->acuCurPlay.fp.fd)
               {
                  ChnlUnlock(index, lThisFunction);

                  ChnlLock(index, lThisFunction);

                  if(0 != fclose(pChannel->acuCurPlay.fp.fd))
                  {
                     snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                           "RefNum:%08X CID:%06d Handle:%08X Fd:%d Error:%d Cannot close file",
                           pChannel->acuCurPlay.play.seqNum, 
                           pChannel->acuCurPlay.play.circuitId, gSipCallDtls.sipCallHdls[index].handle, 
                           pChannel->acuCurPlay.fp.fd, errno);
                     ChnlUnlock(index, lThisFunction);
                     TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                     gLog.GenerateLog(ACU_SIP194, lLogText);
                  }
                  else
                  {
                     snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                           "RefNum:%08X CID:%06d Handle:%08X Fd:%d File Closed",
                           pChannel->acuCurPlay.play.seqNum, 
                           pChannel->acuCurPlay.play.circuitId, gSipCallDtls.sipCallHdls[index].handle, 
                           pChannel->acuCurPlay.fp.fd);
                     ChnlUnlock(index, lThisFunction);
                     TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                     gLog.GenerateLog(ACU_SIP195, lLogText);
                  }
                  ChnlLock(index, lThisFunction);
                  pChannel->acuCurPlay.fp.fd = NULL;
                  ChnlUnlock(index, lThisFunction);
               }
               else
               {
                  ChnlUnlock(index, lThisFunction);
               }

               ChnlLock(index, lThisFunction);
               memset(&pChannel->acuCurPlay.fp, 0, sizeof(SM_FILE_REPLAY_PARMS));
               ChnlUnlock(index, lThisFunction);
               ChnlLock(index, lThisFunction);
               if(!pChannel->acuCurPlay.play.voiceFile[lFileIndx])
               {
                  pChannel->acuCurPlay.fp.fd = NULL;
                  ChnlUnlock(index, lThisFunction);
               }
               else
               {
                  pChannel->acuCurPlay.fp.fd =
                     fopen(pChannel->acuCurPlay.play.voiceFile[lFileIndx], "rb");
                  ChnlUnlock(index, lThisFunction);

                  ChnlLock(index, lThisFunction);
                  if (NULL == pChannel->acuCurPlay.fp.fd)
                  {
                     snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                           "RefNum:%08X CID:%06d Handle:%08X File:%s Error: %d Cannot open file",
                           pChannel->acuCurPlay.play.seqNum, pChannel->acuCurPlay.play.circuitId, 
                           gSipCallDtls.sipCallHdls[index].handle, 
                           pChannel->acuCurPlay.play.voiceFile[lFileIndx], errno);
                     ChnlUnlock(index, lThisFunction);
                     TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                     gLog.GenerateLog(ACU_SIP163, lLogText);
                     return false;  //check
                  }
                  else
                  {
                     snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                           "RefNum:%08X CID:%06d Handle:%08X File:%s Fd:%d File Opened",
                           pChannel->acuCurPlay.play.seqNum, pChannel->acuCurPlay.play.circuitId, 
                           gSipCallDtls.sipCallHdls[index].handle, 
                           pChannel->acuCurPlay.play.voiceFile[lFileIndx], 
                           pChannel->acuCurPlay.fp.fd);
                     ChnlUnlock(index, lThisFunction);
                     TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                     gLog.GenerateLog(ACU_SIP193, lLogText);
                  }
               }

               ChnlLock(index, lThisFunction);
               pChannel->acuCurPlay.fp.replay_parms.channel = pChannel->channel;
               pChannel->acuCurPlay.fp.replay_parms.type    = (kSMDataFormat) mDataFormat;

               lResult = sm_replay_file_start (&pChannel->acuCurPlay.fp);
               ChnlUnlock(index, lThisFunction);
               if ( lResult != 0 )
               {
                  ChnlLock(index, lThisFunction);
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d, PLAY-EVT: MC_CNTTN "
                        "CMD:sm_replay_file_start Error: failed %s <%d>",
                        pChannel->acuCurPlay.play.seqNum, 
                        pChannel->acuCurPlay.play.circuitId, gSipCallDtls.sipCallHdls[index].handle, 
                        pChannel->chnlStatus, pChannel->acuCurPlay.play.voiceFile[lFileIndx], lResult);
                  ChnlUnlock(index, lThisFunction);
                  TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP111, lLogText);
                  return false;
               }
               ChnlLock(index, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d PLAY-EVT: MC_CNTTN "
                     "CMD:sm_replay_file_start Issued %s <%d>",
                     pChannel->acuCurPlay.play.seqNum, 
                     pChannel->acuCurPlay.play.circuitId, gSipCallDtls.sipCallHdls[index].handle, 
                     pChannel->chnlStatus, pChannel->acuCurPlay.play.voiceFile[lFileIndx], lResult);
               ChnlUnlock(index, lThisFunction);
               T(gTrace, printf("%s: %s\n",gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP112, lLogText);
               return false; //true; 
            }
            else
            {
               ChnlUnlock(index, lThisFunction);
               ChnlLock(index, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d PLAY-EVT: MC_DISTN "
                     "Status: Play Completed Successfully RptPly:%d",
                     pChannel->acuCurPlay.play.seqNum,
                     pChannel->acuCurPlay.play.circuitId, gSipCallDtls.sipCallHdls[index].handle, 
                     pChannel->chnlStatus, pChannel->acuCurPlay.play.repeatPlay);
               ChnlUnlock(index, lThisFunction);
               //AcuMediaUtil::ConvertStatusToStr(pChannel->status),
               T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP113, lLogText);

               ChnlLock(index, lThisFunction);
               if(NULL != pChannel->acuCurPlay.fp.fd)
               {
                  ChnlUnlock(index, lThisFunction);
                  ChnlLock(index, lThisFunction);
                  if(0 != fclose(pChannel->acuCurPlay.fp.fd))
                  {
                     snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                           "RefNum:%08X CID:%06d Handle:%08X Fd:%d Error:%d Cannot close file",
                           pChannel->acuCurPlay.play.seqNum, 
                           pChannel->acuCurPlay.play.circuitId, gSipCallDtls.sipCallHdls[index].handle, 
                           pChannel->acuCurPlay.fp.fd, errno);
                     ChnlUnlock(index, lThisFunction);
                     TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                     gLog.GenerateLog(ACU_SIP194, lLogText);
                  }
                  else
                  {
                     snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                           "RefNum:%08X CID:%06d Handle:%08X Fd:%d File Closed",
                           pChannel->acuCurPlay.play.seqNum, 
                           pChannel->acuCurPlay.play.circuitId, gSipCallDtls.sipCallHdls[index].handle, 
                           pChannel->acuCurPlay.fp.fd);
                     ChnlUnlock(index, lThisFunction);
                     TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                     gLog.GenerateLog(ACU_SIP195, lLogText);
                  }
                  ChnlLock(index, lThisFunction);
                  pChannel->acuCurPlay.fp.fd = NULL;
                  ChnlUnlock(index, lThisFunction);
               }
               else
               {
                  ChnlUnlock(index, lThisFunction);
               }

               ChnlLock(index, lThisFunction);
               if(0 == pChannel->acuCurPlay.fileCnt &&
                     pChannel->playStatus == ACU_PLAY_MULTIPLE_FILES)
               {
                  ChnlUnlock(index, lThisFunction);
                  ChnlLock(index, lThisFunction);
                  pChannel->playStatus = ACU_PLAY_MULTIPLE_FILES_COMPLETED;
                  ChnlUnlock(index, lThisFunction);
               }
               else
               {
                  ChnlUnlock(index, lThisFunction);
               }

               ChnlLock(index, lThisFunction);
               if(true == pChannel->acuCurPlay.play.repeatPlay)
               {
                  ChnlUnlock(index, lThisFunction);
                  ChnlLock(index, lThisFunction);
                  if(true != StartPlay(pChannel->acuCurPlay.play))
                  {
                     pChannel->playStatus     = ACU_PLAY_NEXT_NOT_REQD;
                     pChannel->chnlStatus  = CKT_IDLE;

                     memset(&(pChannel->acuCurPlay), 0, sizeof(MpPlay));
                     rAcuRsp.mpRspData.playMsg   = pChannel->acuCurPlay.play;
                     ChnlUnlock(index, lThisFunction);

                     rAcuRsp.rspMsg              = MP_RSP_FAILURE;
                     rAcuRsp.cmdType             = MC_CNTTN;
                     return true;  //check
                  }
                  else
                  {
                     snprintf(lLogText, MAX_LOG_TEXT_LEN,
                           "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d PLAY-EVT: MC_CNTTN "
                           "Repeating Play FlCnt:%d",
                           pChannel->acuCurPlay.play.seqNum,
                           pChannel->acuCurPlay.play.circuitId, gSipCallDtls.sipCallHdls[index].handle, 
                           pChannel->chnlStatus, pChannel->acuCurPlay.play.vFileCount);
                     ChnlUnlock(index, lThisFunction);
                     T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
                     gLog.GenerateLog(ACU_SIP114, lLogText);
                     return false;
                  }
               }
               else
               {
                  rAcuRsp.rspMsg                       = MP_RSP_SUCCESS;
                  rAcuRsp.cmdType                      = MC_DISTN;
                  rAcuRsp.mpRspData.playMsg.seqNum     = pChannel->acuCurPlay.play.seqNum;
                  rAcuRsp.mpRspData.playMsg.circuitId  = pChannel->acuCurPlay.play.circuitId;

                  pChannel->playStatus       = ACU_PLAY_NEXT_NOT_REQD;
                  ChnlUnlock(index, lThisFunction);

                  ChnlLock(index, lThisFunction);

                  if(NULL != pChannel->acuCurPlay.fp.fd)
                  {
                     ChnlUnlock(index, lThisFunction);
                     ChnlLock(index, lThisFunction);
                     if(0 != fclose(pChannel->acuCurPlay.fp.fd))
                     {
                        snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                              "RefNum:%08X CID:%06d Handle:%08X Fd:%d Error:%d Cannot close file",
                              pChannel->acuCurPlay.play.seqNum, 
                              pChannel->acuCurPlay.play.circuitId, gSipCallDtls.sipCallHdls[index].handle, 
                              pChannel->acuCurPlay.fp.fd, errno);
                        ChnlUnlock(index, lThisFunction);
                        TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                        gLog.GenerateLog(ACU_SIP194, lLogText);
                     }
                     else
                     {
                        snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                              "RefNum:%08X CID:%06d Handle:%08X Fd:%d File Closed",
                              pChannel->acuCurPlay.play.seqNum, 
                              pChannel->acuCurPlay.play.circuitId, gSipCallDtls.sipCallHdls[index].handle, 
                              pChannel->acuCurPlay.fp.fd);
                        ChnlUnlock(index, lThisFunction);
                        TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                        gLog.GenerateLog(ACU_SIP195, lLogText);
                     }
                     ChnlLock(index, lThisFunction);
                     pChannel->acuCurPlay.fp.fd = NULL;
                     ChnlUnlock(index, lThisFunction);
                  }
                  else
                  {
                     ChnlUnlock(index, lThisFunction);
                  }
                  ChnlLock(index, lThisFunction);
                  pChannel->chnlStatus          = CKT_IDLE;
                  ChnlUnlock(index, lThisFunction);
               }
            }
         }
         break;

      default:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d PLAY-EVT: MC_CNTTN "
                  "Error: Play Stop Invalid Channel Status",
                  pChannel->acuCurPlay.play.seqNum,
                  pChannel->acuCurPlay.play.circuitId, gSipCallDtls.sipCallHdls[index].handle, 
                  pChannel->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            //index, AcuMediaUtil::ConvertStatusToStr(pChannel->status));
            TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP115, lLogText);
            return false;
         }
   }

   return true;
}


//----------------------------------------------------------------------
// METHOD      : StartMediaControlThread
// DESCRIPTION : Check Channel Status Thread
// PARAMETER   :
// RETURN      : VOID
//----------------------------------------------------------------------
void *StartMediaControlThread (void *lPtr)
{
   sm_replay_status_parms lStatusParms;
   MpResponseDetails lAcuRsp;
   sm_record_status_parms lRecStatusParms;
   SM_RECOGNISED_PARMS  dp;

   int      lResult = 0;
   struct   pollfd pfd[3];
   TEXT     lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT     lProcessName[SIP_MAX_PROCESS_NAME + 1] = "";
   TEXT     lThisFunction[] = "StartMediaControlThread";

   snprintf(lProcessName, SIP_MAX_PROCESS_NAME, "ACU_EVT");

   memset(&pfd, 0, sizeof(pfd));

   pfd[0].fd      = gSipMediaMgr.mPlayEvent.fd;
   pfd[0].events  = gSipMediaMgr.mPlayEvent.mode;
   pfd[1].fd      = gSipMediaMgr.mDtmfEvent.fd;
   pfd[1].events  = gSipMediaMgr.mDtmfEvent.mode;
   pfd[2].fd      = gSipMediaMgr.mRecEvent.fd;
   pfd[2].events  = gSipMediaMgr.mRecEvent.mode;

   snprintf(lLogText, MAX_LOG_TEXT_LEN, "EVT-THREAD: Play[Fd:%d Mode:%d] Dtmf[Fd:%d Mode:%d]"
         " Record[Fd:%d Mode:%d]", pfd[0].fd, pfd[0].events, pfd[1].fd, pfd[1].events,
         pfd[2].fd, pfd[2].events);
   T(gTrace, printf("%s: Thread Info %s\n", lProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP116, lLogText);

   for(;;)
   {
      lResult = poll(pfd, 3, -1);
      if (lResult < 0)
      {
         TERR (gTrace, printf("%s:  Error: EVT-THREAD POLL() failed Cannot wait for channels\n",
                  lProcessName););
         gLog.GenerateLog(ACU_SIP117, lLogText);
         pthread_exit(NULLPTR);
         return NULLPTR;
      }

      if(pfd[0].revents)
      {
         int lIndex = 0;
         memset(&lStatusParms, 0, sizeof(lStatusParms));

         lStatusParms.channel = kSMNullChannelId;
         lResult = sm_replay_status (&lStatusParms);
         if (lResult == ERR_SM_NO_SUCH_CHANNEL)
            continue;

         if (lResult)
         {
            TERR (gTrace, printf("%s: Error: EVT-THREAD PLAY: Cannot check PLAY status %d\n",
                     lProcessName, lResult););
            gLog.GenerateLog(ACU_SIP118, lLogText);
//  return false;
         }
#if 0
         lIndex = sm_get_channel_ix(lStatusParms.channel);
         if(lIndex < 0)
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "Error: To Get Channel Index at Play Events:%d", lIndex);
            TERR(gTrace, printf("%s: %s\n", lProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP90, lLogText);
            return false; // check wat to do
         }

         int index = gAcuChannel[lIndex].index;

#endif

         TEXT  lKey[50 + 1] = "";
         SipChannel lSipChannel;
         sprintf(lKey, "%ld", lStatusParms.channel); 

         if(true != gSipChannelApi.GetReqMapDetails(lKey, lSipChannel))
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "Error: Failed to Get Channel Details From Hash Key:%s", lKey);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            //gLog.GenerateLog(ACU_SIP62, lLogText);
            continue;
            //  TBD check wat to do  ?????
         }
#if 0
         else
         {
            //ChnlLock(mSipCallHandlers.index, lThisFunction);
            //snprintf(lLogText, MAX_LOG_TEXT_LEN, "RefNum:%08X CID:%06d Channel:%lu ChnlStatus:%d Success to Get Channel Details From Hash pfd[0]",
              //    0,lSipChannel.index, lSipChannel.channel, lStatusParms.status);
            //ChnlUnlock(mSipCallHandlers.index, lThisFunction);
            //snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  //"Success to Get Channel Details From Hash" );
           // T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            //gLog.GenerateLog(ACU_SIP65, 1, lLogText);
         }
#endif

         int index = lSipChannel.index;

         if(lStatusParms.status != kSMReplayStatusHasCapacity)
         {
            gSipMediaMgr.ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d ReplayStatus Other Than HasCapacity:%d ",
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId,
                  gSipCallDtls.sipCallHdls[index].handle, 
                  gSipCallDtls.sipCallHdls[index].chnlStatus, lStatusParms.status);
            gSipMediaMgr.ChnlUnlock(index, lThisFunction);
            T(gTrace, printf("%s: %s\n", lProcessName, lLogText););
            //gLog.GenerateLog(ACU_SIP51, lLogText);
         }

         //if(NULL == gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd && lStatusParms.status == kSMReplayStatusHasCapacity)
         gSipMediaMgr.ChnlLock(index, lThisFunction);
         if(NULL == gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd) 
         {
            //printf("NULL == gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd NULL NULL NULL index:%06d ChnlStatus:%d\n", index, lStatusParms.status);
            gSipMediaMgr.ChnlUnlock(index, lThisFunction);
            if(lStatusParms.status == kSMReplayStatusHasCapacity)
            {
               gSipMediaMgr.ChnlLock(index, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d ReplayStatusHasCapacity:%d Play File Closed",
                     gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,
                     gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId,
                     gSipCallDtls.sipCallHdls[index].handle, 
                     gSipCallDtls.sipCallHdls[index].chnlStatus, lStatusParms.status);
               gSipMediaMgr.ChnlUnlock(index, lThisFunction);
               T(gTrace, printf("%s: %s\n", lProcessName, lLogText););
               //gLog add 
               continue;
            }
         }
         else
         {
            gSipMediaMgr.ChnlUnlock(index, lThisFunction);
         }

         gSipMediaMgr.ChnlLock(index, lThisFunction);
         if(gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_UNAVAILABLE || gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_INITIALIZED )
         {
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d ReplayStatusHasCapacity:%d CKT_UNAVAILABLE pfd[0]",
                     gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,
                     gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId,
                     gSipCallDtls.sipCallHdls[index].handle, 
                     gSipCallDtls.sipCallHdls[index].chnlStatus, lStatusParms.status);
               gSipMediaMgr.ChnlUnlock(index, lThisFunction);
               T(gTrace, printf("%s: %s\n", lProcessName, lLogText););
               //gLog add 
               continue;
         }
         else
         {
            gSipMediaMgr.ChnlUnlock(index, lThisFunction);
         }

         gSipMediaMgr.ChnlLock(index, lThisFunction);
         lResult = sm_replay_file_progress_istatus(&gSipCallDtls.sipCallHdls[index].acuCurPlay.fp, lStatusParms.status);
         gSipMediaMgr.ChnlUnlock(index, lThisFunction);
         if(lResult != ERR_SM_PENDING )
         {
            memset(&lAcuRsp, 0, sizeof(lAcuRsp));

            gSipMediaMgr.ChnlLock(index, lThisFunction);
            gSipCallDtls.sipCallHdls[index].acuCurPlay.fileCnt -= 1;
            gSipMediaMgr.ChnlUnlock(index, lThisFunction);
            if(true == gSipMediaMgr.HandlePlayFinish(index, lAcuRsp))
            {
               gSipMediaMgr.ChnlLock(index, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d Success to Handle PlayFinish",
                     gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,
                     gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId,
                     gSipCallDtls.sipCallHdls[index].handle, 
                     gSipCallDtls.sipCallHdls[index].chnlStatus);
               memset(&gSipCallDtls.sipCallHdls[index].acuCurPlay.play, 0, sizeof(MpPlay));
               gSipMediaMgr.ChnlUnlock(index, lThisFunction);
               T (gTrace, printf("%s: %s\n", lProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP119, lLogText);
            }

            lAcuRsp.rspMsg              = MP_RSP_SUCCESS;
            lAcuRsp.cmdType             = MC_CNTTN;

            gSipMediaMgr.ChnlLock(index, lThisFunction);
            T (gTrace, printf("%s: fileCnt:%d playStatus:%d\n", lProcessName, gSipCallDtls.sipCallHdls[index].acuCurPlay.fileCnt,
                     gSipCallDtls.sipCallHdls[index].playStatus););
            gSipMediaMgr.ChnlUnlock(index, lThisFunction);
            gSipMediaMgr.ChnlLock(index, lThisFunction);
            if(!gSipCallDtls.sipCallHdls[index].acuCurPlay.fileCnt ||
                  gSipCallDtls.sipCallHdls[index].playStatus == ACU_PLAY_NEXT_NOT_REQD)
            {
               //ACU_PLAY_MULTIPLE_FILES_INTERUPTED) //CONTROL_PLAY_MULTIFILE_INTERRUPT)   
               ////check done - fine::: commented to send terminate multifile play rsp
               gSipMediaMgr.mSipQueApi.WriteToMediaRspQue(lAcuRsp, lAcuRsp.mpRspData.playMsg.circuitId, lLogText);
               gSipMediaMgr.ChnlUnlock(index, lThisFunction);
            }
            else
            {
               gSipMediaMgr.ChnlUnlock(index, lThisFunction);
            }
         }
      }

      if(pfd[2].revents)
      {
         int lRecIndex = 0;
         memset(&lRecStatusParms, 0, sizeof(lRecStatusParms));

         lRecStatusParms.channel = kSMNullChannelId;
         lResult = sm_record_status (&lRecStatusParms);

         if (lResult == ERR_SM_NO_SUCH_CHANNEL)
            continue;

         if (lResult)
         {
            TERR (gTrace, printf("%s: Error: EVT-THREAD REC: Cannot Check Channel status %d\n",
                     lProcessName, lResult););
            gLog.GenerateLog(ACU_SIP120, lLogText);  //TBC
  //          return false;
         }

#if 0
         lRecIndex = sm_get_channel_ix(lRecStatusParms.channel);
         if(lRecIndex < 0)
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "Error: To Get Channel Index at Record Events:%d", lRecIndex);
            TERR(gTrace, printf("%s: %s\n", lProcessName, lLogText););
            //gLog.GenerateLog(ACU_SIP90, lLogText);
            return false; // check wat to do
         }

         int index = gAcuChannel[lRecIndex].index;
#endif
         TEXT  lKey[50 + 1] = "";
         SipChannel lSipChannel;
         sprintf(lKey, "%ld", lRecStatusParms.channel); 

         if(true != gSipChannelApi.GetReqMapDetails(lKey, lSipChannel))
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "Error: Failed to Get Channel Details From Hash Key:%s", lKey);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            //gLog.GenerateLog(ACU_SIP62, lLogText);
            continue;
            //  TBD check wat to do  ?????
         }
#if 0
         else
         {
            //ChnlLock(mSipCallHandlers.index, lThisFunction);
            //snprintf(lLogText, MAX_LOG_TEXT_LEN, "RefNum:%08X CID:%06d Channel:%lu Success to Get Channel Details From Hash pfd[2]",
            //      0,lSipChannel.index, lSipChannel.channel);
            //ChnlUnlock(mSipCallHandlers.index, lThisFunction);
            //snprintf(lLogText, MAX_LOG_TEXT_LEN,
              //    "Success to Get Channel Details From Hash" );
            //T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            //gLog.GenerateLog(ACU_SIP65, 1, lLogText);
         }
#endif
         int index = lSipChannel.index;

         if(lRecStatusParms.status != kSMRecordStatusData)
         {
            gSipMediaMgr.ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_CNTTN StopRecord Success",
                  gSipCallDtls.sipCallHdls[index].acuCurRecord.record.seqNum,
                  gSipCallDtls.sipCallHdls[index].acuCurRecord.record.circuitId,
                  gSipCallDtls.sipCallHdls[index].handle, 
                  gSipCallDtls.sipCallHdls[index].chnlStatus);
            gSipMediaMgr.ChnlUnlock(index, lThisFunction);
            T(gTrace, printf("%s: %s\n",lProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP121, 2, lLogText);
         }

         gSipMediaMgr.ChnlLock(index, lThisFunction);
         lResult = sm_record_file_progress_istatus(&gSipCallDtls.sipCallHdls[index].acuCurRecord.rp, lRecStatusParms.status);
         gSipMediaMgr.ChnlUnlock(index, lThisFunction);
         if(lResult != ERR_SM_PENDING)
         {
            memset(&lAcuRsp, 0, sizeof(lAcuRsp));
            {
               gSipMediaMgr.ChnlLock(index, lThisFunction);
               if(0 != sm_record_wav_close(&gSipCallDtls.sipCallHdls[index].acuCurRecord.rp))
               {
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d Error: Handle RecordFinish Failed",
                        gSipCallDtls.sipCallHdls[index].acuCurRecord.record.seqNum,
                        gSipCallDtls.sipCallHdls[index].acuCurRecord.record.circuitId,
                        gSipCallDtls.sipCallHdls[index].handle, 
                        gSipCallDtls.sipCallHdls[index].chnlStatus);
                  gSipMediaMgr.ChnlUnlock(index, lThisFunction);
                  T(gTrace, printf("%s: %s\n", lProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP122, 2, lLogText);
                  //return false; // TBC check wat to do
               }
               else
               {
                  gSipMediaMgr.ChnlUnlock(index, lThisFunction);
               }
            }

            if(true == gSipMediaMgr.HandleRecordFinish(index, lAcuRsp))
            {
               gSipMediaMgr.ChnlLock(index, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d RecTime:%d [%d] Success to Handle RecordFinish StopPlay Success",
                     gSipCallDtls.sipCallHdls[index].acuCurRecord.record.seqNum,
                     gSipCallDtls.sipCallHdls[index].acuCurRecord.record.circuitId,
                     gSipCallDtls.sipCallHdls[index].handle, 
                     gSipCallDtls.sipCallHdls[index].chnlStatus,
                     gSipCallDtls.sipCallHdls[index].acuCurRecord.record.recTime,
                     lAcuRsp.mpRspData.recordMsg.recTime);
               T(gTrace, printf("%s: %s\n", lProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP123, 2, lLogText);

               gSipMediaMgr.mSipQueApi.WriteToMediaRspQue(lAcuRsp, lAcuRsp.mpRspData.recordMsg.circuitId, lLogText);
               memset(&gSipCallDtls.sipCallHdls[index].acuCurRecord, 0, sizeof(MpRecord));
               gSipMediaMgr.ChnlUnlock(index, lThisFunction);
            }

         }

      } 
      if(pfd[1].revents)
      {
         int lDtmfIndex = 0;

         memset(&dp, 0, sizeof(dp));

         dp.channel = kSMNullChannelId;
         lResult = sm_get_recognised(&dp);

         if (lResult == ERR_SM_NO_SUCH_CHANNEL)
            continue;
#if 0
         lDtmfIndex = sm_get_channel_ix(dp.channel);
         if(lDtmfIndex < 0)
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "Error: To Get Channel Index at Record Events:%d", lDtmfIndex);
            TERR(gTrace, printf("%s: %s\n", lProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP124, lLogText);
            return false; // TBC check wat to do
         }

         int index = gAcuChannel[lDtmfIndex].index;
#endif
         TEXT  lKey[50 + 1] = "";
         SipChannel lSipChannel;
         sprintf(lKey, "%ld", dp.channel); 

         if(true != gSipChannelApi.GetReqMapDetails(lKey, lSipChannel))
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "Error: Failed to Get Channel Details From Hash Key:%s", lKey);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            //gLog.GenerateLog(ACU_SIP62, lLogText);
            continue;
            //  TBD check wat to do  ?????
         }
#if 0
         else
         {
            //ChnlLock(mSipCallHandlers.index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN, "RefNum:%08X CID:%06d Channel:%lu Success to Get Channel Details From Hash pfd[1]",
                  0,lSipChannel.index, lSipChannel.channel);
            //ChnlUnlock(mSipCallHandlers.index, lThisFunction);
            //snprintf(lLogText, MAX_LOG_TEXT_LEN,
              //    "Success to Get Channel Details From Hash");
            T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            //gLog.GenerateLog(ACU_SIP65, 1, lLogText);
         }
#endif
         int index = lSipChannel.index;

         T(gTrace, printf("%s: EVT-THREAD DTMF: ChannelId:%lu Type:%d Index:%d \n",
                  lProcessName, dp.channel, dp.type, index););

         memset(&lAcuRsp, 0, sizeof(lAcuRsp));

         if(true == gSipMediaMgr.HandleDtmfDetection(index, dp, lAcuRsp))
         {
            gSipMediaMgr.ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d Success to Handle DTMF Detection",
                  lAcuRsp.mpRspData.getDigit.seqNum, 
                  lAcuRsp.mpRspData.getDigit.circuitId,
                  gSipCallDtls.sipCallHdls[index].handle, 
                  gSipCallDtls.sipCallHdls[index].chnlStatus);
            gSipMediaMgr.ChnlUnlock(index, lThisFunction);
            T(gTrace, printf("%s: %s\n", lProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP125, lLogText);

            gSipMediaMgr.ChnlLock(index, lThisFunction);
            if(gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_GETDIG)
            {
               gSipCallDtls.sipCallHdls[index].chnlStatus          = CKT_IDLE;
               gSipMediaMgr.mSipQueApi.WriteToMediaRspQue(lAcuRsp, lAcuRsp.mpRspData.getDigit.circuitId, lLogText);
               memset(&(gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf), 0, sizeof(MpGetDigit));
               gSipMediaMgr.ChnlUnlock(index, lThisFunction);
            }
            else
            {
               gSipMediaMgr.ChnlUnlock(index, lThisFunction);
            }
         }

         if (!dp.type)
            continue;
      }
   }

   pthread_exit(NULLPTR);
   return NULLPTR;
}

//-------------------------------------------------------------
// FUNCTION    : CreateMediaControlThread
// DESCRIPTION : Creates Event thread which handles the play,
//               record and dtmf events
// PARAMETER   : None
// RETURN      : BOOLEAN
// THROWS      : None
//-------------------------------------------------------------
BOOLEAN SipMediaMgr::CreateMediaControlThread()
{
   TEXT lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   BOOLEAN     lRetVal;

   pthread_t   lMediaThread;

   void* (*lpFuncPtr)(void * );
   lpFuncPtr = StartMediaControlThread;

   lRetVal = pthread_create(&lMediaThread, NULLPTR, lpFuncPtr, NULL);
   if(lRetVal != 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "Error: pthread_create failed for StartMediaControlThread for %s", gProcessName);
      TERR(gTrace, printf("%s-%ld: %s\n",
               gProcessName, syscall(224), lLogText););
      gLog.GenerateLog(ACU_SIP190, lLogText); //TBC
      return false;
   }

   printf ("%s: Tid:%lu Media Thread Creation success\n",
                     gProcessName, lMediaThread);

   return true;
}

//-------------------------------------------------------------
// FUNCTION    : CancelDtmf
// DESCRIPTION :
// PARAMETER   :
// RETURN      : BOOLEAN
// THROWS      : None
//-------------------------------------------------------------
BOOLEAN SipMediaMgr::CancelDtmf(INT16 index)
{
   SM_CHANNEL_SET_EVENT_PARMS lSe;

   int      lResult = 0;
   TEXT     lLogText[MAX_LOG_TEXT_LEN] = "";
   TEXT     lThisFunction[] = "CancelDtmf";
   
   ChnlLock(index, lThisFunction);
   if(gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_UNAVAILABLE ||
         gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_INITIALIZED)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X\33[3i1m Cancel DTMF Invalid Channel Status",
            gSipCallDtls.sipCallHdls[index].seqNum, gSipCallDtls.sipCallHdls[index].index,
            gSipCallDtls.sipCallHdls[index].handle);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP143, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }

   memset(&lSe, 0, sizeof(lSe));
   lSe.channel      = gSipCallDtls.sipCallHdls[index].channel;
   lSe.event        = mDtmfEvent;
   lSe.event_type   = kSMEventTypeRecog;
   lSe.issue_events = kSMChannelNoEvent;

   lResult = sm_channel_set_event( &lSe );
   if( lResult != 0 )
   {
      snprintf(lLogText,MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Error: Could not associate channel and event DTMF-STOP <%d>", 
            gSipCallDtls.sipCallHdls[index].seqNum, 
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle, 
            lResult );
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n",gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP126, lLogText);
      return false;
   }
   
   ChnlUnlock(index, lThisFunction);

   return true;
}



//-------------------------------------------------------------
// FUNCTION    : CancelGetDtmfDigits
// DESCRIPTION :
// PARAMETER   :
// RETURN      : EnumVoiceProcessErr
// THROWS      : None
//-------------------------------------------------------------
EnumVoiceProcessErr SipMediaMgr::CancelGetDtmfDigits(const MpStop stopMsg)
{
   TEXT           lLogText[MAX_LOG_TEXT_LEN]       = "";
   TEXT           lThisFunction[] = "CancelGetDtmfDigits";
   INT16          index   = stopMsg.circuitId;

   ChnlLock(index, lThisFunction);
   SipCallHandlers *pChnl = &gSipCallDtls.sipCallHdls[index];


   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d Rcvd Cancel Get DtmfDigits",
         stopMsg.seqNum, stopMsg.circuitId, gSipCallDtls.sipCallHdls[stopMsg.circuitId].handle,
         pChnl->chnlStatus);
   ChnlUnlock(index, lThisFunction);
   T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP127, lLogText);
   switch(pChnl->chnlStatus)
   {

      case CKT_GETDIG:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_GETDIGSTP "
                  "Hence issuing cancel Dtmf",
                  stopMsg.seqNum, stopMsg.circuitId, gSipCallDtls.sipCallHdls[stopMsg.circuitId].handle, 
                  pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);

            T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP128, lLogText);

            if(true != CancelDtmf(index))
               return MP_CANCEL_GET_DIG_CMD_ERR;

            ChnlLock(index, lThisFunction);
            memset(&(pChnl->acuCurDtmf.dtmf), 0, sizeof(MpGetDigit));
            pChnl->playStatus      = ACU_PLAY_NEXT_NOT_REQD;

            pChnl->chnlStatus  = CKT_IDLE;
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_GETDIGSTP "
                  "CancelGetDtmfDigits Success",
                  stopMsg.seqNum, stopMsg.circuitId, gSipCallDtls.sipCallHdls[stopMsg.circuitId].handle,
                  pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);

            T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP129, lLogText);
         }
         break;
      case CKT_INITIALIZED:
      case CKT_UNAVAILABLE:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_GETDIGSTP "
                  "Invalid Channel Status",
                  stopMsg.seqNum, stopMsg.circuitId, gSipCallDtls.sipCallHdls[stopMsg.circuitId].handle,
                  pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP130, lLogText);
            return MP_BADPARM_ERR;
         }
      default:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_GETDIGSTP "
                  "Error: Invalid Channel Status",
                  stopMsg.seqNum, stopMsg.circuitId, gSipCallDtls.sipCallHdls[stopMsg.circuitId].handle,
                  pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP130, lLogText);
            return MP_BADPARM_ERR;
         }
   }
   return MP_SUCCESS;
}

//----------------------------------------------------------------------
// METHOD      : StopRecord
// DESCRIPTION : Stops Play and wait for stop completion
// PARAMETER   :
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::StopRecord(INT16 index)
{
   int lResult = 0;
   TEXT lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT lThisFunction[] = "StopRecord";

   ChnlLock(index, lThisFunction);
   if(gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_UNAVAILABLE || 
        gSipCallDtls.sipCallHdls[index].chnlStatus  == CKT_INITIALIZED )
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:[%03d-%02d] Error: CMD:sm_record_wav_close RECORD-STOP failed ChnlStat:CKT_UNAVAILABLE",
            gSipCallDtls.sipCallHdls[index].acuCurRecord.record.seqNum,
            gSipCallDtls.sipCallHdls[index].acuCurRecord.record.circuitId, index);
      TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP132, 2, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }
   lResult = sm_record_file_stop(&gSipCallDtls.sipCallHdls[index].acuCurRecord.rp, 1);
   ChnlUnlock(index, lThisFunction);
   if(lResult != 0)
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:[%03d-%02d] Error: CMD:sm_record_wav_close RECORD-STOP failed <%d>",
            gSipCallDtls.sipCallHdls[index].acuCurRecord.record.seqNum,
            gSipCallDtls.sipCallHdls[index].acuCurRecord.record.circuitId, index, lResult);
      ChnlUnlock(index, lThisFunction);
      TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP132, 2, lLogText);
      return false;
   }

   time_t let = time(0);

   ChnlLock(index, lThisFunction);
   time_t lStart = gSipCallDtls.sipCallHdls[index].acuCurRecord.startRecTime;

   int lRecTime = (let - lStart ) * 1000;

   gSipCallDtls.sipCallHdls[index].acuCurRecord.record.recTime = lRecTime;
   gSipCallDtls.sipCallHdls[index].acuCurRecord.rp.record_parms.max_elapsed_time = lRecTime;
   ChnlUnlock(index, lThisFunction);

   ChnlLock(index, lThisFunction);
   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:[%03d-%02d] CMD:sm_record_wav_close RECORD-STOP Issued",
         gSipCallDtls.sipCallHdls[index].acuCurRecord.record.seqNum,
         gSipCallDtls.sipCallHdls[index].acuCurRecord.record.circuitId, index);
   ChnlUnlock(index, lThisFunction);
   T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP131, lLogText);

   return true;
}


//----------------------------------------------------------------------
// METHOD      : HandleStopRecord
// DESCRIPTION :
// PARAMETER   :
// RETURN      :
//----------------------------------------------------------------------
EnumVoiceProcessErr SipMediaMgr::HandleStopRecord(const MpStop stopMsg)
{
   INT16          index   = -1;
   TEXT           lLogText[MAX_LOG_TEXT_LEN] = "";
   TEXT           lThisFunction[] = "HandleStopRecord";

   index = stopMsg.circuitId;

   ChnlLock(index, lThisFunction);
   SipCallHandlers *pChnl = &gSipCallDtls.sipCallHdls[index];

   snprintf(lLogText, MAX_LOG_TEXT_LEN, "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d Rcvd Record STOP",
         stopMsg.seqNum, stopMsg.circuitId, gSipCallDtls.sipCallHdls[stopMsg.circuitId].handle, pChnl->chnlStatus);
   ChnlUnlock(index, lThisFunction);
   T (gTrace, printf("%s: %s\n", gProcessName, lLogText););

   switch(pChnl->chnlStatus)
   {
      case CKT_RECORDING:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:[%03d-%02d] MC_RECSTP Status:%d"
                  " Hence issuing StopRecord",
                  index, stopMsg.seqNum, stopMsg.circuitId, pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            //AcuMediaUtil::ConvertStatusToStr(pChnl->chnlStatus));
            T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP133, lLogText);

            {
               if(true != StopRecord(index))
                  return MP_RECORD_STOP_CMD_ERR;

               // TBC : komal 
               // Defering the Change of channel status to CKT_IDLE, as this should be done as part of HandleRecordFinish method
               /*
               ChnlLock(index, lThisFunction);
              
               if(pChnl->chnlStatus == CKT_RECORDING)
               {
                  pChnl->chnlStatus       = CKT_IDLE;
                  ChnlUnlock(index, lThisFunction);
               }
               else
               {
                  ChnlUnlock(index, lThisFunction);
               }
               */
               ChnlLock(index, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d RecTime:%d MC_RECSTP "
                     "Stop Record Success",
                     stopMsg.seqNum, stopMsg.circuitId, 
                     gSipCallDtls.sipCallHdls[stopMsg.circuitId].handle, pChnl->chnlStatus,
                     pChnl->acuCurRecord.record.recTime); 
               ChnlUnlock(index, lThisFunction);
               T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP134, lLogText);
            }
         }
         break;
      case CKT_INITIALIZED:
      case CKT_UNAVAILABLE:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:[%03d-%02d] MC_RECSTP Status:%d "
                  "Invalid Channel Status", stopMsg.seqNum, stopMsg.circuitId,
                  index, pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP135, lLogText);
            return MP_BADPARM_ERR;
         }

      default:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:[%03d-%02d] MC_RECSTP Status:%d "
                  "Error: Invalid Channel Status", stopMsg.seqNum, stopMsg.circuitId,
                  index, pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP135, lLogText);
            return MP_BADPARM_ERR;
         }
   }

   return MP_SUCCESS;
}


//----------------------------------------------------------------------
// METHOD      : IssueGetDigitStop
// DESCRIPTION :
// PARAMETER   :
// RETURN      :
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::IssueGetDigitStop()
{
   EnumVoiceProcessErr  lVpErr;
   MpResponseDetails    lAcuRsp;
   TEXT                 lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT                 lThisFunction[] = "IssueGetDigitStop";

   memset(&lAcuRsp, 0, sizeof(lAcuRsp));

   lVpErr = CancelGetDtmfDigits(mMpReq.mpReqData.stopMsg);

   lAcuRsp.cmdType             = MC_GETDIGSTP;
   lAcuRsp.mpRspData.stopMsg   = mMpReq.mpReqData.stopMsg;
   lAcuRsp.voiceProcessErr     = lVpErr;

   if(MP_SUCCESS != lVpErr )
   {
      ChnlLock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Error: CancelGetDtmfDigits Failed",
            mMpReq.mpReqData.stopMsg.seqNum,
            mMpReq.mpReqData.stopMsg.circuitId,
            gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].handle);
      ChnlUnlock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP136, lLogText);

      lAcuRsp.rspMsg              = MP_RSP_FAILURE;

      mSipQueApi.WriteToMediaRspQue(lAcuRsp, mMpReq.mpReqData.stopMsg.circuitId, lLogText);

      return false;
   }
   else
   {
      ChnlLock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X CancelGetDtmfDigits Success",
            mMpReq.mpReqData.stopMsg.seqNum,
            mMpReq.mpReqData.stopMsg.circuitId,
            gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].handle);
      ChnlUnlock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP137, lLogText);

      lAcuRsp.rspMsg              = MP_RSP_SUCCESS;

      mSipQueApi.WriteToMediaRspQue(lAcuRsp, mMpReq.mpReqData.stopMsg.circuitId, lLogText);

      return true;
   }
}


//----------------------------------------------------------------------
// METHOD      : StopPlay
// DESCRIPTION : Stops Play and wait for stop completion
// PARAMETER   :
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::StopPlay(INT16 index)
{
   int lResult = 0;
   TEXT lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT lThisFunction[] = "StopPlay";

   ChnlLock(index, lThisFunction);
   snprintf(lLogText, MAX_LOG_TEXT_LEN, "RefNum:%08X CID:%06d Handle:%08X Idx:%d PlCntlStatus:%d CMD:sm_replay_file_stop Issued",
         gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,  
         gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId,
         gSipCallDtls.sipCallHdls[index].handle, index,
         gSipCallDtls.sipCallHdls[index].playControlStatus);
   ChnlUnlock(index, lThisFunction);
   T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP138, lLogText);


   ChnlLock(index, lThisFunction);
   if(gSipCallDtls.sipCallHdls[index].playControlStatus != CONTROL_USER_ABORT) //check done- required
   {
      if(gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_UNAVAILABLE || 
            gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_INITIALIZED )
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X\33[3i1mPlay Stop Failed",
               mMpReq.mpReqData.stopMsg.seqNum, mMpReq.mpReqData.stopMsg.circuitId, 
               gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].handle);
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP143, lLogText);
         ChnlUnlock(index, lThisFunction);
         return false;
      }
      lResult = sm_replay_file_stop(&gSipCallDtls.sipCallHdls[index].acuCurPlay.fp, 1);  // nowait - enabled
      ChnlUnlock(index, lThisFunction);

      ChnlLock(index, lThisFunction);
      if(NULL != gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd)
      {
         ChnlUnlock(index, lThisFunction);
         ChnlLock(index, lThisFunction);
         if(0 != fclose(gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd))
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                  "RefNum:%08X CID:%06d Handle:%08X Fd:%d Error:%d Cannot close file",
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId, 
                  gSipCallDtls.sipCallHdls[index].handle, 
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd, errno);
            ChnlUnlock(index, lThisFunction);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP194, lLogText);
         }
         else
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                  "RefNum:%08X CID:%06d Handle:%08X Fd:%d File Closed",
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId, 
                  gSipCallDtls.sipCallHdls[index].handle, 
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd);
            ChnlUnlock(index, lThisFunction);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP195, lLogText);
         }
         ChnlLock(index, lThisFunction);
         gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd = NULL;
         ChnlUnlock(index, lThisFunction);
      }
      else
      {
         ChnlUnlock(index, lThisFunction);
      }

      if(lResult != 0)
      {
         ChnlLock(index, lThisFunction);
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X Idx:%d Error: CMD:sm_replay_file_stop PLAY-STOP failed <%d>",
               gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,
               gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId, 
               gSipCallDtls.sipCallHdls[index].handle, index, lResult);
         ChnlUnlock(index, lThisFunction);
         TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP139, lLogText);
         return false;
      }

      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Idx:%d CMD:sm_replay_file_stop PLAY-STOP Success <%d>",
            gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,
            gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId, 
            gSipCallDtls.sipCallHdls[index].handle,index, lResult);
      ChnlUnlock(index, lThisFunction);
      TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP196, lLogText);
   }
   else
   {
      gSipCallDtls.sipCallHdls[index].playControlStatus = CONTROL_SCHDL_STOP;

      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Idx:%d PlayStatus:%d PLAY-STOP Scheduled",
            gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,
            gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId, 
            gSipCallDtls.sipCallHdls[index].handle, index,
            gSipCallDtls.sipCallHdls[index].playControlStatus);
      ChnlUnlock(index, lThisFunction);
      TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP191, lLogText);

      return true;
   }

   return true;
}


//----------------------------------------------------------------------
// METHOD      : HandleStop
// DESCRIPTION :
// PARAMETER   :
// RETURN      :
//----------------------------------------------------------------------
EnumVoiceProcessErr SipMediaMgr::HandleStop(const MpStop stopMsg)
{
   INT16          index   = -1;
   TEXT           lLogText[MAX_LOG_TEXT_LEN] = "";
   TEXT           lThisFunction[] = "HandleStop";

   index = stopMsg.circuitId;

   ChnlLock(index, lThisFunction);
   SipCallHandlers *pChnl = &gSipCallDtls.sipCallHdls[index];

   snprintf(lLogText, MAX_LOG_TEXT_LEN, "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d Rcvd STOP",
         stopMsg.seqNum, stopMsg.circuitId, gSipCallDtls.sipCallHdls[stopMsg.circuitId].handle, pChnl->chnlStatus);
   ChnlUnlock(index, lThisFunction);
   T (gTrace, printf("%s: %s\n", gProcessName, lLogText););

   switch(pChnl->chnlStatus)
   {
      case CKT_PLAYING:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CktId:[%03d-%02d] MC_DISTN Status:%d"
                  " Hence issuing=StopPlay",
                  stopMsg.seqNum, stopMsg.circuitId, index, pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            //AcuMediaUtil::ConvertStatusToStr(pChnl->chnlStatus));
            T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP140, lLogText);

            {
               if(true != StopPlay(index))
                  return MP_PLAY_STOP_CMD_ERR;

               ChnlLock(index, lThisFunction);
               if(pChnl->chnlStatus == CKT_PLAYING)
               {
                  pChnl->chnlStatus       = CKT_IDLE;
                  ChnlUnlock(index, lThisFunction);
               }
               else
               {
                  ChnlUnlock(index, lThisFunction);
               }

               ChnlLock(index, lThisFunction);
               pChnl->playStatus   = ACU_PLAY_NEXT_NOT_REQD;

               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_DISTN"
                     "Stop Play Success",
                     stopMsg.seqNum, stopMsg.circuitId, 
                     gSipCallDtls.sipCallHdls[stopMsg.circuitId].handle, pChnl->chnlStatus); 
               ChnlUnlock(index, lThisFunction);
               T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP141, lLogText);
            }
         }
         break;
      case CKT_INITIALIZED:
      case CKT_UNAVAILABLE:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d MC_DISTN Status:%d "
                  "Invalid Channel Status", stopMsg.seqNum, stopMsg.circuitId,
                  pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP142, lLogText);
            return MP_BADPARM_ERR;
         }

      default:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d MC_DISTN Status:%d "
                  "Error: Invalid Channel Status", stopMsg.seqNum, stopMsg.circuitId,
                  pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP142, lLogText);
            return MP_BADPARM_ERR;
         }
   }

   return MP_SUCCESS;
}


//----------------------------------------------------------------------
// METHOD      : IssuePlayStop
// DESCRIPTION :
// PARAMETER   :
// RETURN      :
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::IssuePlayStop()
{
   EnumVoiceProcessErr  lVpErr;
   MpResponseDetails    lAcuRsp;
   TEXT                 lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT     lThisFunction[] = "IssuePlayStop";

   memset(&lAcuRsp, 0, sizeof(lAcuRsp));

   ChnlLock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
   if(gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].chnlStatus == CKT_UNAVAILABLE || 
         gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].chnlStatus == CKT_INITIALIZED )
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X\33[3i1mPlay Stop Failed",
            mMpReq.mpReqData.stopMsg.seqNum, mMpReq.mpReqData.stopMsg.circuitId, 
            gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].handle);
      ChnlUnlock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP143, lLogText);
      return false;
   }
   ChnlUnlock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
   lVpErr = HandleStop(mMpReq.mpReqData.stopMsg);

   lAcuRsp.cmdType             = MC_DISTN;
   lAcuRsp.mpRspData.stopMsg   = mMpReq.mpReqData.stopMsg;
   lAcuRsp.voiceProcessErr     = lVpErr;

   if (MP_SUCCESS != lVpErr)
   {
      ChnlLock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
      if(gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].chnlStatus == CKT_UNAVAILABLE ||
            gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].chnlStatus == CKT_INITIALIZED)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X\33[3i1mPlay Stop Failed",
               mMpReq.mpReqData.stopMsg.seqNum, mMpReq.mpReqData.stopMsg.circuitId, 
               gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].handle);
         ChnlUnlock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X\33[3i1mError: Play Stop Failed",
               mMpReq.mpReqData.stopMsg.seqNum, mMpReq.mpReqData.stopMsg.circuitId, 
               gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].handle);
         ChnlUnlock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
      }
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP143, lLogText);

      lAcuRsp.rspMsg              = MP_RSP_FAILURE;

      mSipQueApi.WriteToMediaRspQue(lAcuRsp, mMpReq.mpReqData.stopMsg.circuitId, lLogText);

      return false;
   }
   else
   {
      ChnlLock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Play Stop success",
            mMpReq.mpReqData.stopMsg.seqNum, mMpReq.mpReqData.stopMsg.circuitId, 
            gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].handle);
      ChnlUnlock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP141, lLogText);
      lAcuRsp.rspMsg              = MP_RSP_SUCCESS;

      return true;
   }
}

//-------------------------------------------------------------
// FUNCTION    : ListenForDtmf
// DESCRIPTION :
// PARAMETER   :
// RETURN      : BOOLEAN
// THROWS      : None
//-------------------------------------------------------------
BOOLEAN SipMediaMgr::ListenForDtmf(MpGetDigit dtmfMsg)
{
   UINT16 index = dtmfMsg.circuitId;
   INT16 lResult = 0;
   TEXT  lThisFunction[] = "ListenForDtmf";
#if 0
   SM_CHANNEL_SET_EVENT_PARMS lSep;
   TEXT lLogText[MAX_LOG_TEXT_LEN + 1] = "";

   memset(&gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp, 0, sizeof(gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp));

   memset(&lSep, 0, sizeof(lSep));
   lSep.event = mDtmfEvent;
   lSep.issue_events = kSMAnyChannelEvent;
   lSep.event_type = kSMEventTypeRecog;
   lSep.channel = gSipCallDtls.sipCallHdls[index].channel;
   lResult = sm_channel_set_event(&lSep);
   if (lResult != 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Error: CMD: sm_channel_set_event failed DTMF <%d>", 
            dtmfMsg.seqNum, dtmfMsg.circuitId, 
            gSipCallDtls.sipCallHdls[dtmfMsg.circuitId].handle, lResult);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP144, lLogText);

      return false;
   }

   gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.grunt_latency = 1000;
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.enable_grunt_detection = 0;

   /*   if(dtmfMsg.numOfDig > 0)  check
        gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.tone_detection_mode = kSMToneLenDetectionNoMinDuration;
        else
        gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.tone_detection_mode = kSMToneDetectionNoMinDuration;*/
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.tone_detection_mode = kSMToneEndDetectionMinDuration40;
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.map_tones_to_digits = kSMDTMFToneSetDigitMapping;
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.channel = gSipCallDtls.sipCallHdls[index].channel;
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.enable_cptone_recognition = 0;
   //gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.grunt_latency = 3000; check

   lResult = sm_listen_for(&gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp);
   if (lResult != 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Error: CMD:sm_listen_for failed <%d>", 
            dtmfMsg.seqNum, dtmfMsg.circuitId,
            gSipCallDtls.sipCallHdls[dtmfMsg.circuitId].handle, lResult);
      TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP145, lLogText);
      return false;
   }
#endif

   //if(gCancelDtmfTimerTags[index] == 0)
   ChnlLock(index, lThisFunction);
   if(gSipCallDtls.sipCallHdls[index].timerTag == 0)
   {
      ChnlUnlock(index, lThisFunction);
      this->StartDtmfTimer(index, gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.interDigitTimeOut/1000);
   }
   else
   {
      ChnlUnlock(index, lThisFunction);
      this->CancelDtmfTimer(index);
      this->StartDtmfTimer(index, gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.interDigitTimeOut/1000);
   }

   return true;
}

//-------------------------------------------------------------
// FUNCTION    : HandleDtmf
// DESCRIPTION :
// PARAMETER   :
// RETURN      : EnumVoiceProcessErr
// THROWS      : None
//-------------------------------------------------------------
EnumVoiceProcessErr SipMediaMgr::HandleDtmf(const MpGetDigit dtmfMsg)
{
   TEXT     lLogText[MAX_LOG_TEXT_LEN + 1]   = "";
   TEXT     lThisFunction[]                  = "HandleDtmf";
   UINT16   index                            = dtmfMsg.circuitId;

   ChnlLock(index, lThisFunction);
   SipCallHandlers *pChnl = &gSipCallDtls.sipCallHdls[index];

   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d NumDig:%d IntrDgtTOut:%lu TermChar:%s "
         "Rcvd GetDTMF Digits Req",
         dtmfMsg.seqNum,
         dtmfMsg.circuitId, gSipCallDtls.sipCallHdls[dtmfMsg.circuitId].handle, 
         pChnl->chnlStatus, dtmfMsg.numOfDig,
         dtmfMsg.interDigitTimeOut, dtmfMsg.teminateChars);
   ChnlUnlock(index, lThisFunction);
   T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP146, lLogText);

   switch(pChnl->chnlStatus)
   {
      case CKT_IDLE:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_GETDIG Status:"
                  " Setting status to GetDigit", dtmfMsg.seqNum, dtmfMsg.circuitId, 
                  gSipCallDtls.sipCallHdls[dtmfMsg.circuitId].handle, pChnl->chnlStatus );
            T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP147, lLogText);

            pChnl->acuCurDtmf.dtmf = dtmfMsg;
            ChnlUnlock(index, lThisFunction);
            if(true != ListenForDtmf(dtmfMsg))
               return MP_GET_DIG_CMD_ERR;

            ChnlLock(index, lThisFunction);
            pChnl->playStatus      = ACU_PLAY_NEXT_NOT_REQD;
            //pChnl->acuCurDtmf.detectedDigitsLen = 0;      **** check
            //strcpy(pChnl->acuCurDtmf.detectedDigits, "");

            pChnl->chnlStatus          = CKT_GETDIG;

            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_GETDIG "
                  "for DigitsToGet:%d Status: Listen for Success",
                  dtmfMsg.seqNum, dtmfMsg.circuitId, 
                  gSipCallDtls.sipCallHdls[dtmfMsg.circuitId].handle, pChnl->chnlStatus, 
                  dtmfMsg.numOfDig);
            ChnlUnlock(index, lThisFunction);
            T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP148, lLogText);
         }
         break;
      case CKT_INITIALIZED:
      case CKT_UNAVAILABLE:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_GETDIG "
                  "Invalid Channel Status", dtmfMsg.seqNum, dtmfMsg.circuitId, 
                  gSipCallDtls.sipCallHdls[dtmfMsg.circuitId].handle, pChnl->chnlStatus );
            ChnlUnlock(index, lThisFunction);
            TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP149, lLogText);
            return MP_BADPARM_ERR;
         }
      default:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_GETDIG "
                  "Error: Invalid Channel Status", dtmfMsg.seqNum, dtmfMsg.circuitId, 
                  gSipCallDtls.sipCallHdls[dtmfMsg.circuitId].handle, pChnl->chnlStatus );
            ChnlUnlock(index, lThisFunction);
            T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP149, lLogText);
            return MP_CKT_UNAVAILABLE_ERR; 
         }
   }

   return MP_SUCCESS;
}

//-------------------------------------------------------------
// FUNCTION    : StartRecord
// DESCRIPTION :
// PARAMETER   :
// RETURN      : BOOLEAN
// THROWS      : None
//-------------------------------------------------------------
BOOLEAN SipMediaMgr::StartRecord(const MpRecord recMsg)
{
   SM_CHANNEL_SET_EVENT_PARMS   lSep;

   TEXT           lLogText[MAX_LOG_TEXT_LEN + 1]  = "";
   TEXT           lFileName[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT           lThisFunction[] = "StartRecord";
   INT16          lResult = 0;
   UINT16         index = recMsg.circuitId;

   ChnlLock(index, lThisFunction);
   gSipCallDtls.sipCallHdls[index].acuCurRecord.record = recMsg;

   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X RecTime:%lu File:%s Rcvd RECORD Req",
         recMsg.seqNum, recMsg.circuitId, gSipCallDtls.sipCallHdls[recMsg.circuitId].handle, 
         recMsg.recTime, recMsg.voiceFile);
   T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP150, lLogText);

   memset(&gSipCallDtls.sipCallHdls[index].acuCurRecord.rp, 0, sizeof(SM_FILE_RECORD_PARMS));

   gSipCallDtls.sipCallHdls[index].acuCurRecord.rp.record_parms.channel = gSipCallDtls.sipCallHdls[index].channel;
   gSipCallDtls.sipCallHdls[index].acuCurRecord.rp.record_parms.type    = kSMDataFormat16bit;
   gSipCallDtls.sipCallHdls[index].acuCurRecord.rp.record_parms.max_silence = 0; //recMsg.recTime;
   gSipCallDtls.sipCallHdls[index].acuCurRecord.rp.record_parms.max_elapsed_time = recMsg.recTime;
   gSipCallDtls.sipCallHdls[index].acuCurRecord.rp.record_parms.tone_elimination_mode = kSMToneEndDetectionMinDuration40;
   snprintf(lFileName, MAX_LOG_TEXT_LEN, "%s", recMsg.voiceFile);

   if(gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_UNAVAILABLE ||
         gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_INITIALIZED)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X\33[3i1m Start Record Invalid Channel Status",
            gSipCallDtls.sipCallHdls[recMsg.circuitId].seqNum, gSipCallDtls.sipCallHdls[recMsg.circuitId].index,
            gSipCallDtls.sipCallHdls[recMsg.circuitId].handle);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP143, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }
   memset(&lSep, 0, sizeof(lSep));
   lSep.event = mRecEvent;
   lSep.issue_events = kSMAnyChannelEvent;
   lSep.event_type = kSMEventTypeReadData;
   lSep.channel = gSipCallDtls.sipCallHdls[index].channel;
   lResult = sm_channel_set_event(&lSep);
   
   if (lResult != 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Error: CMD:sm_channel_set_event failed REC <%d>",
            recMsg.seqNum, recMsg.circuitId, gSipCallDtls.sipCallHdls[recMsg.circuitId].handle,
            lResult);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n",gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP151, lLogText);
      return false;
   }

   gSipCallDtls.sipCallHdls[index].acuCurRecord.startRecTime = 0;
   gSipCallDtls.sipCallHdls[index].acuCurRecord.startRecTime = time(0);

   lResult = sm_record_wav_start (lFileName, &gSipCallDtls.sipCallHdls[index].acuCurRecord.rp);
   if ( lResult != 0 )
   {
      snprintf(lLogText,MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X File:%s Error: CMD:sm_record_wav_start RECORD-START failed <%d>",
            recMsg.seqNum, recMsg.circuitId, gSipCallDtls.sipCallHdls[recMsg.circuitId].handle,
            recMsg.voiceFile, lResult);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP152, lLogText);
      return false;
   }

   snprintf(lLogText,MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X File:%s CMD: sm_record_wav_start RECORD-START Issued <%d>",
         recMsg.seqNum, recMsg.circuitId, gSipCallDtls.sipCallHdls[recMsg.circuitId].handle,
         recMsg.voiceFile, lResult);
   T(gTrace, printf("%s: %s\n",gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP153, lLogText);

   if(gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_UNAVAILABLE ||
         gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_INITIALIZED)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X\33[3i1m Start Record-DTMF Invalid Channel Status",
            gSipCallDtls.sipCallHdls[recMsg.circuitId].seqNum, gSipCallDtls.sipCallHdls[recMsg.circuitId].index,
            gSipCallDtls.sipCallHdls[recMsg.circuitId].handle);
      ChnlUnlock(index, lThisFunction);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP143, lLogText);
      return false;
   }

   memset(&lSep, 0, sizeof(lSep));
   lSep.event = mDtmfEvent;
   lSep.issue_events = kSMAnyChannelEvent;
   lSep.event_type = kSMEventTypeRecog;
   lSep.channel = gSipCallDtls.sipCallHdls[index].channel;
   lResult = sm_channel_set_event(&lSep);
   if (lResult != 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Error: CMD:sm_channel_set_event RECORD-DTMF failed <%d>",
            recMsg.seqNum, recMsg.circuitId, gSipCallDtls.sipCallHdls[recMsg.circuitId].handle,
            lResult);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP154, lLogText);
      return lResult;
   }

   gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.grunt_latency = 1000;
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.enable_grunt_detection = 0;
   //gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.tone_detection_mode = kSMToneDetectionNoMinDuration; //check
   //gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.tone_detection_mode = kSMToneEndDetectionNoMinDuration; //check
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.tone_detection_mode = kSMToneEndDetectionMinDuration40;
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.map_tones_to_digits = kSMDTMFToneSetDigitMapping;
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.channel = gSipCallDtls.sipCallHdls[index].channel;
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.enable_cptone_recognition = 0;
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.numOfDig = 0;//strlen(playMsg.dtmfStopPlayCharSet);
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.circuitId = gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId;
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.seqNum = gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum;

   lResult = sm_listen_for(&gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp);
   if (lResult != 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Error: CMD:sm_listen_for DTMF-START failed <%d>",
            recMsg.seqNum, recMsg.circuitId, gSipCallDtls.sipCallHdls[recMsg.circuitId].handle,
            lResult);
      ChnlUnlock(index, lThisFunction);
      TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP155, lLogText);
      return false;
   }
   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X CMD:sm_listen_for DTMF-START Success <%d>",
         recMsg.seqNum, recMsg.circuitId, gSipCallDtls.sipCallHdls[recMsg.circuitId].handle,
         lResult);
   ChnlUnlock(index, lThisFunction);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP156, lLogText);

   return true;
}

//-------------------------------------------------------------
// FUNCTION    : HandleStartRecord
// DESCRIPTION :
// PARAMETER   :
// RETURN      : EnumVoiceProcessErr
// THROWS      : None
//-------------------------------------------------------------
EnumVoiceProcessErr SipMediaMgr::HandleStartRecord(const MpRecord recMsg)
{
   INT16          index   = -1;
   TEXT           lLogText[MAX_LOG_TEXT_LEN + 1]      = "";
   TEXT           lThisFunction[] = "HandleStartRecord";

   index = recMsg.circuitId;
   ChnlLock(index, lThisFunction);
   SipCallHandlers *pChnl = &gSipCallDtls.sipCallHdls[index];

   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d RecTime:%lu File:%s Rcvd RECORD Req",
         recMsg.seqNum, recMsg.circuitId, gSipCallDtls.sipCallHdls[recMsg.circuitId].handle, 
         pChnl->chnlStatus, recMsg.recTime, recMsg.voiceFile);
   ChnlUnlock(index, lThisFunction);
   T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP157, lLogText);

   //switch(1)
   switch(pChnl->chnlStatus)
   {
      case CKT_IDLE:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_RECSTR"
                  " Status: Hence issuing StartRecord",
                  recMsg.seqNum, recMsg.circuitId, gSipCallDtls.sipCallHdls[recMsg.circuitId].handle, 
                  pChnl->chnlStatus);
            T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP158, lLogText);
            pChnl->chnlStatus          = CKT_RECORDING;
            ChnlUnlock(index, lThisFunction);
            if(true != StartRecord(recMsg))
               return MP_RECORD_CMD_ERR;

            ChnlLock(index, lThisFunction);
            pChnl->acuCurRecord.record = recMsg;
            pChnl->playStatus      = ACU_PLAY_NEXT_NOT_REQD;

            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_RECSTR Record Success",
                  recMsg.seqNum, recMsg.circuitId, gSipCallDtls.sipCallHdls[recMsg.circuitId].handle, 
                  pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP159, lLogText);
         }
         break;
      case CKT_INITIALIZED:
      case CKT_UNAVAILABLE:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_RECSTR Invalid Channel Status",
                  recMsg.seqNum, recMsg.circuitId, gSipCallDtls.sipCallHdls[recMsg.circuitId].handle,
                  pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP160, lLogText);
            return MP_BADPARM_ERR;
         }

      default:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_RECSTR Status Error: Invalid Channel Status",
                  recMsg.seqNum, recMsg.circuitId, gSipCallDtls.sipCallHdls[recMsg.circuitId].handle,
                  pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP160, lLogText);
            return MP_BADPARM_ERR;
         }
   }

   return MP_SUCCESS;
}
//----------------------------------------------------------------------
// METHOD      : StartPlay
// DESCRIPTION : Initiates play on the specified channel
// PARAMETER   : None
// RETURN      : EnumVoiceProcessErr
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::StartPlay(const MpPlay playMsg)
{
   SM_CHANNEL_SET_EVENT_PARMS    lSep;
   INT16          lResult;
   TEXT           lLogText[MAX_LOG_TEXT_LEN]       = "";
   TEXT           lThisFunction[] = "StartPlay";
   UINT16 index = playMsg.circuitId;

   ChnlLock(index, lThisFunction);
   gSipCallDtls.sipCallHdls[index].acuCurPlay.play = playMsg;
   ChnlUnlock(index, lThisFunction);

   if(playMsg.vFileCount <= 0)
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X MC_CNTTN "
            "Error: PlayFile Failed FileCount Error", playMsg.seqNum, playMsg.circuitId, 
            gSipCallDtls.sipCallHdls[playMsg.circuitId].handle);
      ChnlUnlock(index, lThisFunction);
      gLog.GenerateLog(ACU_SIP161, lLogText);
      TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
      return false;
   }

   if(playMsg.vFileCount > 1)
   {
      ChnlLock(index, lThisFunction);
      gSipCallDtls.sipCallHdls[index].playStatus = ACU_PLAY_MULTIPLE_FILES;
      ChnlUnlock(index, lThisFunction);
   }

   ChnlLock(index, lThisFunction);
   memset(&gSipCallDtls.sipCallHdls[index].acuCurPlay, 0, sizeof(gSipCallDtls.sipCallHdls[index].acuCurPlay));
   memset(&gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp,0,sizeof(gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp));
   memset(&gSipCallDtls.sipCallHdls[index].acuCurPlay.fp, 0, sizeof(SM_FILE_REPLAY_PARMS));
   ChnlUnlock(index, lThisFunction);

   if(!playMsg.voiceFile[0])
   {
      ChnlLock(index, lThisFunction);
      if(NULL != gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd)
      {
         ChnlUnlock(index, lThisFunction);
         ChnlLock(index, lThisFunction);
         if(0 != fclose(gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd))
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                  "RefNum:%08X CID:%06d Handle:%08X Fd:%d Error:%d Cannot close file",
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId, 
                  gSipCallDtls.sipCallHdls[index].handle, 
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd, errno);
            ChnlUnlock(index, lThisFunction);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP194, lLogText);
         }
         else
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                  "RefNum:%08X CID:%06d Handle:%08X File:%s File Closed",
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId, 
                  gSipCallDtls.sipCallHdls[index].handle, 
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd);
            ChnlUnlock(index, lThisFunction);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP195, lLogText);
         }
         ChnlLock(index, lThisFunction);
         gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd = NULL;
         ChnlUnlock(index, lThisFunction);
      }
      else
      {
         ChnlUnlock(index, lThisFunction);
      }
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN, 
            "RefNum:%08X CID:%06d Handle:%08X File:%s Error: %d No File Exists",
            playMsg.seqNum, playMsg.circuitId, gSipCallDtls.sipCallHdls[playMsg.circuitId].handle,
            playMsg.voiceFile[0], errno);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP162, lLogText);
      return false;
   }
   else
   {
      ChnlLock(index, lThisFunction);
      gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd = fopen(playMsg.voiceFile[0], "rb");
      if (NULL == gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN, 
               "RefNum:%08X CID:%06d Handle:%08X File:%s Error:%d Cannot open file",
               playMsg.seqNum, playMsg.circuitId, gSipCallDtls.sipCallHdls[playMsg.circuitId].handle,
               playMsg.voiceFile[0], errno);
         ChnlUnlock(index, lThisFunction);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP163, lLogText);
         return false;
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN, 
               "RefNum:%08X CID:%06d Handle:%08X File:%s Fd:%d File Opened",
               playMsg.seqNum, playMsg.circuitId, gSipCallDtls.sipCallHdls[playMsg.circuitId].handle,
               playMsg.voiceFile[0], gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd);
         ChnlUnlock(index, lThisFunction);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP193, lLogText);
      }
   }

   ChnlLock(index, lThisFunction); 
   if(gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_UNAVAILABLE ||
         gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_INITIALIZED)
   {
      ChnlUnlock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X\33[3i1m Play Start Failed Invalid Channel Status",
            mMpReq.mpReqData.stopMsg.seqNum, mMpReq.mpReqData.stopMsg.circuitId, 
            gSipCallDtls.sipCallHdls[index].handle);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP143, lLogText);
      return false;
   }
   
   memset(&lSep, 0, sizeof(lSep));
   lSep.event = mPlayEvent;
   lSep.issue_events = kSMAnyChannelEvent;
   lSep.event_type = kSMEventTypeWriteData;
   lSep.channel = gSipCallDtls.sipCallHdls[index].channel;
   lResult = sm_channel_set_event(&lSep);
   
   if (lResult != 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Error: CMD:sm_channel_set_event PLAY failed <%d>",
            playMsg.seqNum, playMsg.circuitId, gSipCallDtls.sipCallHdls[playMsg.circuitId].handle,
            lResult);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP167, lLogText);
      return lResult;
   }

   if(gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_UNAVAILABLE || 
         gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_INITIALIZED )
   {
      ChnlUnlock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X\33[3i1m Play Start Failed Invalid Channel Status",
            mMpReq.mpReqData.stopMsg.seqNum, mMpReq.mpReqData.stopMsg.circuitId, 
            gSipCallDtls.sipCallHdls[index].handle);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP143, lLogText);
      return false;
   }
   gSipCallDtls.sipCallHdls[index].acuCurPlay.fileCnt = playMsg.vFileCount;
   gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.replay_parms.channel = gSipCallDtls.sipCallHdls[index].channel;
   gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.replay_parms.type    =  (kSMDataFormat) mDataFormat;

   lResult = sm_replay_file_start (&gSipCallDtls.sipCallHdls[index].acuCurPlay.fp);

   if ( lResult != 0 )
   {
      snprintf(lLogText,MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X File:%s Error: CMD:sm_replay_file_start PLAY-START failed <%d>",
            playMsg.seqNum, playMsg.circuitId, gSipCallDtls.sipCallHdls[playMsg.circuitId].handle, 
            playMsg.voiceFile[0], lResult );
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP165, lLogText);
      return false;
   }

   snprintf(lLogText,MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X File:%s ListeningDtmf:%d CMD:sm_replay_file_start PLAY-START Issued <%d>",
         playMsg.seqNum, playMsg.circuitId, gSipCallDtls.sipCallHdls[playMsg.circuitId].handle, 
         playMsg.voiceFile[0], gSipCallDtls.sipCallHdls[playMsg.circuitId].listenDtmfFlag, lResult);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP166, lLogText);

   //if (true == playMsg.dtmfEnable)
   //{
   //CancelDtmf(index);  //TBC

   if(gSipCallDtls.sipCallHdls[playMsg.circuitId].listenDtmfFlag == false)
   {
      gSipCallDtls.sipCallHdls[playMsg.circuitId].listenDtmfFlag = true;

      memset(&lSep, 0, sizeof(lSep));
      lSep.event = mDtmfEvent;
      lSep.issue_events = kSMAnyChannelEvent;
      lSep.event_type = kSMEventTypeRecog;
      lSep.channel = gSipCallDtls.sipCallHdls[index].channel;
      lResult = sm_channel_set_event(&lSep);
      if (lResult != 0)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X Error: CMD:sm_channel_set_event PLAY-DTMF failed <%d>",
               playMsg.seqNum, playMsg.circuitId, gSipCallDtls.sipCallHdls[playMsg.circuitId].handle,
               lResult);
         ChnlUnlock(index, lThisFunction);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP167, lLogText);
         return lResult;
      }

      gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigitsLen = 0; //verify
      memset(&(gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits), 0, sizeof(MAX_DTMF_RSP_DIGITS));

      gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.grunt_latency = 1000;
      gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.enable_grunt_detection = 0;
      //gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.tone_detection_mode = kSMToneLenDetectionNoMinDuration; //TBC -original
      //gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.tone_detection_mode = kSMToneDetectionNoMinDuration; //TBC -original
      //gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.tone_detection_mode = kSMToneEndDetectionMinDuration64; //working
      //gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.tone_detection_mode = kSMToneEndDetectionNoMinDuration; //check
      gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.tone_detection_mode = kSMToneEndDetectionMinDuration40;  //working
      gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.map_tones_to_digits = kSMDTMFToneSetDigitMapping;
      gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.channel = gSipCallDtls.sipCallHdls[index].channel;
      gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp.enable_cptone_recognition = 0;
      gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.numOfDig = strlen(playMsg.dtmfStopPlayCharSet);
      gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.circuitId = gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId;
      gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.seqNum = gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum;

      lResult = sm_listen_for(&gSipCallDtls.sipCallHdls[index].acuCurDtmf.lp);
      ChnlUnlock(index, lThisFunction);
      if (lResult != 0)
      {
         ChnlLock(index, lThisFunction);
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X Error: CMD:sm_listen_for DTMF-START failed <%d>",
               playMsg.seqNum, playMsg.circuitId, gSipCallDtls.sipCallHdls[playMsg.circuitId].handle, 
               lResult);
         ChnlUnlock(index, lThisFunction);
         TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP168, lLogText);
         return false;
      }
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X CMD:sm_listen_for DTMF-START Success <%d>",
            playMsg.seqNum, playMsg.circuitId, gSipCallDtls.sipCallHdls[playMsg.circuitId].handle, 
            lResult);
      ChnlUnlock(index, lThisFunction);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP169, lLogText);
   }
   else
   {
      gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigitsLen = 0; //verify
      memset(&(gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits), 0, sizeof(MAX_DTMF_RSP_DIGITS));
      ChnlUnlock(index, lThisFunction);
   }
   //}
   //else
   //    CancelDtmf(index); //verify

   return true;
}

//----------------------------------------------------------------------
// METHOD      : HandlePlay
// DESCRIPTION : Initiates play on the specified channel
// PARAMETER   : None
// RETURN      : EnumVoiceProcessErr
//----------------------------------------------------------------------
EnumVoiceProcessErr SipMediaMgr::HandlePlay(const MpPlay playMsg)
{
   INT16          index   = -1;
   TEXT           lLogText[MAX_LOG_TEXT_LEN + 1]      = "";
   TEXT           lPlayCtrlText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT           lThisFunction[] = "HandlePlay";

   index = playMsg.circuitId;
   ChnlLock(index, lThisFunction);
   SipCallHandlers *pChnl = &gSipCallDtls.sipCallHdls[index];

   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d InTPly:%d RptPly:%d FlCnt:%d Tc:%s Rcvd PLAY Req",
         playMsg.seqNum, playMsg.circuitId, gSipCallDtls.sipCallHdls[playMsg.circuitId].handle, 
         pChnl->chnlStatus, playMsg.dtmfEnable, playMsg.repeatPlay,
         playMsg.vFileCount, playMsg.dtmfStopPlayCharSet);
   ChnlUnlock(index, lThisFunction);

   T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
   //for(int idx = 0; idx < playMsg.vFileCount; idx++)
   //printf("File:%d->%s\n", idx+1, playMsg.voiceFile[idx]););
   gLog.GenerateLog(ACU_SIP170, lLogText);

   switch(pChnl->chnlStatus)
   {
      case CKT_IDLE:
         {
            ChnlLock(index, lThisFunction);
            gSipCallDtls.sipCallHdls[playMsg.circuitId].seqNum = playMsg.seqNum;

            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_CNTTN "
                  "So Issuing PlayFile", playMsg.seqNum, playMsg.circuitId, 
                  gSipCallDtls.sipCallHdls[playMsg.circuitId].handle, pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP171, lLogText);

            if(true != StartPlay(playMsg))
               return MP_PLAY_CMD_ERR;

            ChnlLock(index, lThisFunction);
            pChnl->acuCurPlay.play = playMsg;

            if(pChnl->acuCurPlay.play.vFileCount > 1)
            {
               pChnl->playStatus    = ACU_PLAY_MULTIPLE_FILES;
               ChnlUnlock(index, lThisFunction);
            }
            else
            {
               pChnl->playStatus    = ACU_PLAY_NEXT_NOT_REQD;
               ChnlUnlock(index, lThisFunction);
            }

            ChnlLock(index, lThisFunction);
            pChnl->chnlStatus        = CKT_PLAYING;

            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_CNTTN "
                  " PlayFile Success", playMsg.seqNum, playMsg.circuitId, 
                  gSipCallDtls.sipCallHdls[playMsg.circuitId].handle, pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            T (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP172, lLogText);
         }
         break;
      case CKT_INITIALIZED:
      case CKT_UNAVAILABLE:
         {
            ChnlLock(index, lThisFunction);

            //if(gSipCallDtls.sipCallHdls[playMsg.circuitId].playCount == 0)  //mahesh
            // usleep(250000);

            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d PlayCnt:%d MC_CNTTN "
                  "Invalid Channel Status CKT_INIT, CKT_UNAVLBL", playMsg.seqNum, playMsg.circuitId, 
                  gSipCallDtls.sipCallHdls[playMsg.circuitId].handle, pChnl->chnlStatus,
                  gSipCallDtls.sipCallHdls[playMsg.circuitId].playCount);
            ChnlUnlock(index, lThisFunction);
            TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP173, lLogText);
            return MP_BADPARM_ERR;
         }
      default:
         {
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d MC_CNTTN  "
                  "Error: Invalid Channel Status", playMsg.seqNum, playMsg.circuitId, 
                  gSipCallDtls.sipCallHdls[playMsg.circuitId].handle, pChnl->chnlStatus);
            ChnlUnlock(index, lThisFunction);
            TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP173, lLogText);
            return MP_BADPARM_ERR;
         }
   }

   return MP_SUCCESS;
}

//----------------------------------------------------------------------
// METHOD      : ProcessMediaMsg
// DESCRIPTION :
// PARAMETER   : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::ProcessMediaMsg()
{
   EnumVoiceProcessErr  lVpErr;
   MpResponseDetails    lAcuRsp;
   BOOLEAN              lReturn = false;
   TEXT                 lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT                 lThisFunction[] = "ProcessMediaMsg";

   memset(&lAcuRsp, 0, sizeof(lAcuRsp));

   lAcuRsp.mpRspData.dummy.seqNum =  mMpReq.mpReqData.dummy.seqNum;

   switch (mMpReq.cmdType)
   {
      case MC_CNTTN:
         {
            //if(strlen(gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigits))
            if(OUTGOING == gSipCallDtls.sipCallHdls[mMpReq.mpReqData.playMsg.circuitId].callType)
            {
               ChnlLock(mMpReq.mpReqData.playMsg.circuitId, lThisFunction);
               gSipCallDtls.sipCallHdls[mMpReq.mpReqData.playMsg.circuitId].acuCurPlay.play.dtmfEnable = true;
               ChnlUnlock(mMpReq.mpReqData.playMsg.circuitId, lThisFunction);
            }

            lVpErr = HandlePlay(mMpReq.mpReqData.playMsg);
            lAcuRsp.cmdType             = MC_CNTTN;
            lAcuRsp.mpRspData.playMsg   = mMpReq.mpReqData.playMsg;
            lAcuRsp.voiceProcessErr     = lVpErr;

            if (MP_SUCCESS != lVpErr)
            {
               ChnlLock(mMpReq.mpReqData.playMsg.circuitId, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN, "RefNum:%08X CID:%06d Handle:%08X Error: Play Failed",
                     mMpReq.mpReqData.playMsg.seqNum, mMpReq.mpReqData.playMsg.circuitId, 
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.playMsg.circuitId].handle);
               ChnlUnlock(mMpReq.mpReqData.playMsg.circuitId, lThisFunction);
               TERR (gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP174, lLogText);

               lAcuRsp.rspMsg   = MP_RSP_FAILURE;
               lReturn          = false;

               mSipQueApi.WriteToMediaRspQue(lAcuRsp, mMpReq.mpReqData.playMsg.circuitId, lLogText);
            }
            else
            {
               ChnlLock(mMpReq.mpReqData.playMsg.circuitId, lThisFunction);

               gSipCallDtls.sipCallHdls[mMpReq.mpReqData.playMsg.circuitId].playCount++;  //mahesh

               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X Play Success",
                     mMpReq.mpReqData.playMsg.seqNum, mMpReq.mpReqData.playMsg.circuitId,
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.playMsg.circuitId].handle);
               ChnlUnlock(mMpReq.mpReqData.playMsg.circuitId, lThisFunction);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP175, lLogText);

               lAcuRsp.rspMsg = MP_RSP_SUCCESS;
               lReturn        = true;

               if(true == mMpReq.mpReqData.playMsg.nonBlocking)
                  mSipQueApi.WriteToMediaRspQue(lAcuRsp, mMpReq.mpReqData.playMsg.circuitId, lLogText);
            }
         }
         break;
      case MC_RECSTR:
         {
            lVpErr = HandleStartRecord(mMpReq.mpReqData.recordMsg);

            lAcuRsp.cmdType             = MC_RECSTR;
            lAcuRsp.mpRspData.recordMsg = mMpReq.mpReqData.recordMsg;
            lAcuRsp.voiceProcessErr     = lVpErr;

            if(MP_SUCCESS != lVpErr )
            {
               ChnlLock(mMpReq.mpReqData.recordMsg.circuitId, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X Error: StartRecord Failed",
                     mMpReq.mpReqData.recordMsg.seqNum, mMpReq.mpReqData.recordMsg.circuitId,
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.recordMsg.circuitId].handle);
               ChnlUnlock(mMpReq.mpReqData.recordMsg.circuitId, lThisFunction);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP176, lLogText);

               lAcuRsp.rspMsg             = MP_RSP_FAILURE;
               lReturn                    = false;

               mSipQueApi.WriteToMediaRspQue(lAcuRsp, mMpReq.mpReqData.recordMsg.circuitId, lLogText);
            }
            else
            {
               ChnlLock(mMpReq.mpReqData.recordMsg.circuitId, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X RecStartTime:%ld StartRecord Success",
                     mMpReq.mpReqData.recordMsg.seqNum, mMpReq.mpReqData.recordMsg.circuitId,
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.recordMsg.circuitId].handle,
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.recordMsg.circuitId].acuCurRecord.startRecTime);
               ChnlUnlock(mMpReq.mpReqData.recordMsg.circuitId, lThisFunction);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP177, lLogText);

               lAcuRsp.rspMsg             = MP_RSP_SUCCESS;
               lReturn                    = true;
            }
         }
         break;
      case MC_GETDIG:
         {
            MpGetDigit rspDtmf;
            memset(&rspDtmf, 0, sizeof(MpGetDigit));

            //if(strlen(gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].acuCurDtmf.detectedDigits))
            ChnlLock(mMpReq.mpReqData.getDigit.circuitId, lThisFunction);
            if(mMpReq.mpReqData.getDigit.numOfDig == strlen(gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].acuCurDtmf.detectedDigits))
            {
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X NumOfDig:%d DetectedDigits:%d:%s Number of Digits Matching",
                     mMpReq.mpReqData.getDigit.seqNum, 
                     mMpReq.mpReqData.getDigit.circuitId,
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].handle,
                     mMpReq.mpReqData.getDigit.numOfDig,
                     strlen(gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].acuCurDtmf.detectedDigits),
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].acuCurDtmf.detectedDigits);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP179, lLogText); // check change log code

               lAcuRsp.cmdType             = MC_GETDIG;
               lAcuRsp.rspMsg             = MP_RSP_SUCCESS;
               //lAcuRsp.mpRspData.getDigit = gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].acuCurDtmf.detectedDigits;
               strcpy(lAcuRsp.mpRspData.getDigit.rspDigits,
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].acuCurDtmf.detectedDigits);
               lReturn                    = true;
               ChnlUnlock(mMpReq.mpReqData.getDigit.circuitId, lThisFunction);
               mSipQueApi.WriteToMediaRspQue(lAcuRsp, mMpReq.mpReqData.getDigit.circuitId, lLogText);


            }
            else if(mMpReq.mpReqData.getDigit.numOfDig < strlen(gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].acuCurDtmf.detectedDigits))
            {
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X NumOfDig:%d DetectedDigits:%d:%s Got Expected Number of Digits",
                     mMpReq.mpReqData.getDigit.seqNum, 
                     mMpReq.mpReqData.getDigit.circuitId,
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].handle,
                     mMpReq.mpReqData.getDigit.numOfDig,
                     strlen(gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].acuCurDtmf.detectedDigits),
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].acuCurDtmf.detectedDigits);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP192, lLogText); 

               lAcuRsp.cmdType             = MC_GETDIG;
               lAcuRsp.rspMsg             = MP_RSP_SUCCESS;

               strncpy(lAcuRsp.mpRspData.getDigit.rspDigits,
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].acuCurDtmf.detectedDigits, 
                     mMpReq.mpReqData.getDigit.numOfDig);

               lReturn                    = true;
               ChnlUnlock(mMpReq.mpReqData.getDigit.circuitId, lThisFunction);
               mSipQueApi.WriteToMediaRspQue(lAcuRsp, mMpReq.mpReqData.getDigit.circuitId, lLogText);
            }
            else
            {
               ChnlUnlock(mMpReq.mpReqData.getDigit.circuitId, lThisFunction);
               lVpErr = HandleDtmf(mMpReq.mpReqData.getDigit);

               lAcuRsp.cmdType             = MC_GETDIG;
               lAcuRsp.mpRspData.getDigit = mMpReq.mpReqData.getDigit;
               lAcuRsp.voiceProcessErr     = lVpErr;

               if(MP_SUCCESS != lVpErr )
               {
                  ChnlLock(mMpReq.mpReqData.getDigit.circuitId, lThisFunction);
                  if(gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].chnlStatus == CKT_UNAVAILABLE ||
                        gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].chnlStatus == CKT_INITIALIZED)
                  {
                     snprintf(lLogText, MAX_LOG_TEXT_LEN,
                           "RefNum:%08X CID:%06d Handle:%08X GetDtmfDigits Failed",
                           mMpReq.mpReqData.getDigit.seqNum,
                           mMpReq.mpReqData.getDigit.circuitId,
                           gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].handle);
                     ChnlUnlock(mMpReq.mpReqData.getDigit.circuitId, lThisFunction);
                  }
                  else
                  {
                     snprintf(lLogText, MAX_LOG_TEXT_LEN,
                           "RefNum:%08X CID:%06d Handle:%08X Error: GetDtmfDigits Failed",
                           mMpReq.mpReqData.getDigit.seqNum,
                           mMpReq.mpReqData.getDigit.circuitId,
                           gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].handle);
                     ChnlUnlock(mMpReq.mpReqData.getDigit.circuitId, lThisFunction);
                  }
                  T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP178, lLogText);

                  lAcuRsp.rspMsg             = MP_RSP_FAILURE;
                  lReturn                    = false;

                  mSipQueApi.WriteToMediaRspQue(lAcuRsp, mMpReq.mpReqData.getDigit.circuitId, lLogText);
               }
               else
               {
                  ChnlLock(mMpReq.mpReqData.getDigit.circuitId, lThisFunction);
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "RefNum:%08X CID:%06d Handle:%08X GetDtmfDigits Success",
                        mMpReq.mpReqData.getDigit.seqNum,
                        mMpReq.mpReqData.getDigit.circuitId,
                        gSipCallDtls.sipCallHdls[mMpReq.mpReqData.getDigit.circuitId].handle);
                  ChnlUnlock(mMpReq.mpReqData.getDigit.circuitId, lThisFunction);
                  T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP179, lLogText);

                  lAcuRsp.rspMsg             = MP_RSP_SUCCESS;
                  lReturn                    = true;
               }
            }
         }
         break;
      case MC_DISTN:
         {
            IssuePlayStop();
            //IssueGetDigitStop();
         }
         break;

      case MC_RECSTP:
         {
            lVpErr = HandleStopRecord(mMpReq.mpReqData.stopMsg);

            lAcuRsp.cmdType             = MC_RECSTP;
            lAcuRsp.mpRspData.stopMsg = mMpReq.mpReqData.stopMsg;
            lAcuRsp.voiceProcessErr     = lVpErr;

            if(MP_SUCCESS != lVpErr )
            {
               ChnlLock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X Error: Stop Record Failed",
                     mMpReq.mpReqData.stopMsg.seqNum,
                     mMpReq.mpReqData.stopMsg.circuitId,
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].handle);
               ChnlUnlock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP180, lLogText);

               lAcuRsp.rspMsg             = MP_RSP_FAILURE;
               lReturn                    = false;

               mSipQueApi.WriteToMediaRspQue(lAcuRsp, mMpReq.mpReqData.stopMsg.circuitId, lLogText);
            }
            else
            {
               ChnlLock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X RecTime:%d StopRecord Success",
                     mMpReq.mpReqData.stopMsg.seqNum,
                     mMpReq.mpReqData.stopMsg.circuitId,
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].handle,
                     gSipCallDtls.sipCallHdls[mMpReq.mpReqData.stopMsg.circuitId].acuCurRecord.record.recTime);
               ChnlUnlock(mMpReq.mpReqData.stopMsg.circuitId, lThisFunction);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP181, lLogText);

               lAcuRsp.rspMsg             = MP_RSP_SUCCESS;
               lReturn                    = true;
            }
         }
         break;

      case MC_GETDIGSTP:
         {
            IssueGetDigitStop();
         }
         break;

      default:
         {
            lAcuRsp.cmdType            = MC_INVAL_CMD_TYPE;
            lAcuRsp.rspMsg             = MP_RSP_FAILURE;
            lAcuRsp.voiceProcessErr    = MP_INVALID_CMD_ERR;
            lReturn                    = false;
         }
   }

   return lReturn;
}
//----------------------------------------------------------------------
// METHOD NAME : ReadMediaMsg
// DESCRIPTION : Reads Signalling Requests from Application.
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::ReadMediaMsg()
{
   return mSipQueApi.ReadFromMediaReqQue (mMpReq);
}

//-------------------------------------------------------------
// FUNCTION    : CancelDtmfTimer
// DESCRIPTION :
// PARAMETER   :
// RETURN      : BOOLEAN
//-------------------------------------------------------------
BOOLEAN SipMediaMgr::CancelDtmfTimer(UINT32  index)
{
   TEXT     lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT     lThisFunction[] = "CancelDtmfTimer";
   //timerError     lTimerRes=TIMER_SUCCESS;
   MLHtimerError  lMLHTimerErr = MLH_TIMER_FAIL;

   ChnlLock(index, lThisFunction);
   if (gSipCallDtls.sipCallHdls[index].timerTag != 0)
   {
      //lTimerRes = gTimerObj.CancelTimeout(gSipCallDtls.sipCallHdls[index].timerTag);

      lMLHTimerErr = gTimer.CancelTimer(gSipCallDtls.sipCallHdls[index].timerTag);
      ChnlUnlock(index, lThisFunction);
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Index:%d Tag:%d Error: ResponseTimer Tag not set", 
            gSipCallDtls.sipCallHdls[index].seqNum, 
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle, 
            index, gSipCallDtls.sipCallHdls[index].timerTag);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP94, lLogText);

      return false;
   }

   if (lMLHTimerErr != MLH_TIMER_SUCCESS)
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Index:%d Tag:%d Error:%d Failed to CancelDtmfTimer", 
            gSipCallDtls.sipCallHdls[index].seqNum, 
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle, 
            index, gSipCallDtls.sipCallHdls[index].timerTag, lMLHTimerErr);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP94, lLogText);

      return false;
   }

   //gSipCallDtls.sipCallHdls[index].timerFlag = false;
   ChnlLock(index, lThisFunction);
   gSipCallDtls.sipCallHdls[index].timerTag  = 0;

   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X Index:%d Tag:%d Success to cancel ResponseTimer", 
         gSipCallDtls.sipCallHdls[index].seqNum, 
         gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle, 
         index, gSipCallDtls.sipCallHdls[index].timerTag);
   ChnlUnlock(index, lThisFunction);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP94, lLogText);

   return true;
}

//-------------------------------------------------------------
// FUNCTION    : HandleDtmfTimeout
// DESCRIPTION :
// PARAMETER   :
// RETURN      :
//-------------------------------------------------------------
//UINT32 SipMediaMgr::HandleDtmfTimeout(UINT32 index)
UINT32 SipMediaMgr::HandleDtmfTimeout(void* obj, UINT32 index)
{
   MpResponseDetails lAcuRsp;
   TEXT     lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT     lThisFunction[] = "HandleDtmfTimeout";
   memset(&lAcuRsp, 0, sizeof(MpResponseDetails));

   //index = gCancelDtmfTimerTags[index]; //verify

   gSipMediaMgr.ChnlLock(index, lThisFunction);
   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X Index:%d Tag:%d DTMF Timeout",
         gSipCallDtls.sipCallHdls[index].seqNum,
         gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle, 
         index, gSipCallDtls.sipCallHdls[index].timerTag);
   gSipMediaMgr.ChnlUnlock(index, lThisFunction);
   TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP94, lLogText);

   gSipMediaMgr.ChnlLock(index, lThisFunction);
   if (gSipCallDtls.sipCallHdls[index].timerTag != 0)
   {
      gSipMediaMgr.ChnlUnlock(index, lThisFunction);
      gSipMediaMgr.CancelDtmfTimer(index);
   }
   else
   {
      gSipMediaMgr.ChnlUnlock(index, lThisFunction);
   }

   gSipMediaMgr.ChnlLock(index, lThisFunction);
   lAcuRsp.cmdType             = MC_GETDIGSTP;
   lAcuRsp.mpRspData.getDigit  = gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf;
   lAcuRsp.rspMsg              = MP_RSP_FAILURE;
   lAcuRsp.mpRspData.getDigit.numOfDig = gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf.numOfDig;

   gSipCallDtls.sipCallHdls[index].chnlStatus          = CKT_IDLE;
   gSipCallDtls.sipCallHdls[index].acuCurDtmf.detectedDigitsLen = 0;

   //gSipMediaMgr.mSipQueApi.WriteToMediaRspQue(lAcuRsp, lAcuRsp.mpRspData.getDigit.circuitId, lLogText);
   gSipMediaMgr.mSipQueApi.WriteToMediaRspQue(lAcuRsp, gSipCallDtls.sipCallHdls[index].index, lLogText); // keerthini
   memset(&(gSipCallDtls.sipCallHdls[index].acuCurDtmf.dtmf), 0, sizeof(MpGetDigit));
   gSipMediaMgr.ChnlUnlock(index, lThisFunction);

   return index;
}

//-------------------------------------------------------------
// FUNCTION    : StartDtmfTimer
// DESCRIPTION :
// PARAMETER   :
// RETURN      : BOOLEAN
//-------------------------------------------------------------
BOOLEAN SipMediaMgr::StartDtmfTimer(UINT32 index, INT16 timeout)
{
   TEXT     lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT     lThisFunction[] = "StartDtmfTimer";
   //timerError     lTimerRes = TIMER_SUCCESS;
   tag            lResponseTimerTag;
   MLHtimerError  lMLHTimerErr = MLH_TIMER_FAIL;

   //INT32          (*lpFuncPtr)(UINT32);

   //lpFuncPtr = HandleDtmfTimeout;

   /*
      lTimerRes = gTimerObj.SetTimeout(lpFuncPtr,
      index,
      timeout,
      lResponseTimerTag,
      true);
      */

   if( timeout < 2)
      timeout = 2; //TBC to avoid Timer Start fail. 

   lMLHTimerErr = gTimer.SetTimeout(index, lResponseTimerTag, timeout);

   if (lMLHTimerErr != MLH_TIMER_SUCCESS)
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Index:%d TimeOut:%d Failed to StartDtmfTimer Error: %d",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle, 
            index, timeout, lMLHTimerErr);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP94, lLogText);

      lResponseTimerTag = 0;
      return false;
   }
   //gSipCallDtls.sipCallHdls[index].timerFlag = true;
   ChnlLock(index, lThisFunction);
   gSipCallDtls.sipCallHdls[index].timerTag = lResponseTimerTag;

   //gCancelDtmfTimerTags[lResponseTimerTag] = index;

   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X Index:%d TimeOut:%d Tag:%d Success to StartDtmfTimer",
         gSipCallDtls.sipCallHdls[index].seqNum,
         gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle, 
         index, timeout, lResponseTimerTag);
   ChnlUnlock(index, lThisFunction);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP94, lLogText);

   return true;
}

//-------------------------------------------------------------
// FUNCTION    : ChnlLock
// DESCRIPTION : Lock Particular Channel
// PARAMETER   : int
// RETURN      : BOOLEAN
// THROWS      : None
//-------------------------------------------------------------
BOOLEAN SipMediaMgr::ChnlLock(int semNum, TEXT * pCalledFunc)
{
   struct sembuf   lsemLocker[2];
   int             lReturnVal;
   int             lnsops;
   TEXT            lLogText[MAX_LOG_TEXT_LEN + 1] = "";

   lsemLocker[0].sem_num = semNum;
   lsemLocker[0].sem_op  = 0;
   lsemLocker[0].sem_flg = SEM_UNDO;

   lsemLocker[1].sem_num = semNum;
   lsemLocker[1].sem_op  = 1;
   lsemLocker[1].sem_flg = SEM_UNDO | IPC_NOWAIT;

   lnsops = 2;

   lReturnVal = semop(mSemChnlMgmtId, &lsemLocker[0], lnsops);
   if (-1 == lReturnVal)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN, "CKTID:[%03d] SemLock Failed SemId:%d Error:%d ErrStr:%s CalledFunc:%s",
            semNum, mSemChnlMgmtId, errno, strerror(errno), pCalledFunc);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      //gLog.GenerateLog(, lLogText);

      return false;
   }
   /*   snprintf(lLogText, MAX_LOG_TEXT_LEN,
        "RefNum:%08X CID:%06d Handle:%08X Index:%d CalledFunc:%s Success to Lock",
        gSipCallDtls.sipCallHdls[semNum].seqNum,
        gSipCallDtls.sipCallHdls[semNum].index, gSipCallDtls.sipCallHdls[semNum].handle, 
        semNum, pCalledFunc);
        T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   //gLog.GenerateLog(ACU_SIP94, lLogText);
   */
   return true;
}

//-------------------------------------------------------------
// FUNCTION    : ChnlUnlock
// DESCRIPTION : Unlock Particular Channel
// PARAMETER   : int
// RETURN      : BOOLEAN
// THROWS      : None
//-------------------------------------------------------------
BOOLEAN SipMediaMgr::ChnlUnlock(int semNum, TEXT * pCalledFunc)
{
   struct sembuf   lsemLocker[1];
   int             lReturnVal;
   int             lnsops;
   TEXT            lLogText[MAX_LOG_TEXT_LEN +1] = "";

   lsemLocker[0].sem_num = semNum ;
   lsemLocker[0].sem_op  = -1;
   lsemLocker[0].sem_flg = SEM_UNDO | IPC_NOWAIT ;

   lnsops = 1;

   lReturnVal = semop(mSemChnlMgmtId, &lsemLocker[0], lnsops);
   if (-1 == lReturnVal)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN, "CKTID:[%03d] SemUnlock Failed SemId:%d Error:%d ErrStr:%s CalledFunc:%s",
            semNum, mSemChnlMgmtId, errno, strerror(errno), pCalledFunc);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      //gLog.GenerateLog(, lLogText);

      return false;
   }
   /*snprintf(lLogText, MAX_LOG_TEXT_LEN,
     "RefNum:%08X CID:%06d Handle:%08X Index:%d CalledFunc:%s Success to UnLock",
     gSipCallDtls.sipCallHdls[semNum].seqNum,
     gSipCallDtls.sipCallHdls[semNum].index, gSipCallDtls.sipCallHdls[semNum].handle, 
     semNum, pCalledFunc);
     T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
     */
   return true;
}

               
BOOLEAN SipMediaMgr::ReInitialize(int index)
{
   T(gTrace, printf("%s:TBR=============================index : %d\n", gProcessName, index););
   TEXT            lLogText[MAX_LOG_TEXT_LEN +1] = "";
   TEXT     lThisFunction[] = "StartDtmfTimer";
   ACU_ERR lErr;
   CAUSE_XPARMS lCauseXparms;
   //STATE_XPARMS lStateXparms;

   ChnlLock(index, lThisFunction);
   gSipCallDtls.sipCallHdls[index].chnlStatus = CKT_UNAVAILABLE;
   ChnlUnlock(index, lThisFunction);

   INIT_ACU_STRUCT(&lCauseXparms);
   //lCauseXparms.handle = lStateXparms.handle;
   lCauseXparms.handle = gSipCallDtls.sipCallHdls[index].handle;
   if(lCauseXparms.handle !=NULL)
   {

      lErr = call_release(&lCauseXparms);
      if (lErr)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "%s call_release() Returned Error: %s", mLogText, error_2_string(lErr));
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP72, lLogText);
         pthread_mutex_unlock(&gCallInitLock);
         //continue; // TBD  check wat to do
      }
   }
  snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "%s CallType:%d Success to Release Call", mLogText, mDetailXparms.calltype);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP73, 1, lLogText);

   if(true == DeInitializeInCall(index))
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "%s Success to DeInitialize Call", mLogText);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP74, 1, lLogText);

      ChnlLock(index, lThisFunction);
      /* If OUTGOING call then dont initialize call again */
      if(OUTGOING == gSipCallDtls.sipCallHdls[index].callType)
      {
         ChnlUnlock(index, lThisFunction); // check
         //break;  
      }
      else
      {
         ChnlUnlock(index, lThisFunction);
      }
     if(OUTGOING != gSipCallDtls.sipCallHdls[index].callType)
     {
      if(true != InitializeInCall(index))
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "%s Error: Failed to Initialize Call", mLogText);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP76, lLogText);
      }
      else
      {
         //ChnlLock(index, lThisFunction);
        // snprintf(mLogText, MAX_LOG_TEXT_LEN, "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X VmpRx:%012X Channel:%lu",
          //     gSipCallDtls.sipCallHdls[index].seqNum,
            //   index, handle,
            //   vmp_tx, vmp_rx,channel);
         //ChnlUnlock(index, lThisFunction);
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "%s Success to Initialize Call", mLogText);
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP77, 1, lLogText);
      }
   }
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "%s Failed to DeInitialize Call", mLogText);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP75, lLogText);
   }
}
