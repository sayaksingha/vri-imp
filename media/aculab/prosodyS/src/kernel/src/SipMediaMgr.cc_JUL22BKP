#include "SipMediaMgr.h"
#define RTP_EVENT 101

ACU_PORT_ID          gSipPortId;
ACU_CARD_ID          gCardId;
tSMModuleId          gModuleId;
SipCallDetails       gSipCallDtls;
SipHandleApi         gSipHandleApi;
SipChannel           gSipChannel;
SipChannelApi        gSipChannelApi;
pthread_mutex_t      gCallInitLock;
pthread_mutex_t      gOutMsgCounterLock;

extern SipMediaMgr    gSipMediaMgr;

int gProsodyOpened;

//acuStatus  gAcuChannel[20000];
MLHTimer   gTimer;

//----------------------------------------------------------------------
// METHOD NAME : SipMediaMgr
// DESCRIPTION : Constructor
// PARAMETERS  : None
// RETURN      : None
//----------------------------------------------------------------------
SipMediaMgr::SipMediaMgr()
{
   mOutCalls = 0;
   memset(&gSipCallDtls, 0, sizeof(SipCallDetails));

}

//----------------------------------------------------------------------
// METHOD NAME : ~SipMediaMgr
// DESCRIPTION : Destructor
// PARAMETERS  : None
// RETURN      : None
//----------------------------------------------------------------------
SipMediaMgr::~SipMediaMgr()
{
   this->DeInit();
}

//----------------------------------------------------------------------
// METHOD NAME : DeInit
// DESCRIPTION : DeInit
// PARAMETERS  : None 
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::DeInit()
{
   ACU_ERR lErr;
   TEXT  lLogText[TSS_MAX_LOG_TEXT_LEN + 1] = "";

   //DeInitilize all open calls ...
   for(int index = 1; index <= mSipLicenseIncoming ; index++)
   {
      this->DeInitializeInCall(index); 
      CAUSE_XPARMS cause_xparms;
      INIT_ACU_STRUCT(&cause_xparms);
      cause_xparms.handle = gSipCallDtls.sipCallHdls[index].handle;
      lErr= call_release(&cause_xparms);
      if (lErr)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "Failed to Release Call...Handle:%08X Error(%d):%s", 
               cause_xparms.handle, lErr, error_2_string(lErr));
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP61, lLogText);
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "Success to Release Call...Handle:%08X", cause_xparms.handle);
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP17, 2, lLogText);
      }
   }

   //TBC===ADDED to deinitialize the call for outgoing calls when process is going down.
   for(int index = mSipLicenseIncoming+1; index <=  (mSipLicenseIncoming+mSipLicenseOutgoing) ; index++)
   {
      if ( gSipCallDtls.sipCallHdls[index].chnlStatus != CKT_UNAVAILABLE)
      {
         this->DeInitializeInCall(index); 
         CAUSE_XPARMS cause_xparms;
         INIT_ACU_STRUCT(&cause_xparms);
         cause_xparms.handle = gSipCallDtls.sipCallHdls[index].handle;
         lErr= call_release(&cause_xparms);
         if (lErr)
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "Failed to Release Call...Handle:%08X Error(%d):%s", 
                  cause_xparms.handle, lErr, error_2_string(lErr));
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP61, lLogText);
         }
         else
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "Success to Release Call...Handle:%08X", cause_xparms.handle);
            T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP17, 2, lLogText);
         }
      }
   }

   //Close sip signalling port
   if (gSipPortId)
   {
      CLOSE_PORT_PARMS lClosePortParms;

      INIT_ACU_STRUCT(&lClosePortParms);
      lClosePortParms.port_id = gSipPortId;
      lErr = call_close_port(&lClosePortParms);
      if (lErr)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "Failed to Close Call Port Error is %d-%s", lErr, error_2_string(lErr));
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP16, lLogText);
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "Success to Close Call Port RetVal:%d", lErr);
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP17, 2, lLogText);
      }
   }

   //Close Prosody module that was opened
   if (gModuleId)
   {
      SM_CLOSE_MODULE_PARMS lCloseModuleParms;

      memset(&lCloseModuleParms, 0, sizeof(lCloseModuleParms));
      lCloseModuleParms.module_id = gModuleId;
      lErr = sm_close_module(&lCloseModuleParms);
      if (lErr)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "Failed to Close Module Error is %d", lErr);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP18, lLogText);
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "Success to Close Module RetVal:%d", lErr);
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP19, 2, lLogText);
      }
   }

   //Detach from the Prosody driver
   if (gCardId)
   {
      ACU_CLOSE_CARD_PARMS lCloseCardParms;

      if (gProsodyOpened)
      {
         ACU_CLOSE_PROSODY_PARMS lCloseProsodyParms;
         INIT_ACU_STRUCT(&lCloseProsodyParms);
         lCloseProsodyParms.card_id = gCardId;
         lErr = acu_close_prosody(&lCloseProsodyParms);
         if (lErr)
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "Failed to Close Prosody Error is %d", lErr);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP20, lLogText);
         }
         else
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "Success to Close Prosody RetVal:%d", lErr);
            T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP21, 2, lLogText);
         }
      }

      INIT_ACU_STRUCT(&lCloseCardParms);
      lCloseCardParms.card_id = gCardId;
      lErr = acu_close_card(&lCloseCardParms);
      if (lErr)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "Failed to Close Card Error is %d", lErr);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP22, lLogText);
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "Success to Close Card RetVal:%d", lErr);
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP23, 2, lLogText);
      }
   }

   return true;
}

//----------------------------------------------------------------------
// METHOD NAME : Init
// DESCRIPTION : Initialize all the private variables and
//               objects used by the Subscription Handler.
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::Init()
{
   TEXT   lLogText[TSS_MAX_LOG_TEXT_LEN + 1] = "";
   INT32  lCount   = 0;

   if(true != gSipHandleApi.Init())
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN, "Sip Handle Hash Init failed");
      TERR(gTrace, printf("%s: %s. Exiting...\n", gProcessName, lLogText););
      gLog.GenerateLog(GSYS04, lLogText);
      return false;
   }

   if(true != gSipChannelApi.Init())
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN, "Sip Channel Hash Init failed");
      TERR(gTrace, printf("%s: %s. Exiting...\n", gProcessName, lLogText););
      gLog.GenerateLog(GSYS04, lLogText);
      return false;
   }

   if(true != this->ReadConfig())
   {
      sprintf(lLogText, "Read Config Failed");
      TERR(gTrace, printf("%s: %s. Exiting.....\n", gProcessName, lLogText););
      gLog.GenerateLog(GSYS04, lLogText);
      return false;
   }

   if(true != mSipQueApi.Init())
   {
      sprintf(lLogText, "Sip Que Api init failed");
      TERR(gTrace, printf("%s: %s. Exiting.....\n", gProcessName, lLogText););
      gLog.GenerateLog(GSYS04, lLogText);
      return false;
   }

   //Added to Clear Queue Before startup
   GenIsupMsg  lRxIsupMsg;
   while( true == mSipQueApi.ReadFromSipReqQue(lRxIsupMsg, 0, NON_BLOCKING))
   {
      sprintf(lLogText, "CID:%06d Msg:%d "
            "Signalling message read and Dropped during process initialization",
            lRxIsupMsg.circuitId,
            lRxIsupMsg.isupMsgType);
      T (gTrace, printf ("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog (ACU_SIP197, 1, lLogText);
   }

   MpRequestDetails lMpReq;
   while( true == mSipQueApi.ReadFromMediaReqQue (lMpReq, 0, NON_BLOCKING))
   {

      INT16 index, seqnum;
      switch(lMpReq.cmdType)
      {
         case MC_CNTTN:
            index = lMpReq.mpReqData.playMsg.circuitId;
            seqnum = lMpReq.mpReqData.playMsg.seqNum;
            break;
         case MC_GETDIG:
            index = lMpReq.mpReqData.getDigit.circuitId;
            seqnum = lMpReq.mpReqData.getDigit.seqNum;
            break;
         case MC_RECSTR:
            index = lMpReq.mpReqData.recordMsg.circuitId;
            seqnum = lMpReq.mpReqData.recordMsg.seqNum;
            break;
         case MC_DISTN:
         case MC_GETDIGSTP:
         case MC_RECSTP:
            index = lMpReq.mpReqData.stopMsg.circuitId;
            seqnum = lMpReq.mpReqData.stopMsg.seqNum;
            break;
      }

      sprintf(lLogText, "CID:%d RefNum:%08X Cmd:%d"
            " Media Message read and Dropped during process initialization",
            index, seqnum, lMpReq.cmdType);
      T (gTrace, printf ("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog (ACU_SIP198, 2, lLogText);
   }

   mSemChnlMgmtId = semget(mChnlStSemKey, (mSipLicenseIncoming + mSipLicenseOutgoing + 1), IPC_PERM|IPC_CREAT);
   snprintf (lLogText,MAX_LOG_TEXT_LEN, "SemChnlMgmtKey:%u nsems:%u",
         mChnlStSemKey, 2000);
   if (-1 == mSemChnlMgmtId)
   {
      TERR (gTrace, printf("%s: %s Semaphore Creation  Failed Err:%d ErrStr:%s\n",
               gProcessName, lLogText, errno, strerror(errno)););
      return false;
   }
   T (gTrace, printf("%s: %s SemId:%d Semaphore Creation Success.\n",
            gProcessName, lLogText, mSemChnlMgmtId););

   /* Initializes prosodyS card */
   if (true != InitializeCard())
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN, "Card Initialisation failed");
      TERR(gTrace, printf("%s: %s. Exiting...\n", gProcessName, lLogText););
      gLog.GenerateLog(GSYS04, lLogText);
      return false;
   }

   /* Creates Play, record and Dtmf prosody events */
   if (true != CreateProsodyEvents())
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN, "Create Prosody Events failed");
      TERR(gTrace, printf("%s: %s. Exiting...\n", gProcessName, lLogText););
      gLog.GenerateLog(GSYS04, lLogText);
      return false;
   }

   /* Start Media Thread */
   if (true != CreateMediaControlThread())
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN, "Create Media Control Thread failed");
      TERR(gTrace, printf("%s: %s. Exiting...\n", gProcessName, lLogText););
      gLog.GenerateLog(GSYS04, lLogText);
      return false;
   }

   /* Init MLH Timer Required for DTMF timeout detection */
   if(MLH_TIMER_SUCCESS != gTimer.InitTimeoutTable(mTimerSize, mTimerSemKey, 
            mTimerHashShmKey, mTimerHashSemKey, mTimerBfrShmKey, mTimerBfrSemKey, 
            mTimerTimeOutQueKey, mTimerTimeOutQueLimit, mRetryTimerRandomTimeOut, 
            SipMediaMgr::HandleDtmfTimeout, (void*)this))
   {
      TERR(gTrace, printf("%s: Failed To Initialise Multi Level Hash Timer Exiting...\n", gProcessName););
      gLog.GenerateLog(GSYS04, lLogText);
      return false;
   }



   return true;
}

//----------------------------------------------------------------------
// METHOD NAME : ReadConfig
// DESCRIPTION : Reads the Configuration from files.
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::ReadConfig()
{
   CfgRead lCfgRead (gProcessName);
   TEXT  lLogText[MAX_LOG_TEXT_LEN + 1] = "";

   if (lCfgRead.CfgInit (SIP_SYS_CFG) != true)
   {
      TERR (gTrace, printf ("%s: Could not open file %s\n",
               gProcessName, SIP_SYS_CFG););
      gLog.GenerateLog (GSYS09, SIP_SYS_CFG);
      return false;
   }

   if (lCfgRead.GetConfigNum ("SIP_LICENSE_INCOMING", mSipLicenseIncoming,
            SIP_MIN_LICENSE,
            SIP_MAX_LICENSE) != CFG_OK)
   {
      TERR (gTrace, printf ("%s: Config read failed for SIP_LICENSE_INCOMING. File:%s\n",
               gProcessName, SIP_SYS_CFG););
      return false;
   }
   T (gTrace, printf ("%s: SIP_LICENSE_INCOMING = %d\n",
            gProcessName, mSipLicenseIncoming););

   if (lCfgRead.GetConfigNum ("SIP_LICENSE_OUTGOING", mSipLicenseOutgoing,
            SIP_MIN_LICENSE,
            SIP_MAX_LICENSE) != CFG_OK)
   {
      TERR (gTrace, printf ("%s: Config read failed for SIP_LICENSE_OUTGOING. File:%s\n",
               gProcessName, SIP_SYS_CFG););
      return false;
   }
   T (gTrace, printf ("%s: SIP_LICENSE_OUTGOING = %d\n",
            gProcessName, mSipLicenseOutgoing););

   if(lCfgRead.GetConfigNum("MEDIA_FILE_FORMAT", mDataFormat,
            kSMDataFormatNone, kSMDataFormatSpeex) != CFG_OK )
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN, "Error in Reading Parameter %s : %s",
            "MEDIA_FILE_FORMAT",  SIP_SYS_CFG);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(GSYS11, lLogText);
      lCfgRead.CfgDeInit();
      return false;
   }
   else
      T(gTrace, printf("%s: MEDIA_FILE_FORMAT = %d\n", gProcessName, mDataFormat););

   if (lCfgRead.GetConfigStr ("SIP_ORIG_IP", mOrigDomain,
            SIP_MIN_IP_LEN,
            SIP_MAX_IP_LEN) != CFG_OK)
   {
      TERR (gTrace, printf ("%s: Config read failed for SIP_ORIG_IP. File:%s\n",
               gProcessName, SIP_SYS_CFG););
      lCfgRead.CfgDeInit();
      return false;
   }
   T (gTrace, printf ("%s: SIP_ORIG_IP = %s\n",
            gProcessName, mOrigDomain););

   /* Destination IP, used for placing OUTGOING calls */
   if (lCfgRead.GetConfigStr ("SIP_DEST_IP", mDestDomain,
            SIP_MIN_IP_LEN,
            SIP_MAX_IP_LEN) != CFG_OK)
   {
      TERR (gTrace, printf ("%s: Config read failed for SIP_DEST_IP. File:%s\n",
               gProcessName, SIP_SYS_CFG););
      lCfgRead.CfgDeInit();
      return false;
   }
   T (gTrace, printf ("%s: SIP_DEST_IP = %s\n",
            gProcessName, mDestDomain););

   if (CFG_OK != lCfgRead.GetConfigNum("TING_TRACE", mTingTrace,
            TING_TRACE_MIN, TING_TRACE_MAX))
   {
      mTingTrace = TiNGtrace = 1;
   }
   else
   {
      TiNGtrace = mTingTrace;
   }
   T(gTrace, printf("%s: TING_TRACE = %d\n", gProcessName, mTingTrace););

   if (lCfgRead.GetConfigNum ("SIP_TIMER_TABLE_SIZE", mTimerSize,
            SIP_MIN_TIMER_TABLE_SIZE,
            SIP_MAX_TIMER_TABLE_SIZE) != CFG_OK)
   {
      TERR (gTrace, printf ("%s: Config read failed for SIP_TIMER_TABLE_SIZE. File:%s\n",
               gProcessName, SIP_SYS_CFG););
      lCfgRead.CfgDeInit();
      return false;
   }
   T (gTrace, printf ("%s: SIP_TIMER_TABLE_SIZE = %d\n", gProcessName, mTimerSize););

   if (lCfgRead.GetConfigNum ("SIP_TIMEOUT_Q_LIMIT", mTimerTimeOutQueLimit,
            1, 10000) != CFG_OK)
   {
      TERR (gTrace, printf ("%s: Config read failed for SIP_TIMEOUT_Q_LIMIT. File:%s\n",
               gProcessName, SIP_SYS_CFG););
      lCfgRead.CfgDeInit();
      return false;
   }
   T (gTrace, printf ("%s: SIP_TIMEOUT_Q_LIMIT = %d\n", gProcessName, mTimerTimeOutQueLimit););

   if (lCfgRead.GetConfigNum ("SIP_TIMER_RANDOM_TIMEOUT", mRetryTimerRandomTimeOut,
            5, 3600) != CFG_OK)
   {
      TERR (gTrace, printf ("%s: Config read failed for SIP_TIMER_RANDOM_TIMEOUT. File:%s\n",
               gProcessName, SIP_SYS_CFG););
      lCfgRead.CfgDeInit();
      return false;
   }
   T (gTrace, printf ("%s: SIP_TIMER_RANDOM_TIMEOUT = %d\n", gProcessName, mRetryTimerRandomTimeOut););

   lCfgRead.CfgDeInit();

   if (lCfgRead.CfgInit (SIP_IPC_CFG) != true)
   {
      TERR (gTrace, printf ("%s: Could not open file %s\n",
               gProcessName, SIP_IPC_CFG););
      gLog.GenerateLog (GSYS09, SIP_IPC_CFG);
      return false;
   }

   if (CFG_OK != lCfgRead.GetConfigNum ("SIP_TIMER_SEM_KEY",
            mTimerSemKey, TSS_MIN_IPC, TSS_MAX_IPC))
   {
      TERR (gTrace, printf ("%s: Config read failed for SIP_TIMER_SEM_KEY. File:%s\n",
               gProcessName, SIP_IPC_CFG););
      lCfgRead.CfgDeInit ();
      return false;
   }
   else
      T (gTrace, printf ("%s: SIP_TIMER_SEM_KEY = %d\n", gProcessName, mTimerSemKey););

   if (CFG_OK != lCfgRead.GetConfigNum ("SIP_TIMER_HASH_SHM_KEY",
            mTimerHashShmKey, TSS_MIN_IPC, TSS_MAX_IPC))
   {
      TERR (gTrace, printf ("%s: Config read failed for SIP_TIMER_HASH_SHM_KEY. File:%s\n",
               gProcessName, SIP_IPC_CFG););
      lCfgRead.CfgDeInit ();
      return false;
   }
   else
      T (gTrace, printf ("%s: SIP_TIMER_HASH_SHM_KEY = %d\n", gProcessName, mTimerHashShmKey););

   if (CFG_OK != lCfgRead.GetConfigNum ("SIP_TIMER_HASH_SEM_KEY",
            mTimerHashSemKey, TSS_MIN_IPC, TSS_MAX_IPC))
   {
      TERR (gTrace, printf ("%s: Config read failed for SIP_TIMER_HASH_SEM_KEY. File:%s\n",
               gProcessName, SIP_IPC_CFG););
      lCfgRead.CfgDeInit ();
      return false;
   }
   else
      T (gTrace, printf ("%s: SIP_TIMER_HASH_SEM_KEY = %d\n", gProcessName, mTimerHashSemKey););

   if (CFG_OK != lCfgRead.GetConfigNum ("SIP_BFR_SHM_KEY",
            mTimerBfrShmKey, TSS_MIN_IPC, TSS_MAX_IPC))
   {
      TERR (gTrace, printf ("%s: Config read failed for SIP_BFR_SHM_KEY. File:%s\n",
               gProcessName, SIP_IPC_CFG););
      lCfgRead.CfgDeInit ();
      return false;
   }
   else
      T (gTrace, printf ("%s: SIP_BFR_SHM_KEY = %d\n", gProcessName, mTimerBfrShmKey););

   if (CFG_OK != lCfgRead.GetConfigNum ("SIP_BFR_SEM_KEY",
            mTimerBfrSemKey, TSS_MIN_IPC, TSS_MAX_IPC))
   {
      TERR (gTrace, printf ("%s: Config read failed for SIP_BFR_SEM_KEY. File:%s\n",
               gProcessName, SIP_IPC_CFG););
      lCfgRead.CfgDeInit ();
      return false;
   }
   else
      T (gTrace, printf ("%s: SIP_BFR_SEM_KEY = %d\n", gProcessName, mTimerBfrSemKey););

   if (CFG_OK != lCfgRead.GetConfigNum ("SIP_TIMER_Q_KEY",
            mTimerTimeOutQueKey, TSS_MIN_IPC, TSS_MAX_IPC))
   {
      TERR (gTrace, printf ("%s: Config read failed for SIP_TIMER_Q_KEY. File:%s\n",
               gProcessName, SIP_IPC_CFG););
      lCfgRead.CfgDeInit ();
      return false;
   }
   else
      T (gTrace, printf ("%s: SIP_TIMER_Q_KEY = %d\n", gProcessName, mTimerTimeOutQueKey););


   if(CFG_OK != ( lCfgRead.GetConfigNum("SIP_CHNL_STATUS_SEM_KEY",
               mChnlStSemKey,
               1000,
               9999)))
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,  "Error in Reading Parameter %s : in %s",
            "SIP_CHNL_STATUS_SEM_KEY", SIP_IPC_CFG);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(GSYS11, lLogText);
      lCfgRead.CfgDeInit();
      return false;
   }
   else
   {
      T(gTrace, printf("%s: SIP_CHNL_STATUS_SEM_KEY = %d\n", gProcessName, mChnlStSemKey););
   }


   lCfgRead.CfgDeInit ();

   return true;
}

//----------------------------------------------------------------------
// METHOD NAME : ReloadConfig
// DESCRIPTION : Reloads the Configuration.
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::ReloadConfig()
{
   CfgRead lCfgRead (gProcessName);
   TEXT  lLogText[MAX_LOG_TEXT_LEN + 1] = "";

   if (lCfgRead.CfgInit (SIP_SYS_CFG) != true)
   {
      TERR (gTrace, printf ("%s: Could not open file %s\n",
               gProcessName, SIP_SYS_CFG););
      gLog.GenerateLog (GSYS09, SIP_SYS_CFG);
      return false;
   }

   if (CFG_OK != lCfgRead.GetConfigNum("TING_TRACE", mTingTrace,
            TING_TRACE_MIN, TING_TRACE_MAX))
   {
      mTingTrace = TiNGtrace = 1;
   }
   else
   {
      TiNGtrace = mTingTrace;
   }
   T(gTrace, printf("%s: TING_TRACE = %d\n", gProcessName, mTingTrace););

   lCfgRead.CfgDeInit();

   return true;
}

//----------------------------------------------------------------------
// METHOD NAME : InitializeInCall
// DESCRIPTION : Initializes SIP incoming call
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::InitializeInCall(INT16 index)
{
   IN_XPARMS   in_xparms;
   ACU_ERR     lErr;

   SM_VMPRX_CREATE_PARMS vmprx_create_parms;
   SM_VMPTX_CREATE_PARMS vmptx_create_parms;

   SM_CHANNEL_ALLOC_PLACED_PARMS channel_alloc_parms;
   SM_CHANNEL_DATAFEED_PARMS channel_df_parms; 
   SM_VMPTX_DATAFEED_CONNECT_PARMS df_connect_parms;      
   SM_VMPRX_DATAFEED_PARMS vmprx_datafeed_parms;
   SM_CHANNEL_DATAFEED_CONNECT_PARMS channel_datafeed_connect_parms;

   TEXT     lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT     lThisFunction[] = "InitializeInCall";
   UINT16   lAcuIndex = 0;

   INIT_ACU_STRUCT(&in_xparms);
   in_xparms.net = gSipPortId;
   in_xparms.ts = -1;           // Should not specify timeslot 

   //check
   // Populate codecs we support
   in_xparms.unique_xparms.sig_iptel.codecs[0].codec_type = G711_ALAW;
   in_xparms.unique_xparms.sig_iptel.codecs[1].codec_type = G711_ULAW;

   // We will create vmps when we know what call type is to be used ( IPv4 or IPv6 )
   in_xparms.unique_xparms.sig_iptel.vmprxid = (ACU_POINTER)ACU_WILL_PROVIDE_VMP;
   in_xparms.unique_xparms.sig_iptel.vmptxid = (ACU_POINTER)ACU_WILL_PROVIDE_VMP;


   lErr = call_openin(&in_xparms);

   ChnlLock(index, lThisFunction);
   if (lErr)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Err:%d Error: Unable to SIP call_openin()",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle, lErr);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP24, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false; //check
   }

   /* Init SipHdlr structure */
   memset(&gSipCallDtls.sipCallHdls[index], 0, sizeof(SipCallHandlers));

   gSipCallDtls.sipCallHdls[index].index = index;
   gSipCallDtls.sipCallHdls[index].handle = in_xparms.handle;
   gSipCallDtls.sipCallHdls[index].callState = CALL_NONE;
   //gSipCallDtls.sipCallHdls[index].chnlStatus = CKT_IDLE;
   gSipCallDtls.sipCallHdls[index].chnlStatus = CKT_INITIALIZED;
   gSipCallDtls.sipCallHdls[index].callType = INCOMING;


   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X Success to Open SIP call_openin()", 
         gSipCallDtls.sipCallHdls[index].seqNum,
         gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP25, 2, lLogText);

   gSipCallDtls.sipCallHdls[index].channel = NULL;
   gSipCallDtls.sipCallHdls[index].vmp_rx = NULL;
   gSipCallDtls.sipCallHdls[index].vmp_tx = NULL;


   /*  new VMP[rx] to receive incoming RTP data */
   memset(&vmprx_create_parms, 0, sizeof(vmprx_create_parms));
   vmprx_create_parms.module = gModuleId;

   //check
   vmprx_create_parms.address.s_addr = inet_addr(mOrigDomain);
   vmprx_create_parms.type = kSMVMPrxTypeIPv4;


   lErr = sm_vmprx_create(&vmprx_create_parms);

   if (lErr == 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpRx:%012X Success to Create RX Voip Media Processor", 
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            (long unsigned int)vmprx_create_parms.vmprx);
      gSipCallDtls.sipCallHdls[index].vmp_rx = vmprx_create_parms.vmprx;
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP26, 2, lLogText);
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpRx:%012X Err:%d Error: To Create RX Voip Media Processor", 
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            (long unsigned int)vmprx_create_parms.vmprx, lErr);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP27, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }

   /* new VMP[tx] to transmit RTP data to a remote device */
   memset(&vmptx_create_parms, 0, sizeof(vmptx_create_parms));
   vmptx_create_parms.module = gModuleId;

   lErr = sm_vmptx_create(&vmptx_create_parms);

   if (lErr == 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X Success to Create TX Voip Media Processor", 
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            vmptx_create_parms.vmptx);
      gSipCallDtls.sipCallHdls[index].vmp_tx = vmptx_create_parms.vmptx;
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP28, 2, lLogText);
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X Err:%d Error: To Create TX Voip Media Processor",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            vmptx_create_parms.vmptx, lErr);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP29, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }


   /* new channel to generate output data and/or process input data */
   memset(&channel_alloc_parms, 0, sizeof(channel_alloc_parms));
   channel_alloc_parms.module = gModuleId;
   channel_alloc_parms.type = kSMChannelTypeFullDuplex;  //Input, Output, HalfDuplex and FullDuplex available

   lErr = sm_channel_alloc_placed(&channel_alloc_parms);

   if (lErr)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Chnl:%lu Error: To Allocate Channel",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            channel_alloc_parms.channel);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP30, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Chnl:%lu Success to Allocate Channel",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            channel_alloc_parms.channel);
      gSipCallDtls.sipCallHdls[index].vmp_tx = vmptx_create_parms.vmptx;
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP31, 2, lLogText);

      gSipCallDtls.sipCallHdls[index].channel = channel_alloc_parms.channel;
#if 0
      printf("\n\n TBR 1 gSipCallDtls.sipCallHdls[index].channel = channel_alloc_parms.channel\n\n");
      /* Converts a channel identifier to a integer index unique to that channel.
       * Only on Prosody version 2 (TiNG): The index returned is in the range 0 <= index < (256*32) 
       * and is unique only between channels on the same card. Note that this function is provided solely 
       * to implement backward compatibility with the pre-V6 API, 
       * and will be removed when pre-V6 backward compatibility support is withdrawn. */
      lAcuIndex = sm_get_channel_ix(gSipCallDtls.sipCallHdls[index].channel);
      printf("\n\n TBR 2 gSipCallDtls.sipCallHdls[index].channel = channel_alloc_parms.channel :%d\n\n", lAcuIndex);

      if(lAcuIndex < 0)
      {
         printf("\n\n TBR 3 gSipCallDtls.sipCallHdls[index].channel = channel_alloc_parms.channel\n\n");
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X Index:%d Error to Get Channel Index", 
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,lAcuIndex);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP89, lLogText);
         return lAcuIndex;
      }
      gAcuChannel[lAcuIndex].index = index;
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Index:%d Success to Get Channel Index",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            lAcuIndex);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP91, 2, lLogText);
#endif
      sprintf(gSipChannel.key, "%lu", channel_alloc_parms.channel);
      gSipChannel.index = index;
      gSipChannel.channel = channel_alloc_parms.channel;

      /* Insert Channel Details Into Hash Table. Handle used as key */
      if(true != gSipChannelApi.InsertRequestIntoHash(gSipChannel))
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X Key:%s Error: To Insert Channel Details Into Hash", 
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipChannel.index, 
               gSipCallDtls.sipCallHdls[index].handle, gSipChannel.key);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP59, lLogText);
         ChnlUnlock(index, lThisFunction);
         return false;
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X Key:%s Success to Insert Channel Details Into Hash",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipChannel.index, 
               gSipCallDtls.sipCallHdls[index].handle, gSipChannel.key);
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP60, 2, lLogText);
      }

      //ChnlUnlock(index, lThisFunction);
   }   

   memset(&channel_df_parms, 0, sizeof(channel_df_parms));

   /* Request a datafeed identifier from an output channel */
   channel_df_parms.channel =  gSipCallDtls.sipCallHdls[index].channel;
   lErr = sm_channel_get_datafeed(&channel_df_parms);

   if (lErr)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X DataFeed:%lu Error: to Get Channel Datafeed",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            channel_df_parms.datafeed);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP32, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X DataFeed:%lu Success to Get Channel Datafeed",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            channel_df_parms.datafeed);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP33, 2, lLogText);

      /* Connects a datafeed to a VMP[tx] */
      memset(&df_connect_parms, 0, sizeof(df_connect_parms));

      df_connect_parms.data_source = channel_df_parms.datafeed;
      df_connect_parms.vmptx = gSipCallDtls.sipCallHdls[index].vmp_tx;
      lErr = sm_vmptx_datafeed_connect(&df_connect_parms);

      if (lErr)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X  DataFeed:%lu VmpTx:%012X Error: to Connect TX Voip Media Process Datafeed",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
               channel_df_parms.datafeed, df_connect_parms.vmptx);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP34, lLogText);
         ChnlUnlock(index, lThisFunction);
         return false;
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X DataFeed:%lu VmpTx:%012X Success to Connect TX Voip Media Process Datafeed",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
               channel_df_parms.datafeed, df_connect_parms.vmptx);
         gSipCallDtls.sipCallHdls[index].vmp_tx = vmptx_create_parms.vmptx;
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP35, 2, lLogText);
      }
   }

   /* Request a datafeed identifier from a VMP[rx]. */
   memset(&vmprx_datafeed_parms, 0, sizeof(vmprx_datafeed_parms));
   vmprx_datafeed_parms.vmprx = gSipCallDtls.sipCallHdls[index].vmp_rx;;

   lErr = sm_vmprx_get_datafeed(&vmprx_datafeed_parms);
   if (lErr)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X DataFeed:%lu VmpRx:%012X Error: To Get RX Voip Media Process Datafeed",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            vmprx_datafeed_parms.datafeed, vmprx_datafeed_parms.vmprx);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP36, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X DataFeed:%lu VmpRx:%012X Success to Get RX Voip Media Process Datafeed",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            vmprx_datafeed_parms.datafeed, vmprx_datafeed_parms.vmprx);
      gSipCallDtls.sipCallHdls[index].vmp_tx = vmptx_create_parms.vmptx;
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP37, 2, lLogText);

      /* Connect a datafeed to an input channel. */
      memset(&channel_datafeed_connect_parms, 0, sizeof(channel_datafeed_connect_parms));

      channel_datafeed_connect_parms.data_source = vmprx_datafeed_parms.datafeed;
      channel_datafeed_connect_parms.channel = gSipCallDtls.sipCallHdls[index].channel;

      lErr = sm_channel_datafeed_connect(&channel_datafeed_connect_parms);
      if (lErr)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X DataFeed:%lu VmpRx:%012X Error: To Connect Channel Datafeed",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
               vmprx_datafeed_parms.datafeed, vmprx_datafeed_parms.vmprx);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP38, lLogText);
         ChnlUnlock(index, lThisFunction);
         return false;
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X(%lu) DataFeed:%lu VmpRx:%012X Success to Connect Channel Datafeed",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
               gSipCallDtls.sipCallHdls[index].handle,
               vmprx_datafeed_parms.datafeed, vmprx_datafeed_parms.vmprx);
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP39, 2, lLogText);
      }

      sprintf(gSipCallDtls.sipCallHdls[index].key, "%lu", gSipCallDtls.sipCallHdls[index].handle);

      /* Insert Call Details Into Hash Table. Handle used as key */
      if(true != gSipHandleApi.InsertRequestIntoHash(gSipCallDtls.sipCallHdls[index]))
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X Key:%s Error: To Insert Call Details Into Hash", 
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, 
               gSipCallDtls.sipCallHdls[index].handle, gSipCallDtls.sipCallHdls[index].key);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP59, lLogText);
         ChnlUnlock(index, lThisFunction);
         return false;
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X Key:%s Success to Insert Call Details Into Hash",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, 
               gSipCallDtls.sipCallHdls[index].handle, gSipCallDtls.sipCallHdls[index].key);
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP60, 2, lLogText);
      }

      ChnlUnlock(index, lThisFunction);

      return true;
   }
}

//----------------------------------------------------------------------
// METHOD NAME : InitiateAculabInviteMsg
// DESCRIPTION : Initializes SIP outgoing call/INVITE
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::InitiateAculabInviteMsg(GenIsupMsg & lTxIsupMsg )
{
   SM_VMPRX_CREATE_PARMS vmprx_create_parms;
   SM_VMPTX_CREATE_PARMS vmptx_create_parms;
   SM_CHANNEL_ALLOC_PLACED_PARMS channel_alloc_parms;
   SM_CHANNEL_DATAFEED_PARMS channel_df_parms; 
   SM_VMPTX_DATAFEED_CONNECT_PARMS df_connect_parms;      
   SM_VMPRX_DATAFEED_PARMS vmprx_datafeed_parms;
   SM_CHANNEL_DATAFEED_CONNECT_PARMS channel_datafeed_connect_parms;
   OUT_XPARMS  out_xparms;

   ACU_ERR  lErr;

   TEXT     lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT     lThisFunction[] = "InitiateAculabInviteMsg";
   UINT16   lAcuIndex = 0;
   UINT16   index = lTxIsupMsg.circuitId;

   ChnlLock(index, lThisFunction);
   /* Check whether outgoing call is miss placed on Incoming channel */
   if(gSipCallDtls.sipCallHdls[index].callType == INCOMING )
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X ChnlType:INCOMING Error: Call Rcvd on Unauthorised Channel", 
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP27, lLogText);

      lTxIsupMsg.isupMsgType  = GEN_ISUP_REL;

      ChnlUnlock(index, lThisFunction);
      return mSipQueApi.WriteToSipRspQue (lTxIsupMsg, mLogText);
   }

   memset(&gSipCallDtls.sipCallHdls[index], 0, sizeof(SipCallHandlers));

   gSipCallDtls.sipCallHdls[index].channel = NULL;
   gSipCallDtls.sipCallHdls[index].vmp_rx = NULL;
   gSipCallDtls.sipCallHdls[index].vmp_tx = NULL;

   /*  new VMP[rx] to receive incoming RTP data */
   memset(&vmprx_create_parms, 0, sizeof(vmprx_create_parms));
   vmprx_create_parms.module = gModuleId;

   lErr = sm_vmprx_create(&vmprx_create_parms);

   if (lErr == 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpRx:%012X Success to Create RX Voip Media Processor", 
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            vmprx_create_parms.vmprx);
      gSipCallDtls.sipCallHdls[index].vmp_rx = vmprx_create_parms.vmprx;
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP26, 2, lLogText);
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpRx:%012X Err:%d Error: To Create RX Voip Media Processor", 
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            vmprx_create_parms.vmprx, lErr);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP27, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }

   /* new VMP[tx] to transmit RTP data to a remote device */
   memset(&vmptx_create_parms, 0, sizeof(vmptx_create_parms));
   vmptx_create_parms.module = gModuleId;

   lErr = sm_vmptx_create(&vmptx_create_parms);

   if (lErr == 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X Success to Create TX Voip Media Processor", 
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            vmptx_create_parms.vmptx);
      gSipCallDtls.sipCallHdls[index].vmp_tx = vmptx_create_parms.vmptx;
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP28, 2, lLogText);
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X Err:%d Error: To Create TX Voip Media Processor",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            vmptx_create_parms.vmptx, lErr);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP29, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }

   /* new channel to generate output data and/or process input data */
   memset(&channel_alloc_parms, 0, sizeof(channel_alloc_parms));
   channel_alloc_parms.module = gModuleId;
   channel_alloc_parms.type = kSMChannelTypeFullDuplex;

   lErr = sm_channel_alloc_placed(&channel_alloc_parms);

   if (lErr)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Chnl:%lu Error: To Allocate Channel",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            channel_alloc_parms.channel);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP30, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Chnl:%lu Success to Allocate Channel",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            channel_alloc_parms.channel);
      gSipCallDtls.sipCallHdls[index].vmp_tx = vmptx_create_parms.vmptx;
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP31, 2, lLogText);

      gSipCallDtls.sipCallHdls[index].channel = channel_alloc_parms.channel;

      SipChannel     lSipChannel;
      sprintf(lSipChannel.key, "%lu", channel_alloc_parms.channel);
      lSipChannel.index = index;
      lSipChannel.channel = channel_alloc_parms.channel;

      /* Insert Channel Details Into Hash Table. Handle used as key */
      if(true != gSipChannelApi.InsertRequestIntoHash(lSipChannel))
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X Key:%s Error: To Insert Channel Details Into Hash", 
               gSipCallDtls.sipCallHdls[index].seqNum,
               lSipChannel.index, 
               gSipCallDtls.sipCallHdls[index].handle, lSipChannel.key);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP59, lLogText);
         ChnlUnlock(index, lThisFunction);
         return false;
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X Key:%s Success to Insert Channel Details Into Hash",
               gSipCallDtls.sipCallHdls[index].seqNum,
               lSipChannel.index, 
               gSipCallDtls.sipCallHdls[index].handle, lSipChannel.key);
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP60, 2, lLogText);
      }
      /* Convert a channel identifier to a integer index unique to that channel */
      lAcuIndex = sm_get_channel_ix(gSipCallDtls.sipCallHdls[index].channel);

      if(lAcuIndex < 0)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X Index:%d Error: To Get Channel Index", 
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,lAcuIndex);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP89, lLogText);
         ChnlUnlock(index, lThisFunction);
         return lAcuIndex;
      }
      //gAcuChannel[lAcuIndex].index = index;
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Index:%d Success to Get Channel Index",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            lAcuIndex);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP91, 2, lLogText);
   }   

   /* Request a datafeed identifier from an output channel */
   memset(&channel_df_parms, 0, sizeof(channel_df_parms));

   channel_df_parms.channel =  gSipCallDtls.sipCallHdls[index].channel;
   lErr = sm_channel_get_datafeed(&channel_df_parms);

   if (lErr)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X DataFeed:%lu Error: To Get Channel Datafeed",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            channel_df_parms.datafeed);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP32, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X DataFeed:%lu Success to Get Channel Datafeed",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            channel_df_parms.datafeed);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP33, 2, lLogText);

      /* connect the channel's datafeed from the VMP[tx] */
      memset(&df_connect_parms, 0, sizeof(df_connect_parms));

      df_connect_parms.data_source = channel_df_parms.datafeed;
      df_connect_parms.vmptx = gSipCallDtls.sipCallHdls[index].vmp_tx;
      lErr = sm_vmptx_datafeed_connect(&df_connect_parms);

      if (lErr)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X  DataFeed:%lu VmpTx:%012X Error: To Connect TX Voip Media Process Datafeed",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
               channel_df_parms.datafeed, df_connect_parms.vmptx);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP34, lLogText);
         ChnlUnlock(index, lThisFunction);
         return false;
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X DataFeed:%lu VmpTx:%012X Success to Connect TX Voip Media Process Datafeed",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
               channel_df_parms.datafeed, df_connect_parms.vmptx);
         gSipCallDtls.sipCallHdls[index].vmp_tx = vmptx_create_parms.vmptx;
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP35, 2, lLogText);
      }
   }

   /* Request a datafeed identifier from a VMP[rx]. */
   memset(&vmprx_datafeed_parms, 0, sizeof(vmprx_datafeed_parms));
   vmprx_datafeed_parms.vmprx = gSipCallDtls.sipCallHdls[index].vmp_rx;;

   lErr = sm_vmprx_get_datafeed(&vmprx_datafeed_parms);
   if (lErr)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X DataFeed:%lu VmpRx:%012X Error: To Get RX Voip Media Process Datafeed",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            vmprx_datafeed_parms.datafeed, vmprx_datafeed_parms.vmprx);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP36, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X DataFeed:%lu VmpRx:%012X Success to Get RX Voip Media Process Datafeed",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            vmprx_datafeed_parms.datafeed, vmprx_datafeed_parms.vmprx);
      gSipCallDtls.sipCallHdls[index].vmp_tx = vmptx_create_parms.vmptx;
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP37, 2, lLogText);

      /* Connect a datafeed to an input channel. */
      memset(&channel_datafeed_connect_parms, 0, sizeof(channel_datafeed_connect_parms));

      channel_datafeed_connect_parms.data_source = vmprx_datafeed_parms.datafeed;
      channel_datafeed_connect_parms.channel = gSipCallDtls.sipCallHdls[index].channel;

      lErr = sm_channel_datafeed_connect(&channel_datafeed_connect_parms);
      if (lErr)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X DataFeed:%lu VmpRx:%012X Error: To Connect Channel Datafeed",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
               vmprx_datafeed_parms.datafeed, vmprx_datafeed_parms.vmprx);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP38, lLogText);
         ChnlUnlock(index, lThisFunction);
         return false;
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X DataFeed:%lu VmpRx:%012X Success to Connect Channel Datafeed",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
               vmprx_datafeed_parms.datafeed, vmprx_datafeed_parms.vmprx);
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP39, 2, lLogText);
      }

   }

   INIT_ACU_STRUCT(&out_xparms);
   out_xparms.net = gSipPortId;
   out_xparms.ts = -1;
   out_xparms.cnf = CNF_REM_DISC;   //flag which allows the remote disconnect event to be generated
   EncodeAddress(lTxIsupMsg.circuitId, lTxIsupMsg.isupIam.callingNumber, gSipCallDtls.sipCallHdls[index].origAddr, true);
   EncodeAddress(lTxIsupMsg.circuitId, lTxIsupMsg.isupIam.calledNumber, gSipCallDtls.sipCallHdls[index].destAddr, false);
   //EncodeAddress(lTxIsupMsg.circuitId, lTxIsupMsg.isupIam.callingNumber, out_xparms.originating_addr, true);
   //EncodeAddress(lTxIsupMsg.circuitId, lTxIsupMsg.isupIam.calledNumber, out_xparms.destination_addr, false);

   //printf("TBR===========OA:%s  DA:%s Index:%d handle:%lu\n",  gSipCallDtls.sipCallHdls[index].origAddr, gSipCallDtls.sipCallHdls[index].destAddr, index, gSipCallDtls.sipCallHdls[index].handle);

   strcpy(out_xparms.originating_addr, gSipCallDtls.sipCallHdls[index].origAddr);
   strcpy(out_xparms.destination_addr, gSipCallDtls.sipCallHdls[index].destAddr);

   out_xparms.unique_xparms.sig_iptel.vmprxid = TiNG_TO_ACU_POINTER(gSipCallDtls.sipCallHdls[index].vmp_rx);
   out_xparms.unique_xparms.sig_iptel.vmptxid = TiNG_TO_ACU_POINTER(gSipCallDtls.sipCallHdls[index].vmp_tx);

   /* Open OUTGOING Call*/
   lErr = call_openout(&out_xparms);

   gSipCallDtls.sipCallHdls[index].index = index;
   gSipCallDtls.sipCallHdls[index].handle = out_xparms.handle;
   gSipCallDtls.sipCallHdls[index].callState = CALL_NONE;
   gSipCallDtls.sipCallHdls[index].chnlStatus = CKT_IDLE;
   gSipCallDtls.sipCallHdls[index].callType = OUTGOING;

   if (lErr)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Err:%d(%s) Error: To SIP call_openout()",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle, lErr,
            error_2_string(lErr));
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP95, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }

   pthread_mutex_lock(&gOutMsgCounterLock);
   mOutCalls++;
   pthread_mutex_unlock(&gOutMsgCounterLock);

   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X Success to Open SIP call_openout()", 
         gSipCallDtls.sipCallHdls[index].seqNum,
         gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP25, 2, lLogText);

   sprintf(gSipCallDtls.sipCallHdls[index].key, "%lu", gSipCallDtls.sipCallHdls[index].handle);

   /* Insert Call Details Into Hash Table. Handle used as key */
   if(true != gSipHandleApi.InsertRequestIntoHash(gSipCallDtls.sipCallHdls[index]))
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Key:%s Error: To Insert Call Details Into Hash", 
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, 
            gSipCallDtls.sipCallHdls[index].handle, gSipCallDtls.sipCallHdls[index].key);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP59, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Key:%s Success to Insert Call Details Into Hash",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, 
            gSipCallDtls.sipCallHdls[index].handle, gSipCallDtls.sipCallHdls[index].key);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP60, 2, lLogText);
   }

   ChnlUnlock(index, lThisFunction);

   return true;
}

//----------------------------------------------------------------------
// METHOD NAME : DeInitializeInCall
// DESCRIPTION : Initializes SIP incoming call
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::DeInitializeInCall(INT16 index)
{
   SM_VMPTX_DATAFEED_CONNECT_PARMS df_connect_parms;
   SM_CHANNEL_DATAFEED_CONNECT_PARMS channel_datafeed_connect_parms;
   SM_VMPRX_STOP_PARMS vmprx_stop_parms;
   SM_VMPTX_STOP_PARMS vmptx_stop_parms;
   SM_VMPRX_EVENT_PARMS vmprx_event_parms;
   SM_VMPRX_STATUS_PARMS vmprx_status_parms;
   SM_VMPTX_EVENT_PARMS vmptx_event_parms;
   SM_VMPTX_STATUS_PARMS vmptx_status_parms;

   ACU_ERR lErr;

   TEXT  lLogText[MAX_LOG_TEXT_LEN + 1] = "";
   TEXT     lThisFunction[] = "DeInitializeInCall";
   
   SipChannel      lSipChannel;
   ChnlLock(index, lThisFunction);
   sprintf(lSipChannel.key, "%lu", gSipCallDtls.sipCallHdls[index].channel);
   ChnlUnlock(index, lThisFunction);
   //gSipChannel.index = index;
   //gSipChannel.channel = gSipCallDtls.sipCallHdls[index].channel;
   if(lSipChannel.key !=NULL)
   {

      if(true != gSipChannelApi.DeleteRequestFromHash(lSipChannel.key))
      {
         ChnlLock(index, lThisFunction);
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X Key:%s Error: To Delete Channel Details From Hash", 
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, 
               gSipCallDtls.sipCallHdls[index].handle, lSipChannel.key);
         ChnlUnlock(index, lThisFunction);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP59, lLogText);
         //return false; ????
      }
   }
   else
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Key:%s Success to Delete Channel Details from Hash",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, 
            gSipCallDtls.sipCallHdls[index].handle, lSipChannel.key);
      ChnlUnlock(index, lThisFunction);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP60, 2, lLogText);
   } 

   // if(gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_PLAYING)
   //    StopPlay(index);

   ChnlLock(index, lThisFunction);
   gSipCallDtls.sipCallHdls[index].chnlStatus = CKT_UNAVAILABLE; //TBC
   ChnlUnlock(index, lThisFunction);

   /* Disconnect the channel's datafeed from the VMP[tx] */
   memset(&channel_datafeed_connect_parms, 0, sizeof(channel_datafeed_connect_parms));
   channel_datafeed_connect_parms.data_source = kSMNullDatafeedId;
   channel_datafeed_connect_parms.channel = gSipCallDtls.sipCallHdls[index].channel;
   lErr = sm_channel_datafeed_connect(&channel_datafeed_connect_parms);

   if (lErr)
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Chnl:%lu Error: To Disconnect Channel Datafeed",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            channel_datafeed_connect_parms.channel);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP40, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }
   else
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Chnl:%lu Success to Disconnect Channel Datafeed",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            channel_datafeed_connect_parms.channel);
      ChnlUnlock(index, lThisFunction);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP41, 2, lLogText);
   }

   /* Disconnect the channel's datafeed from the VMP[tx] */
   memset(&df_connect_parms, 0, sizeof(df_connect_parms));
   df_connect_parms.data_source = kSMNullDatafeedId;
   df_connect_parms.vmptx = gSipCallDtls.sipCallHdls[index].vmp_tx;
   lErr = sm_vmptx_datafeed_connect(&df_connect_parms);
   if (lErr)
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X Error: To Disconnect VMPTX Datafeed",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            df_connect_parms.vmptx);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP42, lLogText);
      return false;
   }
   else
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X Success to Disconnect VMPTX Datafeed",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            df_connect_parms.vmptx);
      ChnlUnlock(index, lThisFunction);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP43, 2, lLogText);
   }

   /* Destroy the channel */
   lErr = sm_channel_release(gSipCallDtls.sipCallHdls[index].channel);
   if (lErr)
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Chnl:%lu Error to Release Channel",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            gSipCallDtls.sipCallHdls[index].channel);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP44, lLogText);  //check no return
   }
   else
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Chnl:%lu Success to Release Channel",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            gSipCallDtls.sipCallHdls[index].channel);
      ChnlUnlock(index, lThisFunction);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP45, 2, lLogText);
   }

   /* Stop the VMP[rx] */
   memset(&vmprx_stop_parms, 0, sizeof(vmprx_stop_parms));
   ChnlLock(index, lThisFunction);
   vmprx_stop_parms.vmprx = gSipCallDtls.sipCallHdls[index].vmp_rx;
   ChnlUnlock(index, lThisFunction);
   lErr = sm_vmprx_stop(&vmprx_stop_parms);
   if (lErr)
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpRx:%012X Error to Stop VMPRX",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            vmprx_stop_parms.vmprx);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP46, lLogText);
   }
   else
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpRx:%012X Success to Stop VMPRX",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            vmprx_stop_parms.vmprx);
      ChnlUnlock(index, lThisFunction);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP47, 2, lLogText);

      /* Get the VMP[rx]'s event */
      memset(&vmprx_event_parms, 0, sizeof(vmprx_event_parms));
      ChnlLock(index, lThisFunction);
      vmprx_event_parms.vmprx = gSipCallDtls.sipCallHdls[index].vmp_rx;
      ChnlUnlock(index, lThisFunction);
      lErr = sm_vmprx_get_event(&vmprx_event_parms);
      if (lErr)
      {
         ChnlLock(index, lThisFunction);
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X VmpRx:%012X Error to Get VMPRX Event",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
               vmprx_event_parms.vmprx);
         ChnlUnlock(index, lThisFunction);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP48, lLogText);
      }
      else
      {
         /* Wait for the stop event */
         memset(&vmprx_status_parms, 0, sizeof(vmprx_status_parms));
         ChnlLock(index, lThisFunction);
         vmprx_status_parms.vmprx = gSipCallDtls.sipCallHdls[index].vmp_rx;
         ChnlUnlock(index, lThisFunction);
         do
         {
            smd_ev_wait(vmprx_event_parms.event);
            lErr = sm_vmprx_status(&vmprx_status_parms);
            if (lErr)
            {
               ChnlLock(index, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X VmpRx:%012X Err:%d Error to get VMPRX status", 
                     gSipCallDtls.sipCallHdls[index].seqNum,
                     gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
                     vmprx_status_parms.vmprx, lErr);
               ChnlUnlock(index, lThisFunction);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP49, 1, lLogText);
               break;
            }
            else
            {
               ChnlLock(index, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X VmpRx:%012X status:%d Received VMPRX Status", 
                     gSipCallDtls.sipCallHdls[index].seqNum,
                     gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
                     vmprx_status_parms.vmprx, vmprx_status_parms.status);
               ChnlUnlock(index, lThisFunction);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               //gLog.GenerateLog(ACU_SIP49, 1, lLogText);
            }
         } while (vmprx_status_parms.status != kSMVMPrxStatusStopped);

         // Change channel status
         //gSipCallDtls.sipCallHdls[index].chnlStatus = CKT_IDLE;

         //T(gTrace, printf("%s: %s chnlStatus:%d\n", gProcessName, lLogText, 
         //       gSipCallDtls.sipCallHdls[index].chnlStatus););
      }
   }


   ChnlLock(index, lThisFunction);
   if(gSipCallDtls.sipCallHdls[index].vmp_rx)
   {
      ChnlUnlock(index, lThisFunction);
      /* Destroy the VMP[rx] */
      ChnlLock(index, lThisFunction);
      lErr = sm_vmprx_destroy(gSipCallDtls.sipCallHdls[index].vmp_rx);
      if (lErr)
      {
         ChnlUnlock(index, lThisFunction);
         ChnlLock(index, lThisFunction);
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X VmpRx:%012X Error to Get VMPRX Destroy",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
               gSipCallDtls.sipCallHdls[index].vmp_rx);
         ChnlUnlock(index, lThisFunction);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP50, lLogText);
      }
      else
      {
         ChnlUnlock(index, lThisFunction);
         ChnlLock(index, lThisFunction);
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X VmpRx:%012X Success to Get VMPRX Destroy",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
               gSipCallDtls.sipCallHdls[index].vmp_rx);
         ChnlUnlock(index, lThisFunction);
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP51, 1, lLogText);
      }
   }
   else
   {
      ChnlUnlock(index, lThisFunction);
      T(gTrace, printf("%s: NULL VMP rx received\n", gProcessName););
   }

   /* Stop the VMP[tx] */
   memset(&vmptx_stop_parms, 0, sizeof(vmptx_stop_parms));
   ChnlLock(index, lThisFunction);
   vmptx_stop_parms.vmptx = gSipCallDtls.sipCallHdls[index].vmp_tx;
   ChnlUnlock(index, lThisFunction);
   lErr = sm_vmptx_stop(&vmptx_stop_parms);
   if (lErr)
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X Error to Get VMPTX Stop",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
            vmptx_stop_parms.vmptx);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP52, lLogText);
   }
   else
   {
      /* Get the VMP[tx]'s event */
      memset(&vmptx_event_parms, 0, sizeof(vmptx_event_parms));
      ChnlLock(index, lThisFunction);
      vmptx_event_parms.vmptx = gSipCallDtls.sipCallHdls[index].vmp_tx;
      ChnlUnlock(index, lThisFunction);
      lErr = sm_vmptx_get_event(&vmptx_event_parms);
      if (lErr)
      {
         ChnlLock(index, lThisFunction);
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X Error to Get VMPTX Event",
               gSipCallDtls.sipCallHdls[index].seqNum,
               gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
               vmptx_event_parms.vmptx);
         ChnlUnlock(index, lThisFunction);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP53, lLogText);
      }
      else
      {
         /* Wait for the stop event */
         memset(&vmptx_status_parms, 0, sizeof(vmptx_status_parms));
         ChnlLock(index, lThisFunction);
         vmptx_status_parms.vmptx = gSipCallDtls.sipCallHdls[index].vmp_tx;
         ChnlUnlock(index, lThisFunction);
         do
         {
            smd_ev_wait(vmptx_event_parms.event);
            lErr = sm_vmptx_status(&vmptx_status_parms);
            if (lErr)
            {
               ChnlLock(index, lThisFunction);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X status:%d Received VMPTX",
                     gSipCallDtls.sipCallHdls[index].seqNum,
                     gSipCallDtls.sipCallHdls[index].index, 
                     gSipCallDtls.sipCallHdls[index].handle,vmptx_status_parms.vmptx, lErr);
               ChnlUnlock(index, lThisFunction);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP54, 1, lLogText);
               break;
            }
         } while (vmptx_status_parms.status != kSMVMPtxStatusStopped);
      }
   }

   // Closing Fd if open
   // if(gSipCallDtls.sipCallHdls[index].playControlStatus == CONTROL_SCHDL_STOP)
   {
      ChnlLock(index, lThisFunction);
      if(NULL != gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd)
      {
         ChnlUnlock(index, lThisFunction);
         ChnlLock(index, lThisFunction);
         if(0 != fclose(gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd))
         {
            ChnlUnlock(index, lThisFunction);
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                  "RefNum:%08X CID:%06d Handle:%08X Fd:%d Error:%d Cannot close file",
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId, 
                  gSipCallDtls.sipCallHdls[index].handle, 
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd, errno);
            ChnlUnlock(index, lThisFunction);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP194, lLogText);
         }
         else
         {
            ChnlUnlock(index, lThisFunction);
            ChnlLock(index, lThisFunction);
            snprintf(lLogText, MAX_LOG_TEXT_LEN, 
                  "RefNum:%08X CID:%06d Handle:%08X Fd:%d File Closed",
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.seqNum,
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.play.circuitId, 
                  gSipCallDtls.sipCallHdls[index].handle, 
                  gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd);
            ChnlUnlock(index, lThisFunction);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP195, lLogText);
         }
         ChnlLock(index, lThisFunction);
         gSipCallDtls.sipCallHdls[index].acuCurPlay.fp.fd = NULL; //check
         ChnlUnlock(index, lThisFunction);
      }
      else
      {
         ChnlUnlock(index, lThisFunction);
      }
   }

   /* Destroy the VMP[tx] */
   ChnlLock(index, lThisFunction);
   lErr = sm_vmptx_destroy(gSipCallDtls.sipCallHdls[index].vmp_tx);
   ChnlUnlock(index, lThisFunction);
      
   if (lErr)
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X Status:%d Error to Get VMPTX Destroy", 
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index,
            gSipCallDtls.sipCallHdls[index].handle, gSipCallDtls.sipCallHdls[index].vmp_tx, lErr);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP55, lLogText);
   }
   else
   {
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X Success to Get VMPTX Destroy ",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index,
            gSipCallDtls.sipCallHdls[index].handle, gSipCallDtls.sipCallHdls[index].vmp_tx);
      ChnlUnlock(index, lThisFunction);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP54, 1, lLogText);
   }

   ChnlLock(index, lThisFunction);
   if(true != gSipHandleApi.DeleteRequestFromHash(gSipCallDtls.sipCallHdls[index].key))
   {
      ChnlUnlock(index, lThisFunction);
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Key:%s Error: To Delete Call Details From Hash", 
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, 
            gSipCallDtls.sipCallHdls[index].handle, gSipCallDtls.sipCallHdls[index].key);
      ChnlUnlock(index, lThisFunction);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP59, lLogText);
      //return false; ????
   }
   else
   {
      ChnlUnlock(index, lThisFunction);
      ChnlLock(index, lThisFunction);
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Key:%s Success to Delete Call Details from Hash",
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, 
            gSipCallDtls.sipCallHdls[index].handle, gSipCallDtls.sipCallHdls[index].key);
      ChnlUnlock(index, lThisFunction);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP60, 2, lLogText);
   }

   
   ChnlLock(index, lThisFunction);
   if(gSipCallDtls.sipCallHdls[index].callType == OUTGOING){
      ChnlUnlock(index, lThisFunction);
      pthread_mutex_lock(&gOutMsgCounterLock);
      mOutCalls--;
      pthread_mutex_unlock(&gOutMsgCounterLock);
   } 
   else
   {
      ChnlUnlock(index, lThisFunction);
   }


   //ChnlLock(index, lThisFunction);
   //gSipCallDtls.sipCallHdls[index].chnlStatus = CKT_UNAVAILABLE;
   //ChnlUnlock(index, lThisFunction);

   return true;
}

//----------------------------------------------------------------------
// METHOD      : CreateProsodyEvents ()
// DESCRIPTION : Creates Play, record and Dtmf prosody events
// PARAMETER   : NONE
// RETURN      : BOOLEAN 
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::CreateProsodyEvents ()
{
   INT16 lResult = 0;
   TEXT  lLogText[MAX_LOG_TEXT_LEN + 1] = "";

   /* Create event for Play */
   lResult = smd_ev_create(&mPlayEvent, kSMNullChannelId,
         kSMEventTypeWriteData, kSMAnyChannelEvent);
   if (lResult != 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "Error: Could not create Prosody Event PLAY <%d>", lResult);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP182, lLogText);
      return false;
   }

   /* Create event for Record */
   lResult = smd_ev_create(&mRecEvent, kSMNullChannelId,
         kSMEventTypeReadData, kSMAnyChannelEvent);
   if (lResult != 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "Error: Could not create Prosody Event REC <%d>", lResult);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP183, lLogText);
      return false;
   }

   /* Create event for DTMF Recognization */
   lResult = smd_ev_create(&mDtmfEvent, kSMNullChannelId,
         kSMEventTypeRecog, kSMAnyChannelEvent);
   if (lResult != 0)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "Error: Could not create Prosody Event DTMF <%d>", lResult);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP184, lLogText);
      return false;
   }

   snprintf(lLogText, MAX_LOG_TEXT_LEN, "Successfully Created Events "
         "PlayEvt[Fd:%d Mode:%d] RecEvt[Fd:%d Mode:%d] DtmfEvt[Fd:%d Mode:%d]",
         mPlayEvent.fd, mPlayEvent.mode, mRecEvent.fd, mRecEvent.mode,
         mDtmfEvent.fd, mDtmfEvent.mode);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP85, lLogText);

   return true;
}

//-------------------------------------------------------------
// FUNCTION    : InitializeCard
// DESCRIPTION : Initializes prosodyS card
// PARAMETER   : None
// RETURN      : BOOLEAN
// THROWS      : None
//-------------------------------------------------------------
BOOLEAN SipMediaMgr::InitializeCard()
{
   ACU_CARD_INFO_PARMS     lAcuCardInfoParms;
   ACU_OPEN_PROSODY_PARMS  lOpenProsodyParms;
   SM_CARD_INFO_PARMS      lCardInfoParms;
   SM_OPEN_MODULE_PARMS lOpenModuleParms;
   CALL_OPEN_IPTEL_PORT_PARMS lOpenIptelPortParms;
   PORT_INFO_PARMS lPortInfo;

   INT16 lResult = 0;
   TEXT  lLogText[MAX_LOG_TEXT_LEN + 1] = "";

   INIT_ACU_STRUCT (&mSnapshotParms);

   lResult = acu_get_system_snapshot(&mSnapshotParms);
   if (lResult)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "Error: Failed to get the System SnapShot...Err is %d", lResult);
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP01, lLogText);
      return false;
   }
   else
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "Success to get the system snap shot Details.TotalCards:%d",
            mSnapshotParms.count);
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP02, 2, lLogText);


      INIT_ACU_STRUCT(&mOpenCardParms);
      strncpy(mOpenCardParms.serial_no, mSnapshotParms.serial_no[0], ACU_MAX_SERIAL - 1);

      lResult = acu_open_card(&mOpenCardParms);
      if (lResult)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "Error: Failed to open the card for SerialNo:%s...Error is %d",
               mSnapshotParms.serial_no[0], lResult);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP03, lLogText);
         return false;
      }

      gCardId = mOpenCardParms.card_id;
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "Success to open the card SerialNum:%s CardId:%d",
            mSnapshotParms.serial_no[0], gCardId);

      T(gTrace, printf("%s: %s\n",gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP04, 2, lLogText);

      INIT_ACU_STRUCT( &lAcuCardInfoParms );
      lAcuCardInfoParms.card_id = mOpenCardParms.card_id;

      lResult = acu_get_card_info( &lAcuCardInfoParms );

      if (!lResult)
      {
         // Make sure ProsodyS has been specified
         if(lAcuCardInfoParms.card_type != ACU_PROSODY_S_V3_CARD)
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "Error: Prosody S card not specified, Please check serial number used <%d>", lResult);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP03, lLogText);
            return false;
         }

         if (lAcuCardInfoParms.resources_available & ACU_RESOURCE_SPEECH)
         {
            INIT_ACU_STRUCT( &lOpenProsodyParms );
            lOpenProsodyParms.card_id = mOpenCardParms.card_id;

            lResult = acu_open_prosody( &lOpenProsodyParms );

            if( lResult != 0 )
            {
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "Error: Unable to open speech res <%d>", lResult);
               TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP05, lLogText);
               return false;
            }

            gProsodyOpened = 1;
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "Success to open the speech res <%d>", lResult);
            T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP06, 2, lLogText);

            INIT_ACU_SM_STRUCT( &lCardInfoParms );
            lCardInfoParms.card = mOpenCardParms.card_id;

            lResult = sm_get_card_info( &lCardInfoParms );

            if( lResult != 0 )
            {
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "Error: Unable to get speech card information <%d>", lResult);
               TERR(gTrace, printf("%s: %s\n",gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP08, lLogText);
               return false;
            }
            else
            {
               snprintf(lLogText, MAX_LOG_TEXT_LEN, "Successfully obtained the "
                     "speech card information CardId:%d Module Cnt:%d",
                     lCardInfoParms.card, lCardInfoParms.module_count);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP09, 2, lLogText);
            }

            if(lCardInfoParms.module_count)
            {
               INIT_ACU_SM_STRUCT( &lOpenModuleParms );

               lOpenModuleParms.module_ix = 0;
               lOpenModuleParms.card_id   = lCardInfoParms.card;

               lResult = sm_open_module ( &lOpenModuleParms );
               if( lResult != 0 )
               {
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "Error: Unable to Open Prosody Module <%d>", lResult);
                  TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP10, lLogText);
                  return false;
               }

               gModuleId = lOpenModuleParms.module_id;

               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "Success to Open Prosody Module ModuleId:%d Index:%d",
                     gModuleId, (int)lOpenModuleParms.module_ix);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP11, 2, lLogText);

               INIT_ACU_STRUCT(&lOpenIptelPortParms);
               lOpenIptelPortParms.protocol_type = S_SIP;
               lResult = call_open_iptel_port(&lOpenIptelPortParms);


               if (lResult)
               {
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "Error: Unable to Open Ip Tel Port <%d>", lResult);
                  TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP12, lLogText);
                  return false;
               }

               gSipPortId = lOpenIptelPortParms.port_id;

               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "Success to Open Ip Tel Port PortId:%d", gSipPortId);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP13, 2, lLogText);

               INIT_ACU_STRUCT(&lPortInfo);
               lPortInfo.port_id = lOpenIptelPortParms.port_id;
               lResult = call_port_info(&lPortInfo);
               if (lResult)
               {
                  snprintf(lLogText, MAX_LOG_TEXT_LEN,
                        "Error: Unable to get Port Info <%d>", lResult);
                  TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
                  gLog.GenerateLog(ACU_SIP14, lLogText);
                  return false;
               }
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "Success to get Port Info CT:%d CA:%d CC:%d PT:%d PName:%s ST:%s",
                     lPortInfo.connection_type, lPortInfo.channel_allocation, lPortInfo.channel_count,
                     lPortInfo.port_type, lPortInfo.name, lPortInfo.sig_sys);
               T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP15, 2, lLogText);
            }
         }
         else
         {
            snprintf(lLogText, MAX_LOG_TEXT_LEN,
                  "Error: Failer to get the card info for SerialNo:%s...Err is %d",
                  mSnapshotParms.serial_no[0], lResult);
            TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
            gLog.GenerateLog(ACU_SIP03, lLogText);
            return false;
         }
      }
   }


   //Initialize licensed no of incoming call channels, 
   //keep ready for accepting incoming calls
   for(int idx = 1; idx <= mSipLicenseIncoming; idx++)
   {

      pthread_mutex_lock(&gCallInitLock);
      lResult = this->InitializeInCall(idx);
      pthread_mutex_unlock(&gCallInitLock);
      if (lResult)
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "Success to Initialize Incoming Call <%d>", idx );
         T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP25, 1, lLogText);
      }
      else
      {
         snprintf(lLogText, MAX_LOG_TEXT_LEN,
               "Error: Unable to Initialize Incoming SIP Call <%d><%d>", idx, lResult);
         TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
         gLog.GenerateLog(ACU_SIP24, lLogText);
         return false;
      }
   }

   return true;
}


//----------------------------------------------------------------------
// METHOD NAME : FormAculabRingingMsg
// DESCRIPTION : Reads SIP Ring Requests from App.
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::FormAculabRingingMsg(UINT16 index)
{
   ACU_ERR  lErr;
   TEXT     lLogText[MAX_LOG_TEXT_LEN+1] = "";
   TEXT     lThisFunction[] = "FormAculabRingingMsg";

   ChnlLock(index, lThisFunction);

   if(gSipCallDtls.sipCallHdls[index].chnlStatus != CKT_ALERTING) 
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d\33[3i1m FormAculabRingingMsg Invalid Channel Status",
            gSipCallDtls.sipCallHdls[index].seqNum, gSipCallDtls.sipCallHdls[index].index,
            gSipCallDtls.sipCallHdls[index].handle, gSipCallDtls.sipCallHdls[index].chnlStatus );
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP143, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }

   // *************************************************************


   mRingingXparams.size = sizeof(mRingingXparams);

   INIT_ACU_STRUCT(&mRingingXparams);
   mRingingXparams.size = sizeof(INCOMING_RINGING_XPARMS);
   mRingingXparams.handle = gSipCallDtls.sipCallHdls[index].handle;

  
   //   mRingingXparams.unique_xparms.sig_iptel.vmprxid = (ACU_POINTER)gSipCallDtls.sipCallHdls[index].vmp_rx;
   //mRingingXparams.unique_xparms.sig_iptel.vmptxid = (ACU_POINTER)gSipCallDtls.sipCallHdls[index].vmp_tx;
  mRingingXparams.unique_xparms.sig_iptel.vmprxid =  TiNG_TO_ACU_POINTER(gSipCallDtls.sipCallHdls[index].vmp_rx);
   mRingingXparams.unique_xparms.sig_iptel.vmptxid = TiNG_TO_ACU_POINTER(gSipCallDtls.sipCallHdls[index].vmp_tx);


   mRingingXparams.unique_xparms.sig_iptel.protocol_specific.sig_sip.send_early_media=1;
   //mRingingXparams.unique_xparms.sig_iptel.protocol_specific.sig_sip.use_183_response_for_early_media=1;
 
   lErr = xcall_incoming_ringing(&mRingingXparams);

    // *************************************************************
    //lErr = call_incoming_ringing(gSipCallDtls.sipCallHdls[index].handle);
    if (lErr)
    {
       snprintf(lLogText, MAX_LOG_TEXT_LEN,
             "RefNum:%08X CID:%06d Handle:%08X Error:%s call_incoming_ringing() Returned", 
             gSipCallDtls.sipCallHdls[index].seqNum,
             gSipCallDtls.sipCallHdls[index].index,
             gSipCallDtls.sipCallHdls[index].handle, error_2_string(lErr));
       TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
       gLog.GenerateLog(ACU_SIP58, lLogText);
       /*puts("\n"
         "Possible causes:\n"
         " - Call control API failure\n"
         " - Media Handler Plugin failure\n"
         " - Aculab SIP service failure\n"
         "\n"
         "Diagnostic measures:\n"
         " - Run 'trace_mode CALL API INTERNAL'\n"
         " - Run 'trace_mode MHP API INTERNAL'\n"
         " - Review the sipserv.log\n");*/

      // TBD check wat to do
      ChnlUnlock(index, lThisFunction);
      return false;
   }
   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X Incoming Call Sending 180 Ringing", 
         gSipCallDtls.sipCallHdls[index].seqNum,
         gSipCallDtls.sipCallHdls[index].index,
         gSipCallDtls.sipCallHdls[index].handle);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP68, 1, lLogText);
   
   gSipCallDtls.sipCallHdls[index].chnlStatus = CKT_RINGING;

   ChnlUnlock(index, lThisFunction);
   return true;
}

//----------------------------------------------------------------------
// METHOD NAME : FormAculabAcceptMsg
// DESCRIPTION : Reads SIP Ring Requests from App.
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::FormAculabAcceptMsg(UINT16 index)
{
   ACU_ERR        lErr;
   ACCEPT_XPARMS  lAcceptXparms;

   TEXT     lLogText[MAX_LOG_TEXT_LEN+1] = "";
   TEXT     lThisFunction[] = "FormAculabAcceptMsg";

   ChnlLock(index, lThisFunction);

   if(gSipCallDtls.sipCallHdls[index].chnlStatus != CKT_RINGING )
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d\33[3i1m FormAculabAcceptMsg Invalid Channel Status",
            gSipCallDtls.sipCallHdls[index].seqNum, gSipCallDtls.sipCallHdls[index].index,
            gSipCallDtls.sipCallHdls[index].handle, gSipCallDtls.sipCallHdls[index].chnlStatus );
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP143, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }

   INIT_ACU_STRUCT(&lAcceptXparms);
   lAcceptXparms.handle = gSipCallDtls.sipCallHdls[index].handle;
   lAcceptXparms.unique_xparms.sig_iptel.vmprxid = TiNG_TO_ACU_POINTER(gSipCallDtls.sipCallHdls[index].vmp_rx);
   lAcceptXparms.unique_xparms.sig_iptel.vmptxid = TiNG_TO_ACU_POINTER(gSipCallDtls.sipCallHdls[index].vmp_tx);

   lErr = xcall_accept(&lAcceptXparms);

   if (lErr)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X VmpRx:%012X Error:%s xcall_accept() Returned Error", 
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index,
            gSipCallDtls.sipCallHdls[index].handle, lAcceptXparms.unique_xparms.sig_iptel.vmptxid,
            lAcceptXparms.unique_xparms.sig_iptel.vmprxid, error_2_string(lErr));
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP66, lLogText);
      // TBD check wat to do
      ChnlUnlock(index, lThisFunction);
      return false;
   }
   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X VmpTx:%012X VmpRx:%012X Incoming Call Accepted", 
         gSipCallDtls.sipCallHdls[index].seqNum,
         gSipCallDtls.sipCallHdls[index].index, gSipCallDtls.sipCallHdls[index].handle,
         lAcceptXparms.unique_xparms.sig_iptel.vmptxid, lAcceptXparms.unique_xparms.sig_iptel.vmprxid);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP70, 1, lLogText);
   ChnlUnlock(index, lThisFunction);

   return true;
}

//----------------------------------------------------------------------
// METHOD NAME : FormAculabDisconnectMsg
// DESCRIPTION : Reads SIP Disconnect Requests from App.
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::FormAculabDisconnectMsg(UINT16 index)
{
   CAUSE_XPARMS   lCauseXparms;
   ACU_ERR        lErr;

   TEXT     lLogText[MAX_LOG_TEXT_LEN+1] = "";
   TEXT     lThisFunction[] = "FormAculabDisconnectMsg";
   
   ChnlLock(index, lThisFunction);
   if (gSipCallDtls.sipCallHdls[index].timerTag != 0)
   {
      ChnlUnlock(index, lThisFunction);
      gSipMediaMgr.CancelDtmfTimer(index);
   }
   else
   {
      ChnlUnlock(index, lThisFunction);
   }

   ChnlLock(index, lThisFunction);
   
   if(gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_UNAVAILABLE || 
         gSipCallDtls.sipCallHdls[index].chnlStatus == CKT_INITIALIZED )
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X ChnlStat:%d\33[3i1m :FormAculabDisconnectMsg Invalid Channel Status",
            gSipCallDtls.sipCallHdls[index].seqNum, gSipCallDtls.sipCallHdls[index].index,
            gSipCallDtls.sipCallHdls[index].handle, gSipCallDtls.sipCallHdls[index].chnlStatus );
      T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP143, lLogText);
      ChnlUnlock(index, lThisFunction);
      return false;
   }

   INIT_ACU_STRUCT(&lCauseXparms);
   lCauseXparms.handle = gSipCallDtls.sipCallHdls[index].handle;

   lErr = call_disconnect(&lCauseXparms);
   if (lErr)
   {
      snprintf(lLogText, MAX_LOG_TEXT_LEN,
            "RefNum:%08X CID:%06d Handle:%08X Error:%s call_disconnect() Returned Error For App Release", 
            gSipCallDtls.sipCallHdls[index].seqNum,
            gSipCallDtls.sipCallHdls[index].index, 
            gSipCallDtls.sipCallHdls[index].handle, error_2_string(lErr));
      TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
      gLog.GenerateLog(ACU_SIP82, lLogText);
      // TBD check wat to do
      ChnlUnlock(index, lThisFunction);
      return false;
   }
   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "RefNum:%08X CID:%06d Handle:%08X Incoming Call Disconnected For App Release", 
         gSipCallDtls.sipCallHdls[index].seqNum,
         gSipCallDtls.sipCallHdls[index].index,
         gSipCallDtls.sipCallHdls[index].handle);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP83, 1, lLogText);
   ChnlUnlock(index, lThisFunction);

   return true;
}
//----------------------------------------------------------------------
// METHOD NAME : ProcessApplnMsg
// DESCRIPTION : Reads Requests from Ggi.
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::ProcessApplnMsg(GenIsupMsg & lRxIsupMsg)
{
   TEXT     lLogText[MAX_LOG_TEXT_LEN+1] = "";
   TEXT     lThisFunction[] = "ProcessApplnMsg";

   switch(lRxIsupMsg.isupMsgType)
   {
      case GEN_ISUP_IAM:
         {
            //Initiate INVITE
            pthread_mutex_lock(&gOutMsgCounterLock);
            if(mOutCalls <= mSipLicenseOutgoing)
            {
               pthread_mutex_unlock(&gOutMsgCounterLock);
               pthread_mutex_lock(&gCallInitLock);
               InitiateAculabInviteMsg(lRxIsupMsg); //TBC need to handle ERROR case
               pthread_mutex_unlock(&gCallInitLock);

               //if(true != InitiateAculabInviteMsg(lRxIsupMsg))
               //{
               //    DeInitializeInCall(lRxIsupMsg.circuitId);
               //}
            }
            else
            {
               pthread_mutex_unlock(&gOutMsgCounterLock);
               snprintf(lLogText, MAX_LOG_TEXT_LEN,
                     "CID:%06d MsgType: Invite Error: Licence Exceeded",
                     lRxIsupMsg.circuitId);
               TERR(gTrace, printf("%s: %s\n", gProcessName, lLogText););
               gLog.GenerateLog(ACU_SIP186, lLogText);

               lRxIsupMsg.isupMsgType  = GEN_ISUP_REL;

               return mSipQueApi.WriteToSipRspQue (lRxIsupMsg, mLogText);
            }
            break;
         }
      case GEN_ISUP_ACM:
         {
            FormAculabRingingMsg(lRxIsupMsg.circuitId);
            break;
         }
      case GEN_ISUP_ANM:
         {
            if(false == FormAculabAcceptMsg(lRxIsupMsg.circuitId))
            {
               lRxIsupMsg.isupMsgType  = GEN_ISUP_REL;

               mSipQueApi.WriteToSipRspQue (lRxIsupMsg, mLogText);

               FormAculabDisconnectMsg(lRxIsupMsg.circuitId); //TBD Required ???
               ChnlLock(lRxIsupMsg.circuitId, lThisFunction);
               gSipCallDtls.sipCallHdls[lRxIsupMsg.circuitId].callState = CALL_DISCONNECTED;
               ChnlUnlock(lRxIsupMsg.circuitId, lThisFunction);
            }
            break;
         }
      case GEN_ISUP_REL:
         {
            FormAculabDisconnectMsg(lRxIsupMsg.circuitId);
            ChnlLock(lRxIsupMsg.circuitId, lThisFunction);
            gSipCallDtls.sipCallHdls[lRxIsupMsg.circuitId].callState = CALL_DISCONNECTED;
            ChnlUnlock(lRxIsupMsg.circuitId, lThisFunction);
            this->ReInitialize(lRxIsupMsg.circuitId);
            break;
         }
      case GEN_ISUP_RLC:
         {
            T(gTrace, printf("%s: Bye Complete Received From IVR\n", gProcessName););

            this->ReInitialize(lRxIsupMsg.circuitId);
            break;
         }
      default:
         {
            T(gTrace, printf("%s: Unknown Message Received From IVR\n", gProcessName););
         }
   }

   return true;
}

//----------------------------------------------------------------------
// METHOD NAME : ReadApplnMsg
// DESCRIPTION : Reads Signalling Requests from Application.
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::ReadApplnMsg(GenIsupMsg & lRxIsupMsg)
{
   return mSipQueApi.ReadFromSipReqQue (lRxIsupMsg);
}

//----------------------------------------------------------------------
// METHOD NAME : DecodeAddress
// DESCRIPTION : Decodes SIP URI.
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
TEXT * SipMediaMgr::DecodeAddress(UINT16 index, TEXT *lUri)
{
   TEXT     lLogText[MAX_LOG_TEXT_LEN+1] = "";
   char  *lToken;

   if(NULL == lUri)
      return NULL;

   lToken = strtok(lUri, ":");

   while(NULL != lToken)
   {
      lToken = strtok(NULL, "@");
      if(NULL != lToken)
         return lToken;
   }
   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "%s Index:%d Error: Decode Address Failed", mLogText, index);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP92, lLogText);

   return NULL;
}

//----------------------------------------------------------------------
// METHOD NAME : EncodeAddress
// DESCRIPTION : Encodes SIP URI.
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::EncodeAddress(UINT16 index, TEXT *lUser, TEXT *lUri, 
      BOOLEAN lDomainFlag)
{
   TEXT     lLogText[MAX_LOG_TEXT_LEN+1] = "";

   T(gTrace, printf("%s: User:%s DomainFlag:%d\n", gProcessName, lUser, lDomainFlag););

   if(true == lDomainFlag)
      snprintf(lUri, SIP_MAX_URI_LEN, "sip:%s@%s", lUser, mOrigDomain);
   else
      snprintf(lUri, SIP_MAX_URI_LEN, "sip:%s@%s", lUser, mDestDomain);

   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "%s Index:%d Uri:%s Address Encode Success", gProcessName, index, lUri);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP93, lLogText);

   return true;
}

//----------------------------------------------------------------------
// METHOD NAME : FormApplnInvite
// DESCRIPTION : Formats IAM towards Application 
// PARAMETERS  : None
// RETURN      : BOOLEAN
//----------------------------------------------------------------------
BOOLEAN SipMediaMgr::FormApplnInvite()
{
   TEXT     lLogText[MAX_LOG_TEXT_LEN+1] = "";

   mTxIsupMsg.isupMsgType = GEN_ISUP_IAM;
   mTxIsupMsg.circuitId = mSipCallHandlers.index;
   strcpy(mTxIsupMsg.isupIam.callingNumber, DecodeAddress(mTxIsupMsg.circuitId, mDetailXparms.originating_addr));
   strcpy(mTxIsupMsg.isupIam.calledNumber, DecodeAddress(mTxIsupMsg.circuitId, mDetailXparms.destination_addr));

   snprintf(lLogText, MAX_LOG_TEXT_LEN,
         "%s CA:%s DA:%s Tx Invite Message Formed Towards Application CID:%d", 
         mLogText, mTxIsupMsg.isupIam.callingNumber,
         mTxIsupMsg.isupIam.calledNumber, mTxIsupMsg.circuitId);
   T(gTrace, printf("%s: %s\n", gProcessName, lLogText););
   gLog.GenerateLog(ACU_SIP80, lLogText);

   return true;
}

