   strcpy(mTxIsupMsg.isupIam.calledNumber, DecodeAddress(mTxIsupMsg.circuitId, mSipCallHandlers.destAddr));
   //   strcpy(mTxIsupMsg.isupIam.callingNumber, DecodeAddress(mTxIsupMsg.circuitId, mDetailXparms.originating_addr));
   //   strcpy(mTxIsupMsg.isupIam.calledNumber, DecodeAddress(mTxIsupMsg.circuitId, mDetailXparms.destination_addr));

