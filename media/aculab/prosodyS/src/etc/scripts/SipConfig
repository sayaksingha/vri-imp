# source env's
. /opt/sip/etc/scripts/sip.env

# Source function library.
. $PRODUCT_HOME/etc/scripts/functions

echo ""

#************************************************************
echo -n "Sending SIGCFG signal to  ACU_SipHandler        :"
sendsignal ACU_SipHandler -10
RETVAL=0
echo
if [  -ne 0 ]
then
echo "Unable to send signal to ACU_SipHandler          :"
fi
echo " "
#************************************************************
