export SYS_HOME=/opt/sip/

export PRODUCT_HOME=/opt/sip/
export PRODUCT_CFG_PATH=/etc/config
export PRODUCT_BIN_DIR=/bin

export TRACE_CFG_PATH=$PRODUCT_HOME/
export TRACE_LOG_PATH=$PRODUCT_HOME/var/trace
export PROCESS_INIT_DELAY=1

export DB_NAME=bplora
export DB_USER=sip
export DB_PASS=sip

export ORACLE_HOME=/opt/oracle/product/10.2.0/db_1
export ORACLE_SID=BPLORA
export ORACLE_BASE=$ORACLE_HOME
export ORACLE_TERM=vt100
export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$PATH:$ORACLE_HOME/lib:/lib:/usr/lib:$ORACLE_HOME/rdbms/lib:/usr/local/lib:/usr/lib/qt-3.3/bin:/usr/kerberos/bin:/usr/local/bin:/bin:/usr/bin:/lib:/usr/lib:.
export PATH=$PATH:$ORACLE_HOME/bin:.

