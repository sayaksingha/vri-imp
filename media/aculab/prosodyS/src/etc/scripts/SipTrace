# source env's
. /opt/sip/etc/scripts/sip.env

# Source function library.
. $PRODUCT_HOME/etc/scripts/functions

echo ""

#************************************************************
echo -n "Sending SIGTRACE signal to  SIP_EvrWriter       :"
sendsignal ACU_SipHandler -12
RETVAL=$?
echo
if [ $RETVAL -ne 0 ]
then
   echo "Unable to send signal to SIP_EvrWriter          :"
fi
echo " "

